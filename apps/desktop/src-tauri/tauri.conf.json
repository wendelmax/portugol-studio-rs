{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portugol Studio RS",
  "version": "0.1.0",
  "identifier": "br.portugol.studio.rs",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Portugol Studio",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Portugol Studio RS",
    "copyright": "Baseado no Portugol Studio (UNIVALI). LGPL-3.0.",
    "category": "Education",
    "shortDescription": "IDE para a linguagem Portugol",
    "longDescription": "Ambiente para aprender programação em Portugol: editor, análise de erros, execução e console. Port em Rust do Portugol Studio.",
    "licenseFile": "../../../LICENSE",
    "fileAssociations": [
      {
        "ext": [
          "por"
        ],
        "name": "Programa Portugol",
        "description": "Programa Portugol",
        "role": "Editor",
        "mimeType": "text/x-portugol"
      }
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "wix": {
        "language": "pt-BR"
      }
    },
    "linux": {
      "deb": {
        "section": "education"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
