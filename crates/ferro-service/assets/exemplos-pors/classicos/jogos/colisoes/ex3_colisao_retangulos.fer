 * desde que este cabeçalho, contendo os direitos autorais e a descrição do programa,
 * seja mantido.
 *
 * Descrição:
 *
 *   Este exemplo demonstra como é detectada a colisão entre dois retângulos (AABB)
 *   comparando a distância entre os centros com a metade da soma das larguras e alturas.
 *
 *   Controles:
 *     - Setas: movem o retângulo A
 *     - W, A, S, D: movem o retângulo B
 *     - G: exibe/oculta as guias visuais de centros e distâncias mínimas
 *     - C: ativa/desativa o bloqueio de colisões
 *     - ESC: encerra o programa
 *
 * Autor (versão original):
 *
 *   Luiz Fernando Noschang (noschang@univali.br)
 *
 * Data original: 26/06/2017
 * Adaptado para Ferro (.pors)
 */

registro Retangulo {
    x: inteiro,
    y: inteiro,
    largura: inteiro,
    altura: inteiro,
}

registro CenaRetangulos {
    a: Retangulo,
    b: Retangulo,
    exibir_guias: logico,
    tratar_colisoes: logico,
    tecla_g_estava: logico,
    tecla_c_estava: logico,
}

funcao cor_rgb(r: inteiro, g: inteiro, b: inteiro) -> inteiro {
    escolha Graficos.criar_cor(r, g, b) {
        caso Resultado::Ok(cor) => {
            retorne cor;
        }
        caso Resultado::Erro(_) => {
            retorne Graficos.COR_BRANCO;
        }
    }
}

funcao ocorreu_colisao(a: Retangulo, b: Retangulo) -> logico {
    seja cxa: inteiro = a.x + a.largura / 2;
    seja cya: inteiro = a.y + a.altura / 2;
    seja cxb: inteiro = b.x + b.largura / 2;
    seja cyb: inteiro = b.y + b.altura / 2;

    seja dist_x: inteiro = Matematica.valor_absoluto_inteiro(cxa - cxb);
    seja dist_y: inteiro = Matematica.valor_absoluto_inteiro(cya - cyb);

    seja min_x: inteiro = (a.largura + b.largura) / 2;
    seja min_y: inteiro = (a.altura + b.altura) / 2;

    retorne dist_x < min_x && dist_y < min_y;
}

funcao limitar(valor: inteiro, minimo: inteiro, maximo: inteiro) -> inteiro {
    se (valor < minimo) {
        retorne minimo;
    }
    se (valor > maximo) {
        retorne maximo;
    }
    retorne valor;
}

funcao atualizar(cena: CenaRetangulos) -> CenaRetangulos {
    seja mutavel nova: CenaRetangulos = cena;
    seja mutavel a: Retangulo = nova.a;
    seja mutavel b: Retangulo = nova.b;
    seja passo: inteiro = 3;

    seja g_p: logico = Teclado.tecla_pressionada(Teclado.TECLA_G);
    se (g_p && !nova.tecla_g_estava) {
        nova.exibir_guias = !nova.exibir_guias;
    }
    nova.tecla_g_estava = g_p;

    seja c_p: logico = Teclado.tecla_pressionada(Teclado.TECLA_C);
    se (c_p && !nova.tecla_c_estava) {
        nova.tratar_colisoes = !nova.tratar_colisoes;
        se (nova.tratar_colisoes && ocorreu_colisao(a, b)) {
            a.x = 140;
            a.y = 260;
            b.x = 500;
            b.y = 250;
        }
    }
    nova.tecla_c_estava = c_p;

    // Retângulo A (Setas)
    seja ax_ant: inteiro = a.x;
    seja ay_ant: inteiro = a.y;
    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_ESQUERDA)) {
        a.x = limitar(a.x - passo, 16, 784 - a.largura);
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_DIREITA)) {
        a.x = limitar(a.x + passo, 16, 784 - a.largura);
    }
    se (nova.tratar_colisoes && ocorreu_colisao(a, b)) {
        a.x = ax_ant;
    }

    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_ACIMA)) {
        a.y = limitar(a.y - passo, 84, 560 - a.altura);
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_ABAIXO)) {
        a.y = limitar(a.y + passo, 84, 560 - a.altura);
    }
    se (nova.tratar_colisoes && ocorreu_colisao(a, b)) {
        a.y = ay_ant;
    }

    // Retângulo B (WASD)
    seja bx_ant: inteiro = b.x;
    seja by_ant: inteiro = b.y;
    se (Teclado.tecla_pressionada(Teclado.TECLA_A)) {
        b.x = limitar(b.x - passo, 16, 784 - b.largura);
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_D)) {
        b.x = limitar(b.x + passo, 16, 784 - b.largura);
    }
    se (nova.tratar_colisoes && ocorreu_colisao(a, b)) {
        b.x = bx_ant;
    }

    se (Teclado.tecla_pressionada(Teclado.TECLA_W)) {
        b.y = limitar(b.y - passo, 84, 560 - b.altura);
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_S)) {
        b.y = limitar(b.y + passo, 84, 560 - b.altura);
    }
    se (nova.tratar_colisoes && ocorreu_colisao(a, b)) {
        b.y = by_ant;
    }

    nova.a = a;
    nova.b = b;
    retorne nova;
}

funcao desenhar(cena: CenaRetangulos) {
    seja colidiu: logico = ocorreu_colisao(cena.a, cena.b);
    seja cxa: inteiro = cena.a.x + cena.a.largura / 2;
    seja cya: inteiro = cena.a.y + cena.a.altura / 2;
    seja cxb: inteiro = cena.b.x + cena.b.largura / 2;
    seja cyb: inteiro = cena.b.y + cena.b.altura / 2;
    seja dx: inteiro = Matematica.valor_absoluto_inteiro(cxa - cxb);
    seja dy: inteiro = Matematica.valor_absoluto_inteiro(cya - cyb);
    seja min_x: inteiro = (cena.a.largura + cena.b.largura) / 2;
    seja min_y: inteiro = (cena.a.altura + cena.b.altura) / 2;

    Graficos.definir_cor(cor_rgb(245, 247, 250));
    Graficos.limpar();

    // Cabeçalho
    Graficos.definir_cor(cor_rgb(30, 38, 52));
    Graficos.desenhar_retangulo(0, 0, 800, 76, falso, verdadeiro);
    Graficos.definir_cor(Graficos.COR_BRANCO);
    Graficos.definir_tamanho_texto(18.0);
    Graficos.desenhar_texto(18, 12, "Colisao 3: Retangulo x Retangulo (AABB)");
    Graficos.definir_tamanho_texto(12.0);
    Graficos.definir_cor(cor_rgb(200, 210, 225));
    Graficos.desenhar_texto(18, 40, "[Setas] Mover Retangulo A  |  [WASD] Mover Retangulo B  |  [G] Guias  |  [C] Tratar Colisao  |  [ESC] Sair");

    se (colidiu) {
        Graficos.definir_cor(cor_rgb(255, 100, 100));
        Graficos.definir_tamanho_texto(14.0);
        Graficos.desenhar_texto(560, 14, "COLISAO DETECTADA!");
    } senao {
        Graficos.definir_cor(cor_rgb(120, 230, 150));
        Graficos.definir_tamanho_texto(14.0);
        Graficos.desenhar_texto(560, 14, "Sem colisao");
    }

    // Retângulo A
    se (colidiu) {
        Graficos.definir_cor(cor_rgb(102, 255, 153));
    } senao {
        Graficos.definir_cor(cor_rgb(102, 204, 255));
    }
    Graficos.desenhar_retangulo(cena.a.x, cena.a.y, cena.a.largura, cena.a.altura, falso, verdadeiro);
    Graficos.definir_cor(cor_rgb(30, 60, 90));
    Graficos.desenhar_retangulo(cena.a.x, cena.a.y, cena.a.largura, cena.a.altura, falso, falso);
    Graficos.definir_tamanho_texto(15.0);
    Graficos.desenhar_texto(cxa - 6, cya - 8, "A");

    // Retângulo B
    se (colidiu) {
        Graficos.definir_cor(cor_rgb(255, 153, 102));
    } senao {
        Graficos.definir_cor(cor_rgb(255, 240, 110));
    }
    Graficos.desenhar_retangulo(cena.b.x, cena.b.y, cena.b.largura, cena.b.altura, falso, verdadeiro);
    Graficos.definir_cor(cor_rgb(100, 75, 20));
    Graficos.desenhar_retangulo(cena.b.x, cena.b.y, cena.b.largura, cena.b.altura, falso, falso);
    Graficos.desenhar_texto(cxb - 6, cyb - 8, "B");

    // Guias de centros e eixos
    se (cena.exibir_guias) {
        Graficos.definir_cor(cor_rgb(153, 0, 153));
        Graficos.desenhar_linha(cxb, 76, cxb, 600);
        Graficos.desenhar_linha(0, cyb, 800, cyb);

        Graficos.definir_cor(Graficos.COR_PRETO);
        Graficos.desenhar_linha(cxa, cya, cxb, cya);
        Graficos.desenhar_linha(cxa, cya, cxa, cyb);
        Graficos.definir_tamanho_texto(12.0);
        Graficos.desenhar_texto((cxa + cxb) / 2 - 18, cya - 16, "dx=" + Tipos.inteiro_para_cadeia(dx));
        Graficos.desenhar_texto(cxa + 6, (cya + cyb) / 2, "dy=" + Tipos.inteiro_para_cadeia(dy));
    }

    // Rodapé pedagógico
    Graficos.definir_cor(cor_rgb(40, 45, 55));
    Graficos.definir_tamanho_texto(12.0);
    Graficos.desenhar_texto(18, 574, "dx=" + Tipos.inteiro_para_cadeia(dx) + " (min " + Tipos.inteiro_para_cadeia(min_x) + ")  |  dy=" + Tipos.inteiro_para_cadeia(dy) + " (min " + Tipos.inteiro_para_cadeia(min_y) + ")  |  Tratar: " + Tipos.logico_para_cadeia(cena.tratar_colisoes));

    Graficos.renderizar();
}

funcao inicio() {
    Graficos.iniciar_modo_grafico(verdadeiro);
    Graficos.definir_dimensoes_janela(800, 600);
    Graficos.definir_titulo_janela("Colisao: Dois Retangulos - Ferro");

    seja mutavel cena: CenaRetangulos = CenaRetangulos {
        a: Retangulo {
            x: 140, y: 260, largura: 110, altura: 80
        }
        ,
        b: Retangulo {
            x: 480, y: 240, largura: 130, altura: 110
        }
        ,
        exibir_guias: verdadeiro,
        tratar_colisoes: falso,
        tecla_g_estava: falso,
        tecla_c_estava: falso,
    }
    ;

    enquanto (!Teclado.tecla_pressionada(Teclado.TECLA_ESC)) {
        cena = atualizar(cena);
        desenhar(cena);
        Util.aguarde(16);
    }

    Graficos.encerrar_modo_grafico();
}
