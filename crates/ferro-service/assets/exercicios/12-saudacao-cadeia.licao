{
  "schema_version": 1,
  "id": "ferro-12-saudacao-cadeia",
  "title": "Saudação com cadeia",
  "statement": "Leia o nome de uma pessoa em uma variável cadeia e escreva \"Ola, \" seguido do nome lido.",
  "starter_code": "funcao inicio() {\n    seja mutavel nome = leia();\n    escreva(nome);\n}\n",
  "hints": [
    "Use escreva(\"Ola, \", nome); para exibir a saudação seguida do nome."
  ],
  "cases": [
    { "name": "ana", "input": "Ana\n", "expected_output": "Ola, Ana" },
    { "name": "lucas", "input": "Lucas\n", "expected_output": "Ola, Lucas" }
  ]
}
