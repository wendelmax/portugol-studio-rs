enum Valor {
    Zero,
    Um,
    Dois,
    Outro,
}

funcao inicio() {
    seja valor: Valor = Valor::Um;

    escolha valor {
        caso Valor::Zero => {
            escreval("O valor é igual a 0");
        }
        caso Valor::Um => {
            escreval("O valor é igual a 1");
        }
        caso Valor::Dois => {
            escreval("O valor é igual a 2");
        }
        caso _ => {
            escreval("O valor não é igual a 0, 1 ou 2");
        }
    }
}
