funcao inicio() {
    escreva("Digite um valor: ");
    seja mutavel valor: real = leia();

    // Calcula o valor elevado ao cubo
    seja potencia: real = Matematica.potencia(valor, 3.0);
    // Calcula a raiz quadrada do valor
    seja raiz_quadrada: real = Matematica.raiz(valor, 2.0);

    // Exibe os resultados
    escreval("\nO número ao cubo é: ", potencia);
    escreval("A raiz quadrada do número é: ", raiz_quadrada);
}
