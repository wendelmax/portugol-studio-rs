registro EstadoSenoides {
    x: inteiro,
    y: inteiro,
    cor_base: inteiro,
    iterador: inteiro,
    auto_play: logico,
    tempo_i: inteiro
}

funcao cor_rgb(r: inteiro, g: inteiro, b: inteiro) -> inteiro {
    escolha Graficos.criar_cor(r, g, b) {
        caso Resultado::Ok(cor) => {
            retorne cor;
        }
        caso Resultado::Erro(_) => {
            retorne Graficos.COR_PRETO;
        }
    }
}

funcao sortear_intervalo(minimo: inteiro, maximo: inteiro) -> inteiro {
    escolha Util.sorteia(minimo, maximo) {
        caso Resultado::Ok(valor) => {
            retorne valor;
        }
        caso Resultado::Erro(_) => {
            retorne minimo;
        }
    }
}

funcao desenhar(
mutavel estado: EstadoSenoides,
base_x: inteiro,
base_y: inteiro,
espaco: inteiro,
auto_play_x: inteiro,
logo: Opcao < inteiro >
) -> EstadoSenoides {
    Graficos.definir_cor(Graficos.COR_PRETO);
    Graficos.limpar();

    Graficos.definir_cor(Graficos.COR_BRANCO);
    Graficos.desenhar_texto(50, 50, "X: " + Tipos.inteiro_para_cadeia(estado.x));
    Graficos.desenhar_texto(50, 78, "Y: " + Tipos.inteiro_para_cadeia(estado.y));

    escolha logo {
        caso Opcao::Algum(img) => {
            Graficos.desenhar_imagem((base_x * 2) - 250, (base_y * 2) - 86, img);
        }
        caso Opcao::Nenhum => {}
    }

    se (estado.auto_play) {
        Graficos.desenhar_texto(auto_play_x, 50, "Autoplay");
    }

    seja mutavel r: inteiro = Graficos.obter_rgb(estado.cor_base, Graficos.CANAL_R);
    seja mutavel g: inteiro = Graficos.obter_rgb(estado.cor_base, Graficos.CANAL_G);
    seja mutavel b: inteiro = Graficos.obter_rgb(estado.cor_base, Graficos.CANAL_B);

    seja base_x_r: real = Tipos.inteiro_para_real(base_x);
    seja base_y_r: real = Tipos.inteiro_para_real(base_y);
    seja espaco_r: real = Tipos.inteiro_para_real(espaco);
    seja xr: real = Tipos.inteiro_para_real(estado.x);
    seja yr: real = Tipos.inteiro_para_real(estado.y);

    para (seja mutavel passo: inteiro = 0; passo < 722; passo += 1) {
        seja i: real = Tipos.inteiro_para_real(passo) * 0.5;
        seja bolinha: inteiro = Tipos.real_para_inteiro(
        (32.0 * (Tipos.inteiro_para_real(estado.iterador) / 360.0)) + 1.0
        );
        seja metade: real = Tipos.inteiro_para_real(bolinha) / 2.0;

        seja px: inteiro = Tipos.real_para_inteiro(
        base_x_r + (Matematica.seno(i * xr) * espaco_r) - metade
        );
        seja py: inteiro = Tipos.real_para_inteiro(
        base_y_r + (Matematica.cosseno(i * yr) * espaco_r) - metade
        );

        Graficos.definir_cor(cor_rgb(r, g, b));
        Graficos.desenhar_elipse(px, py, bolinha, bolinha, verdadeiro);

        r = (r + 7) % 256;
        g = (g + 13) % 256;
        b = (b + 19) % 256;

        estado.iterador -= 1;
        se (estado.iterador <= 0) {
            estado.iterador = 360;
        }
    }

    retorne estado;
}

funcao atualizar_controle(
mutavel estado: EstadoSenoides,
cores: vetor < inteiro >,
demos_x: vetor < inteiro >,
demos_y: vetor < inteiro >,
tempo_a: inteiro
) -> EstadoSenoides {
    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_ESQUERDA)) {
        estado.x -= 1;
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_DIREITA)) {
        estado.x += 1;
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_ACIMA)) {
        estado.y -= 1;
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_ABAIXO)) {
        estado.y += 1;
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_C)) {
        estado.cor_base = cor_rgb(
        sortear_intervalo(40, 255),
        sortear_intervalo(40, 255),
        sortear_intervalo(40, 255)
        );
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_D)) {
        estado.cor_base = cores[sortear_intervalo(0, tamanho(cores) - 1)];
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_A)) {
        estado.auto_play = !estado.auto_play;
    }

    seja tempo_decorrido: inteiro = Util.tempo_decorrido() - estado.tempo_i;
    se (
    (tempo_decorrido > tempo_a && estado.auto_play) || Teclado.tecla_pressionada(Teclado.TECLA_ESPACO)
    ) {
        seja prob: inteiro = sortear_intervalo(0, 100);
        se ((prob % 10) < 2) {
            estado.x = sortear_intervalo(0, 360);
            estado.y = sortear_intervalo(0, 360);
        } senao {
            seja pos: inteiro = sortear_intervalo(0, tamanho(demos_x) - 1);
            estado.x = demos_x[pos];
            estado.y = demos_y[pos];
        }
        estado.cor_base = cores[sortear_intervalo(0, tamanho(cores) - 1)];
        estado.tempo_i = Util.tempo_decorrido();
    } enquanto (Teclado.alguma_tecla_pressionada() && !Teclado.tecla_pressionada(Teclado.TECLA_ESC)) {
        estado.tempo_i = Util.tempo_decorrido();
        Util.aguarde(10);
    }

    retorne estado;
}

funcao inicio() {
    seja cores: vetor < inteiro > = [
    cor_rgb(36, 206, 151),
    cor_rgb(194, 66, 100),
    cor_rgb(181, 187, 119),
    cor_rgb(24, 43, 147)
    ];

    seja demos_x: vetor < inteiro > = [
    310, 284, 311, 176, 196, 264, 267, 22, 42, 44, 310,
    20, 67, 88, 110, 89, 90, 94, 98, 113, 134
    ];
    seja demos_y: vetor < inteiro > = [
    229, 88, 88, 88, 88, 88, 88, 33, 46, 44, 222,
    24, 46, 47, 47, 88, 88, 88, 88, 88, 88
    ];

    Graficos.iniciar_modo_grafico(verdadeiro);
    Graficos.definir_dimensoes_janela(900, 650);
    Graficos.definir_titulo_janela("Senoides");
    Graficos.definir_tamanho_texto(25.0);

    seja mutavel logo: Opcao < inteiro > = Opcao::Nenhum;
    escolha Graficos.carregar_imagem("portugol.png") {
        caso Resultado::Ok(id) => {
            logo = Opcao::Algum(id);
        }
        caso Resultado::Erro(_) => {
            logo = Opcao::Nenhum;
        }
    }

    seja base_x: inteiro = Graficos.largura_janela() / 2;
    seja base_y: inteiro = Graficos.altura_janela() / 2;
    seja espaco: inteiro = base_y - 100;
    seja auto_play_x: inteiro = base_x - (Graficos.largura_texto("Autoplay") / 2);
    seja tempo_a: inteiro = 10000;

    seja mutavel estado: EstadoSenoides = EstadoSenoides {
        x: 88,
        y: 88,
        cor_base: cores[1],
        iterador: 360,
        auto_play: falso,
        tempo_i: Util.tempo_decorrido()
    }
    ;

    enquanto (!Teclado.tecla_pressionada(Teclado.TECLA_ESC)) {
        estado = atualizar_controle(estado, cores, demos_x, demos_y, tempo_a);
        estado = desenhar(estado, base_x, base_y, espaco, auto_play_x, logo);
        Graficos.renderizar();
        Util.aguarde(10);
    }

    escolha logo {
        caso Opcao::Algum(img) => {
            Graficos.liberar_imagem(img);
        }
        caso Opcao::Nenhum => {}
    }

    Graficos.encerrar_modo_grafico();
}
