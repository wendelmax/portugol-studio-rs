registro Marcador {
    x: inteiro,
    y: inteiro,
    botao: inteiro
}

funcao cor_rgb(r: inteiro, g: inteiro, b: inteiro) -> inteiro {
    escolha Graficos.criar_cor(r, g, b) {
        caso Resultado::Ok(cor) => {
            retorne cor;
        }
        caso Resultado::Erro(_) => {
            retorne Graficos.COR_PRETO;
        }
    }
}

funcao nome_botao(botao: inteiro) -> cadeia {
    se (botao == Mouse.BOTAO_ESQUERDO) {
        retorne "Botão Esquerdo";
    } senao se (botao == Mouse.BOTAO_MEIO) {
        retorne "Botão do Meio";
    } senao se (botao == Mouse.BOTAO_DIREITO) {
        retorne "Botão Direito";
    }
    retorne "Botão Desconhecido";
}

funcao cor_botao(botao: inteiro) -> inteiro {
    se (botao == Mouse.BOTAO_ESQUERDO) {
        retorne cor_rgb(76, 209, 130);
    } senao se (botao == Mouse.BOTAO_MEIO) {
        retorne cor_rgb(255, 193, 7);
    }
    retorne cor_rgb(79, 156, 255);
}

funcao desenhar_cena(marcadores: vetor < Marcador >, status: cadeia) {
    Graficos.definir_cor(cor_rgb(22, 28, 40));
    Graficos.limpar();

    // Cabeçalho
    Graficos.definir_cor(cor_rgb(34, 44, 64));
    Graficos.desenhar_retangulo(0, 0, 640, 82, falso, verdadeiro);

    Graficos.definir_cor(Graficos.COR_BRANCO);
    Graficos.definir_tamanho_texto(18.0);
    Graficos.desenhar_texto(18, 16, "Clique na área abaixo (Mouse.ler_botao)");
    Graficos.definir_tamanho_texto(14.0);
    Graficos.definir_cor(cor_rgb(190, 205, 225));
    Graficos.desenhar_texto(18, 48, status);

    // Botão vermelho de saída no canto superior direito
    Graficos.definir_cor(cor_rgb(210, 65, 65));
    Graficos.desenhar_retangulo(530, 20, 92, 40, verdadeiro, verdadeiro);
    Graficos.definir_cor(Graficos.COR_BRANCO);
    Graficos.definir_tamanho_texto(16.0);
    Graficos.desenhar_texto(556, 30, "Sair");

    // Desenha marcadores acumulados
    para (seja mutavel i: inteiro = 0; i < tamanho(marcadores); i += 1) {
        seja m: Marcador = marcadores[i];
        Graficos.definir_cor(cor_botao(m.botao));
        Graficos.desenhar_elipse(m.x - 10, m.y - 10, 20, 20, verdadeiro);
        Graficos.definir_cor(Graficos.COR_BRANCO);
        Graficos.desenhar_elipse(m.x - 10, m.y - 10, 20, 20, falso);
    }

    Graficos.renderizar();
}

funcao inicio() {
    Graficos.iniciar_modo_grafico(verdadeiro);
    Graficos.definir_dimensoes_janela(640, 480);
    Graficos.definir_titulo_janela("Mouse - ler_botao");

    seja mutavel marcadores: vetor < Marcador > = [];
    seja mutavel executando: logico = verdadeiro;
    seja mutavel status: cadeia = "Aguardando clique... Clique em 'Sair' para encerrar.";

    desenhar_cena(marcadores, status);

    enquanto (executando) {
        escolha Mouse.ler_botao() {
            caso Resultado::Ok(botao) => {
                seja mx: inteiro = Mouse.posicao_x();
                seja my: inteiro = Mouse.posicao_y();

                se (mx >= 530 && mx <= 622 && my >= 20 && my <= 60) {
                    executando = falso;
                } senao {
                    adicionar(marcadores, Marcador {
                        x: mx,
                        y: my,
                        botao: botao
                    }
                    );
                    status = nome_botao(botao) + " em (" + Tipos.inteiro_para_cadeia(mx) + ", " + Tipos.inteiro_para_cadeia(my) + ") | Total: " + Tipos.inteiro_para_cadeia(tamanho(marcadores));
                    desenhar_cena(marcadores, status);
                }
            }
            caso Resultado::Erro(mensagem) => {
                escreva("Erro ao ler botão do mouse: ", mensagem, "\n");
                executando = falso;
            }
        }
    }

    Graficos.encerrar_modo_grafico();
}
