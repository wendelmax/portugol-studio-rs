funcao inicio() {
    escreva("Digite seu nome: ");
    seja mutavel nome = leia();

    // Obtém o número de caracteres armazenados na variável
    seja comprimento: inteiro = Texto.numero_caracteres(nome);

    escreval("Seu nome possui ", comprimento, " caracteres");
}
