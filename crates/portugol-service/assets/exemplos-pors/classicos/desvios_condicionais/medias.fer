 * desde que este cabeçalho, contendo os direitos autorais e a descrição do programa,
 * seja mantido.
 *
 * Descrição:
 *
 *     Este exemplo pede ao usuário que informe três médias. Logo após, calcula
 *     e exibe a média final destas notas. Por último, verifica se alguma das
 *     médias parciais é menor que a média final e a exibe (caso exista).
 *
 * Autores:
 *
 *     Giordana Maria da Costa Valle
 *     Carlos Alexandre Krueger
 *
 * Data: 01/06/2013
 */

funcao inicio() {
    escreva("Informe a média 1: ");
    seja mutavel m1: real = leia();
    escreva("Informe a média 2: ");
    seja mutavel m2: real = leia();
    escreva("Informe a média 3: ");
    seja mutavel m3: real = leia();

    seja media: real = (m1 + m2 + m3) / 3.0;

    escreval("\nA média final é: ", Matematica.arredondar(media, 2), "\n");

    se (m1 < media) {
        escreval("A média 1 é menor que a média final");
    }

    se (m2 < media) {
        escreval("A média 2 é menor que a média final");
    }

    se (m3 < media) {
        escreval("A média 3 é menor que a média final");
    }
}
