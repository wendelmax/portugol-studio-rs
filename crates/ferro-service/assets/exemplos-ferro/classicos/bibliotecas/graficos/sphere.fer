/*
 * Exemplo clássico do Ferro Studio adaptado para Ferro (.fer)
 *
 * Descrição:
 *
 *   Renderiza uma esfera 3D composta por 42 vértices e 80 triângulos,
 *   aplicando rotação em torno do eixo Y, projeção em perspectiva e
 *   preenchimento de polígonos com Graficos.desenhar_poligono().
 *   Controles: A (rotação horária), D (rotação anti-horária), ESC (sair).
 */

registro Projecao3D {
    x: real,
    y: real,
    z: real
}

funcao cor_rgb(r: inteiro, g: inteiro, b: inteiro) -> inteiro {
    escolha Graficos.criar_cor(r, g, b) {
        caso Resultado::Ok(cor) => {
            retorne cor;
        }
        caso Resultado::Erro(_) => {
            retorne Graficos.COR_PRETO;
        }
    }
}

funcao limitar(valor: inteiro, minimo: inteiro, maximo: inteiro) -> inteiro {
    se (valor < minimo) {
        retorne minimo;
    } senao se (valor > maximo) {
        retorne maximo;
    }
    retorne valor;
}

funcao projetar(v: inteiro, vertices: vetor < real >, cosr: real, senr: real) -> Projecao3D {
    seja px: real = vertices[(v * 3) + 0];
    seja py: real = vertices[(v * 3) + 2];
    seja pz: real = vertices[(v * 3) + 1];

    seja tz: real = (pz * cosr) - (px * senr);
    seja tx: real = (pz * senr) + (px * cosr);
    seja ty: real = py;
    seja z_prof: real = tz + 150.0;

    retorne Projecao3D {
        x: tx / z_prof,
        y: ty / z_prof,
        z: tz
    }
    ;
}

funcao desenhar_poligono_seguro(xs: vetor < inteiro >, ys: vetor < inteiro >, preencher: logico) {
    escolha Graficos.desenhar_poligono(xs, ys, preencher) {
        caso Resultado::Ok(_) => {}
        caso Resultado::Erro(_) => {}
    }
}

funcao poligono_3d(
v1: inteiro,
v2: inteiro,
v3: inteiro,
frente: logico,
vertices: vetor < real >,
cosr: real,
senr: real,
scale: real,
largura: real,
altura: real
) {
    seja p1: Projecao3D = projetar(v1, vertices, cosr, senr);
    seja p2: Projecao3D = projetar(v2, vertices, cosr, senr);
    seja p3: Projecao3D = projetar(v3, vertices, cosr, senr);

    seja x0: inteiro = Tipos.real_para_inteiro((scale * p1.x * altura) + (largura / 2.0));
    seja y0: inteiro = Tipos.real_para_inteiro((scale * p1.y * altura) + (altura / 2.0));
    seja pz1: real = scale * p1.z;

    seja x1: inteiro = Tipos.real_para_inteiro((scale * p2.x * altura) + (largura / 2.0));
    seja y1: inteiro = Tipos.real_para_inteiro((scale * p2.y * altura) + (altura / 2.0));
    seja pz2: real = scale * p2.z;

    seja x2: inteiro = Tipos.real_para_inteiro((scale * p3.x * altura) + (largura / 2.0));
    seja y2: inteiro = Tipos.real_para_inteiro((scale * p3.y * altura) + (altura / 2.0));
    seja pz3: real = scale * p3.z;

    seja xs: vetor < inteiro > = [x0, x1, x2];
    seja ys: vetor < inteiro > = [y0, y1, y2];

    se (frente) {
        se (pz1 >= 0.0 && pz2 >= 0.0 && pz3 >= 0.0) {
            seja media_x: inteiro = (x0 + x1 + x2) / 3;
            seja tom: inteiro = limitar(((media_x - 200) * 255) / 400, 40, 245);
            Graficos.definir_cor(cor_rgb(tom, tom, tom));
            desenhar_poligono_seguro(xs, ys, verdadeiro);

            Graficos.definir_cor(cor_rgb(235, 240, 255));
            desenhar_poligono_seguro(xs, ys, falso);
        }
    } senao {
        se (pz1 >= 0.0 || pz2 >= 0.0 || pz3 >= 0.0) {
            seja media_x: inteiro = (x0 + x1 + x2) / 3;
            seja tom: inteiro = limitar(((media_x - 200) * 180) / 400, 25, 160);
            Graficos.definir_cor(cor_rgb(tom, tom, tom));
            desenhar_poligono_seguro(xs, ys, verdadeiro);
        }
    }
}

funcao inicio() {
    seja largura_tela: inteiro = 800;
    seja altura_tela: inteiro = 600;
    seja largura_r: real = Tipos.inteiro_para_real(largura_tela);
    seja altura_r: real = Tipos.inteiro_para_real(altura_tela);
    seja scale: real = -45.0;

    seja vertices: vetor < real > = [
    0.017268, -0.988219, -0.009926,
    0.740875, -0.435438, 0.515799,
    -0.259120, -0.435438, 0.840723,
    -0.877159, -0.435434, -0.009926,
    -0.259120, -0.435438, -0.860575,
    0.740875, -0.435438, -0.535651,
    0.293656, 0.459001, 0.840723,
    -0.706340, 0.459001, 0.515799,
    -0.706340, 0.459001, -0.535651,
    0.293656, 0.459001, -0.860575,
    0.911694, 0.458997, -0.009926,
    0.017268, 1.011781, -0.009926,
    -0.145188, -0.838873, 0.490069,
    0.442590, -0.838873, 0.299085,
    0.280136, -0.513956, 0.799086,
    0.867915, -0.513954, -0.009926,
    0.442590, -0.838873, -0.318937,
    -0.508462, -0.838870, -0.009926,
    -0.670922, -0.513955, 0.490071,
    -0.145188, -0.838873, -0.509921,
    -0.670922, -0.513955, -0.509923,
    0.280136, -0.513956, -0.818938,
    0.968325, 0.011781, 0.299087,
    0.968325, 0.011781, -0.318939,
    0.017268, 0.011781, 0.990074,
    0.605053, 0.011781, 0.799091,
    -0.933790, 0.011781, 0.299087,
    -0.570518, 0.011781, 0.799091,
    -0.570518, 0.011781, -0.818943,
    -0.933790, 0.011781, -0.318939,
    0.605053, 0.011781, -0.818943,
    0.017268, 0.011781, -1.009926,
    0.705457, 0.537518, 0.490071,
    -0.245601, 0.537519, 0.799086,
    -0.833380, 0.537517, -0.009926,
    -0.245601, 0.537519, -0.818938,
    0.705457, 0.537518, -0.509923,
    0.179723, 0.862436, 0.490069,
    0.542997, 0.862433, -0.009926,
    -0.408055, 0.862436, 0.299085,
    -0.408055, 0.862436, -0.318937,
    0.179723, 0.862436, -0.509921
    ];

    seja tris: vetor < inteiro > = [
    1, 14, 13, 2, 14, 16, 1, 13, 18, 1, 18, 20, 1, 20, 17,
    2, 16, 23, 3, 15, 25, 4, 19, 27, 5, 21, 29, 6, 22, 31,
    2, 23, 26, 3, 25, 28, 4, 27, 30, 5, 29, 32, 6, 31, 24,
    7, 33, 38, 8, 34, 40, 9, 35, 41, 10, 36, 42, 11, 37, 39,
    39, 42, 12, 39, 37, 42, 37, 10, 42, 42, 41, 12, 42, 36, 41,
    36, 9, 41, 41, 40, 12, 41, 35, 40, 35, 8, 40, 40, 38, 12,
    40, 34, 38, 34, 7, 38, 38, 39, 12, 38, 33, 39, 33, 11, 39,
    24, 37, 11, 24, 31, 37, 31, 10, 37, 32, 36, 10, 32, 29, 36,
    29, 9, 36, 30, 35, 9, 30, 27, 35, 27, 8, 35, 28, 34, 8,
    28, 25, 34, 25, 7, 34, 26, 33, 7, 26, 23, 33, 23, 11, 33,
    31, 32, 10, 31, 22, 32, 22, 5, 32, 29, 30, 9, 29, 21, 30,
    21, 4, 30, 27, 28, 8, 27, 19, 28, 19, 3, 28, 25, 26, 7,
    25, 15, 26, 15, 2, 26, 23, 24, 11, 23, 16, 24, 16, 6, 24,
    17, 22, 6, 17, 20, 22, 20, 5, 22, 20, 21, 5, 20, 18, 21,
    18, 4, 21, 18, 19, 4, 18, 13, 19, 13, 3, 19, 16, 17, 6,
    16, 14, 17, 14, 1, 17, 13, 15, 3, 13, 14, 15, 14, 2, 15
    ];

    seja faces: inteiro = tamanho(tris) / 3;
    seja cor_grad_inicio: inteiro = cor_rgb(252, 70, 107);
    seja cor_grad_fim: inteiro = cor_rgb(63, 94, 251);

    Graficos.iniciar_modo_grafico(verdadeiro);
    Graficos.definir_dimensoes_janela(largura_tela, altura_tela);
    Graficos.definir_titulo_janela("Esfera 3D (Raymarcher)");

    seja mutavel rot: real = 0.0;
    seja mutavel horario: logico = verdadeiro;
    seja mutavel tempo_inicio_fps: inteiro = Util.tempo_decorrido();
    seja mutavel frames = 0;
    seja mutavel fps = 0;

    enquanto (!Teclado.tecla_pressionada(Teclado.TECLA_ESC)) {
        seja cosr: real = Matematica.cosseno(rot);
        seja senr: real = Matematica.seno(rot);

        Graficos.definir_cor(Graficos.COR_PRETO);
        Graficos.limpar();

        Graficos.definir_gradiente(
        Graficos.GRADIENTE_INFERIOR_DIREITO,
        cor_grad_inicio,
        cor_grad_fim
        );
        Graficos.desenhar_retangulo(0, 0, largura_tela, altura_tela, falso, verdadeiro);

        para (seja mutavel count = 0; count < faces; count += 1) {
            seja f: inteiro = count * 3;
            seja v0: inteiro = tris[f + 0] - 1;
            seja v1: inteiro = tris[f + 1] - 1;
            seja v2: inteiro = tris[f + 2] - 1;

            poligono_3d(v0, v1, v2, falso, vertices, cosr, senr, scale, largura_r, altura_r);
            poligono_3d(v0, v1, v2, verdadeiro, vertices, cosr, senr, scale, largura_r, altura_r);
        }

        // HUD de FPS e controles
        Graficos.definir_tamanho_texto(14.0);
        Graficos.definir_cor(Graficos.COR_BRANCO);
        Graficos.definir_estilo_texto(falso, verdadeiro, falso);
        Graficos.desenhar_texto(25, 30, "FPS: " + Tipos.inteiro_para_cadeia(fps));
        Graficos.definir_estilo_texto(falso, falso, falso);
        Graficos.desenhar_texto(25, 52, "A / D: direção da rotação | ESC: sair");

        Graficos.renderizar();

        se (horario) {
            rot += 0.02;
            se (rot > 6.28318) {
                rot = 0.0;
            }
        } senao {
            rot -= 0.02;
            se (rot < 0.0) {
                rot = 6.28318;
            }
        }

        se (Teclado.tecla_pressionada(Teclado.TECLA_A)) {
            horario = verdadeiro;
        }
        se (Teclado.tecla_pressionada(Teclado.TECLA_D)) {
            horario = falso;
        }

        frames += 1;
        seja tempo_fps: inteiro = Util.tempo_decorrido() - tempo_inicio_fps;
        se (tempo_fps >= 1000) {
            fps = frames;
            tempo_inicio_fps = Util.tempo_decorrido() - (tempo_fps - 1000);
            frames = 0;
        }

        Util.aguarde(16);
    }

    Graficos.encerrar_modo_grafico();
}
