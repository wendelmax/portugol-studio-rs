 * desde que este cabeçalho, contendo os direitos autorais e a descrição do programa,
 * seja mantido.
 *
 * Descrição:
 *
 * 	Este exemplo demonstra o uso da função "substituir" da biblioteca "Texto" para trocar
 * 	uma sequência de caracteres por outra em um dado do tipo cadeia.
 *
 * Autores:
 *
 * 	Luiz Fernando Noschang (noschang@univali.br)
 *
 * Data: 18/07/2014
 * Adaptado para Portugol-RS (.pors)
 */

funcao inicio() {
    seja mutavel texto: cadeia = "PATO";
    seja mutavel substituicao: cadeia = "";

    /*
     * Ao substituir um texto, devem ser considerados os seguintes aspectos:
     *
     * 1 - A função "substituir" não altera o valor da variável original, mas
     *     retorna um novo valor. Desta forma, a variável "texto" mantém o valor
     *     "PATO", a não ser que o valor retornado pela função seja atribuído a ela.
     *
     * 2 - A função "substituir" diferencia letras maiúsculas e minúsculas na
     *     hora de procurar o texto que se quer substituir.
     */

    // Substitui "PA" por "RA" para formar "RATO"
    substituicao = Texto.substituir(texto, "PA", "RA");
    escreva(texto, " --> ", substituicao, "\n");

    // Substitui "PA" por "GA" para formar "GATO"
    substituicao = Texto.substituir(texto, "PA", "GA");
    escreva(texto, " --> ", substituicao, "\n");

    // Substitui "A" por "AR" para formar "PARTO"
    substituicao = Texto.substituir(texto, "A", "AR");
    escreva(texto, " --> ", substituicao, "\n");

    // Substitui "AT" por "ELICAN" para formar "PELICANO"
    substituicao = Texto.substituir(texto, "AT", "ELICAN");
    escreva(texto, " --> ", substituicao, "\n");

    // Substitui "TO" por "MONHA" para formar "PAMONHA"
    substituicao = Texto.substituir(texto, "TO", "MONHA");
    escreva(texto, " --> ", substituicao, "\n");

    // Como informamos "to" em letras minúsculas, a substituição não ocorre
    substituicao = Texto.substituir(texto, "to", "MONHA");
    escreva(texto, " --> ", substituicao, "\n");

    // Como informamos "LI" (que não existe no texto), a substituição não ocorre
    substituicao = Texto.substituir(texto, "LI", "MA");
    escreva(texto, " --> ", substituicao, "\n");

    // Realiza uma substituição e atribui o valor retornado à variável "texto"
    texto = Texto.substituir(texto, "PA", "LAGAR");
    escreva(texto, " --> ", substituicao, "\n");
}
