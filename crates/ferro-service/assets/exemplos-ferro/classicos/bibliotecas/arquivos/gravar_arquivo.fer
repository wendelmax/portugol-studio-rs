 * Descrição:
 *
 * 	Este exemplo demonstra como gravar e acrescentar texto em um arquivo
 * 	confinado ao workspace usando a biblioteca "Arquivos".
 *
 * Autores:
 *
 * 	Luiz Fernando Noschang (noschang@univali.br)
 *
 * Data: 18/07/2014
 * Adaptado para Ferro (.fer)
 */

funcao gravar_e_acrescentar(caminho: cadeia) -> Resultado < cadeia, cadeia > {
    // Em Ferro, escrever_texto cria o arquivo (ou substitui o conteúdo atual)
    seja bloco: cadeia = "Ferro Studio 1.1\nFerro Studio 1.2\nFerro Studio 1.3\n";
    seja _gravou: logico = Arquivos.escrever_texto(caminho, bloco)?;

    // acrescentar_texto adiciona o novo conteúdo ao final do arquivo existente
    seja _acrescentou: logico = Arquivos.acrescentar_texto(caminho, bloco)?;

    // Lê o resultado gravado para confirmar as duas operações
    seja conteudo: cadeia = Arquivos.ler_texto(caminho)?;
    retorne Resultado::Ok(conteudo);
}

funcao inicio() {
    seja caminho: cadeia = "dummyText.txt";

    escolha gravar_e_acrescentar(caminho) {
        caso Resultado::Ok(conteudo) => {
            escreval("Arquivo \"", caminho, "\" gravado com sucesso:\n");
            escreva(conteudo);
        }
        caso Resultado::Erro(erro) => {
            escreval("Erro ao gravar arquivo: ", erro);
        }
    }
}
