funcao inicio() {
    seja mutavel soma = 0;

    escreva("Digite o número até o qual deseja somar: ");
    seja mutavel numero: inteiro = leia();

    // Repete até o contador atingir o valor informado pelo usuário
    para (seja mutavel contador = 0; contador <= numero; contador += 1) {
        // Soma o valor atual do contador
        soma += contador;
    }

    escreval("A soma de 1 até ", numero, " é: ", soma);
}
