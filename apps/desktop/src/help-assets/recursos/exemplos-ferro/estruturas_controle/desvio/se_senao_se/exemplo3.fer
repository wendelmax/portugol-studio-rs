funcao inicio() {
    escreva("Informe a nota: ");
    seja nota: real = leia();

    se (nota >= 9.0) {
        escreval("O aluno teve um desempenho muito bom na prova");
    } senao se (nota >= 7.0) {
        escreval("O aluno teve um desempenho bom na prova");
    } senao se (nota >= 6.0) {
        escreval("O aluno teve um desempenho razoável na prova");
    } senao {
        escreval("O aluno teve um desempenho insatisfatório na prova");
    }
}
