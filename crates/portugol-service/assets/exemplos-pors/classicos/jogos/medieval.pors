 * desde que este cabeçalho, contendo os direitos autorais e a descrição do programa,
 * seja mantido.
 *
 * Descrição:
 *
 *   Personalizador de Cavaleiro Medieval! Escolha armadura, escudo, arma, elmo
 *   e cenário para montar o seu personagem medieval com visualização em tempo
 *   real e cálculo automático dos atributos de combate (Ataque, Defesa e
 *   Agilidade).
 *
 *   Controles:
 *     - Setas Acima / Abaixo: selecionam a categoria (Armadura, Escudo, Arma, Elmo, Cenario)
 *     - Setas Esquerda / Direita: alternam o item da categoria selecionada
 *     - A: sorteia um cavaleiro aleatório
 *     - P: alterna exibição da ficha resumida de atributos
 *     - ESC: encerra o programa
 *
 * Adaptado do exemplo clássico "jogos/medieval.por" para Portugol-RS (.pors)
 */

registro CavaleiroEstado {
    categoria: inteiro,
    armadura: inteiro,
    escudo: inteiro,
    arma: inteiro,
    elmo: inteiro,
    cenario: inteiro,
    exibir_ficha: logico,
    cima_estava: logico,
    baixo_estava: logico,
    esq_estava: logico,
    dir_estava: logico,
    a_estava: logico,
    p_estava: logico,
}

funcao cor_rgb(r: inteiro, g: inteiro, b: inteiro) -> inteiro {
    escolha Graficos.criar_cor(r, g, b) {
        caso Resultado::Ok(cor) => {
            retorne cor;
        }
        caso Resultado::Erro(_) => {
            retorne Graficos.COR_BRANCO;
        }
    }
}

funcao sortear_entre(minimo: inteiro, maximo: inteiro) -> inteiro {
    escolha Util.sorteia(minimo, maximo) {
        caso Resultado::Ok(v) => {
            retorne v;
        }
        caso Resultado::Erro(_) => {
            retorne minimo;
        }
    }
}

funcao desenhar_poligono_seguro(xs: vetor < inteiro >, ys: vetor < inteiro >, preencher: logico) {
    escolha Graficos.desenhar_poligono(xs, ys, preencher) {
        caso Resultado::Ok(_) => {}
        caso Resultado::Erro(_) => {}
    }
}

funcao nome_armadura(idx: inteiro) -> cadeia {
    seja nomes: vetor < cadeia > = ["Aco Real", "Tunica Rubi", "Cota Esmeralda", "Ouro Imperial", "Armadura Sombria"];
    retorne nomes[idx];
}

funcao cor_armadura(idx: inteiro) -> inteiro {
    se (idx == 0) {
        retorne cor_rgb(145, 160, 180);
    } senao se (idx == 1) {
        retorne cor_rgb(190, 48, 56);
    } senao se (idx == 2) {
        retorne cor_rgb(44, 148, 88);
    } senao se (idx == 3) {
        retorne cor_rgb(218, 172, 46);
    } senao {
        retorne cor_rgb(66, 62, 86);
    }
}

funcao nome_escudo(idx: inteiro) -> cadeia {
    seja nomes: vetor < cadeia > = ["Escudo Redondo", "Brasao Real", "Torre de Ferro", "Escudo Dourado"];
    retorne nomes[idx];
}

funcao nome_arma(idx: inteiro) -> cadeia {
    seja nomes: vetor < cadeia > = ["Espada Longa", "Machado de Guerra", "Lanca Real", "Martelo de Aco"];
    retorne nomes[idx];
}

funcao nome_elmo(idx: inteiro) -> cadeia {
    seja nomes: vetor < cadeia > = ["Elmo Fechado", "Coroa de Ferro", "Capuz do Guardiao", "Elmo Alado"];
    retorne nomes[idx];
}

funcao nome_cenario(idx: inteiro) -> cadeia {
    seja nomes: vetor < cadeia > = ["Castelo ao Amanhecer", "Floresta Mistica", "Noite na Fortaleza"];
    retorne nomes[idx];
}

funcao atualizar(estado: CavaleiroEstado) -> CavaleiroEstado {
    seja mutavel e: CavaleiroEstado = estado;

    seja cima: logico = Teclado.tecla_pressionada(Teclado.TECLA_SETA_ACIMA);
    se (cima && !e.cima_estava) {
        e.categoria = (e.categoria + 4) % 5;
    }
    e.cima_estava = cima;

    seja baixo: logico = Teclado.tecla_pressionada(Teclado.TECLA_SETA_ABAIXO);
    se (baixo && !e.baixo_estava) {
        e.categoria = (e.categoria + 1) % 5;
    }
    e.baixo_estava = baixo;

    seja esq: logico = Teclado.tecla_pressionada(Teclado.TECLA_SETA_ESQUERDA);
    seja dir: logico = Teclado.tecla_pressionada(Teclado.TECLA_SETA_DIREITA);
    seja mutavel delta = 0;
    se (esq && !e.esq_estava) {
        delta = -1;
    } senao se (dir && !e.dir_estava) {
        delta = 1;
    }
    e.esq_estava = esq;
    e.dir_estava = dir;

    se (delta != 0) {
        se (e.categoria == 0) {
            e.armadura = (e.armadura + delta + 5) % 5;
        } senao se (e.categoria == 1) {
            e.escudo = (e.escudo + delta + 4) % 4;
        } senao se (e.categoria == 2) {
            e.arma = (e.arma + delta + 4) % 4;
        } senao se (e.categoria == 3) {
            e.elmo = (e.elmo + delta + 4) % 4;
        } senao {
            e.cenario = (e.cenario + delta + 3) % 3;
        }
    }

    seja ta: logico = Teclado.tecla_pressionada(Teclado.TECLA_A);
    se (ta && !e.a_estava) {
        e.armadura = sortear_entre(0, 4);
        e.escudo = sortear_entre(0, 3);
        e.arma = sortear_entre(0, 3);
        e.elmo = sortear_entre(0, 3);
        e.cenario = sortear_entre(0, 2);
    }
    e.a_estava = ta;

    seja tp: logico = Teclado.tecla_pressionada(Teclado.TECLA_P);
    se (tp && !e.p_estava) {
        e.exibir_ficha = !e.exibir_ficha;
    }
    e.p_estava = tp;

    retorne e;
}

funcao desenhar_cenario(cenario: inteiro) {
    se (cenario == 0) {
        // Castelo ao amanhecer
        Graficos.definir_cor(cor_rgb(120, 175, 225));
        Graficos.desenhar_retangulo(20, 74, 440, 460, verdadeiro, verdadeiro);
        Graficos.definir_cor(cor_rgb(255, 215, 110));
        Graficos.desenhar_elipse(360, 106, 60, 60, verdadeiro);
        // Muralha e torres
        Graficos.definir_cor(cor_rgb(132, 136, 146));
        Graficos.desenhar_retangulo(50, 270, 90, 180, falso, verdadeiro);
        Graficos.desenhar_retangulo(340, 260, 90, 190, falso, verdadeiro);
        Graficos.desenhar_retangulo(120, 330, 240, 120, falso, verdadeiro);
        // Chão
        Graficos.definir_cor(cor_rgb(76, 148, 72));
        Graficos.desenhar_retangulo(20, 434, 440, 100, falso, verdadeiro);
    } senao se (cenario == 1) {
        // Floresta mística
        Graficos.definir_cor(cor_rgb(38, 72, 68));
        Graficos.desenhar_retangulo(20, 74, 440, 460, verdadeiro, verdadeiro);
        // Árvores
        para (seja mutavel i = 0; i < 4; i += 1) {
            seja ax: inteiro = 65 + i * 110;
            Graficos.definir_cor(cor_rgb(92, 62, 40));
            Graficos.desenhar_retangulo(ax + 18, 340, 18, 100, falso, verdadeiro);
            Graficos.definir_cor(cor_rgb(34, 118, 66));
            Graficos.desenhar_elipse(ax - 10, 260, 74, 95, verdadeiro);
        }
        Graficos.definir_cor(cor_rgb(46, 110, 58));
        Graficos.desenhar_retangulo(20, 434, 440, 100, falso, verdadeiro);
    } senao {
        // Noite na fortaleza
        Graficos.definir_cor(cor_rgb(20, 24, 48));
        Graficos.desenhar_retangulo(20, 74, 440, 460, verdadeiro, verdadeiro);
        Graficos.definir_cor(cor_rgb(235, 238, 215));
        Graficos.desenhar_elipse(355, 100, 56, 56, verdadeiro);
        Graficos.definir_cor(cor_rgb(66, 70, 92));
        Graficos.desenhar_retangulo(40, 310, 400, 130, falso, verdadeiro);
        Graficos.definir_cor(cor_rgb(56, 58, 68));
        Graficos.desenhar_retangulo(20, 434, 440, 100, falso, verdadeiro);
    }
}

funcao desenhar_cavaleiro(e: CavaleiroEstado) {
    seja cx: inteiro = 240;
    seja base_y: inteiro = 468;
    seja cor_arm: inteiro = cor_armadura(e.armadura);

    // Sombra no chão
    Graficos.definir_cor(cor_rgb(30, 38, 34));
    Graficos.desenhar_elipse(cx - 56, base_y - 12, 112, 24, verdadeiro);

    // Capa atrás
    Graficos.definir_cor(cor_rgb(138, 32, 42));
    seja xs_capa: vetor < inteiro > = [cx - 42, cx + 42, cx + 56, cx - 56];
    seja ys_capa: vetor < inteiro > = [278, 278, 430, 430];
    desenhar_poligono_seguro(xs_capa, ys_capa, verdadeiro);

    // Pernas e botas
    Graficos.definir_cor(cor_rgb(80, 84, 96));
    Graficos.desenhar_retangulo(cx - 28, 372, 20, 76, verdadeiro, verdadeiro);
    Graficos.desenhar_retangulo(cx + 8, 372, 20, 76, verdadeiro, verdadeiro);
    Graficos.definir_cor(cor_rgb(56, 42, 34));
    Graficos.desenhar_retangulo(cx - 32, 438, 28, 20, verdadeiro, verdadeiro);
    Graficos.desenhar_retangulo(cx + 4, 438, 28, 20, verdadeiro, verdadeiro);

    // Tronco / Armadura
    Graficos.definir_cor(cor_arm);
    Graficos.desenhar_retangulo(cx - 42, 274, 84, 104, verdadeiro, verdadeiro);
    Graficos.definir_cor(cor_rgb(230, 200, 90));
    Graficos.desenhar_retangulo(cx - 42, 352, 84, 12, falso, verdadeiro);

    // Braços
    Graficos.definir_cor(cor_arm);
    Graficos.desenhar_retangulo(cx - 64, 284, 22, 74, verdadeiro, verdadeiro);
    Graficos.desenhar_retangulo(cx + 42, 284, 22, 74, verdadeiro, verdadeiro);

    // Cabeça / Elmo
    Graficos.definir_cor(cor_rgb(235, 198, 164));
    Graficos.desenhar_elipse(cx - 26, 206, 52, 56, verdadeiro);

    se (e.elmo == 0) {
        // Elmo fechado
        Graficos.definir_cor(cor_rgb(160, 170, 188));
        Graficos.desenhar_elipse(cx - 30, 198, 60, 64, verdadeiro);
        Graficos.definir_cor(cor_rgb(28, 32, 42));
        Graficos.desenhar_retangulo(cx - 20, 226, 40, 8, falso, verdadeiro);
        Graficos.desenhar_retangulo(cx - 4, 220, 8, 28, falso, verdadeiro);
    } senao se (e.elmo == 1) {
        // Coroa de ferro
        Graficos.definir_cor(cor_rgb(235, 190, 52));
        seja xs_cor: vetor < inteiro > = [cx - 26, cx - 20, cx - 10, cx, cx + 10, cx + 20, cx + 26, cx + 26, cx - 26];
        seja ys_cor: vetor < inteiro > = [212, 192, 208, 188, 208, 192, 212, 222, 222];
        desenhar_poligono_seguro(xs_cor, ys_cor, verdadeiro);
    } senao se (e.elmo == 2) {
        // Capuz
        Graficos.definir_cor(cor_rgb(48, 118, 72));
        Graficos.desenhar_elipse(cx - 32, 196, 64, 42, verdadeiro);
    } senao {
        // Elmo alado
        Graficos.definir_cor(cor_rgb(175, 185, 205));
        Graficos.desenhar_elipse(cx - 28, 198, 56, 36, verdadeiro);
        Graficos.definir_cor(Graficos.COR_BRANCO);
        seja xs_ae: vetor < inteiro > = [cx - 26, cx - 50, cx - 34];
        seja ys_ae: vetor < inteiro > = [214, 184, 226];
        desenhar_poligono_seguro(xs_ae, ys_ae, verdadeiro);
        seja xs_ad: vetor < inteiro > = [cx + 26, cx + 50, cx + 34];
        seja ys_ad: vetor < inteiro > = [214, 184, 226];
        desenhar_poligono_seguro(xs_ad, ys_ad, verdadeiro);
    }

    // Arma na mão direita
    seja ax: inteiro = cx + 62;
    seja ay: inteiro = 330;
    se (e.arma == 0) {
        // Espada longa
        Graficos.definir_cor(cor_rgb(205, 215, 228));
        Graficos.desenhar_retangulo(ax - 4, ay - 108, 8, 96, falso, verdadeiro);
        Graficos.definir_cor(cor_rgb(218, 172, 46));
        Graficos.desenhar_retangulo(ax - 16, ay - 14, 32, 6, falso, verdadeiro);
        Graficos.desenhar_retangulo(ax - 3, ay - 8, 6, 22, falso, verdadeiro);
    } senao se (e.arma == 1) {
        // Machado de guerra
        Graficos.definir_cor(cor_rgb(124, 82, 48));
        Graficos.desenhar_retangulo(ax - 3, ay - 102, 6, 118, falso, verdadeiro);
        Graficos.definir_cor(cor_rgb(180, 190, 205));
        seja xs_m: vetor < inteiro > = [ax + 2, ax + 34, ax + 28, ax + 2];
        seja ys_m: vetor < inteiro > = [ay - 96, ay - 108, ay - 62, ay - 74];
        desenhar_poligono_seguro(xs_m, ys_m, verdadeiro);
    } senao se (e.arma == 2) {
        // Lança real
        Graficos.definir_cor(cor_rgb(138, 96, 54));
        Graficos.desenhar_retangulo(ax - 2, ay - 135, 5, 165, falso, verdadeiro);
        Graficos.definir_cor(cor_rgb(220, 228, 240));
        seja xs_l: vetor < inteiro > = [ax - 8, ax + 8, ax];
        seja ys_l: vetor < inteiro > = [ay - 132, ay - 132, ay - 160];
        desenhar_poligono_seguro(xs_l, ys_l, verdadeiro);
    } senao {
        // Martelo de aço
        Graficos.definir_cor(cor_rgb(112, 74, 42));
        Graficos.desenhar_retangulo(ax - 3, ay - 96, 6, 112, falso, verdadeiro);
        Graficos.definir_cor(cor_rgb(142, 152, 168));
        Graficos.desenhar_retangulo(ax - 22, ay - 112, 44, 26, verdadeiro, verdadeiro);
    }

    // Escudo na mão esquerda
    seja ex: inteiro = cx - 72;
    seja ey: inteiro = 310;
    se (e.escudo == 0) {
        Graficos.definir_cor(cor_rgb(148, 92, 46));
        Graficos.desenhar_elipse(ex - 26, ey - 10, 56, 56, verdadeiro);
        Graficos.definir_cor(cor_rgb(200, 208, 220));
        Graficos.desenhar_elipse(ex - 26, ey - 10, 56, 56, falso);
        Graficos.desenhar_elipse(ex - 6, ey + 10, 16, 16, verdadeiro);
    } senao se (e.escudo == 1) {
        Graficos.definir_cor(cor_rgb(44, 92, 185));
        seja xs_e1: vetor < inteiro > = [ex - 26, ex + 26, ex + 22, ex, ex - 22];
        seja ys_e1: vetor < inteiro > = [ey - 12, ey - 12, ey + 34, ey + 56, ey + 34];
        desenhar_poligono_seguro(xs_e1, ys_e1, verdadeiro);
        Graficos.definir_cor(cor_rgb(245, 208, 60));
        Graficos.desenhar_retangulo(ex - 4, ey - 6, 8, 52, falso, verdadeiro);
        Graficos.desenhar_retangulo(ex - 18, ey + 14, 36, 8, falso, verdadeiro);
    } senao se (e.escudo == 2) {
        Graficos.definir_cor(cor_rgb(122, 130, 146));
        Graficos.desenhar_retangulo(ex - 24, ey - 20, 48, 86, verdadeiro, verdadeiro);
        Graficos.definir_cor(cor_rgb(210, 218, 230));
        Graficos.desenhar_retangulo(ex - 24, ey - 20, 48, 86, verdadeiro, falso);
    } senao {
        Graficos.definir_cor(cor_rgb(225, 178, 44));
        seja xs_e3: vetor < inteiro > = [ex - 28, ex + 28, ex + 24, ex, ex - 24];
        seja ys_e3: vetor < inteiro > = [ey - 14, ey - 14, ey + 36, ey + 58, ey + 36];
        desenhar_poligono_seguro(xs_e3, ys_e3, verdadeiro);
        Graficos.definir_cor(cor_rgb(185, 38, 42));
        Graficos.desenhar_elipse(ex - 10, ey + 8, 20, 20, verdadeiro);
    }
}

funcao desenhar(e: CavaleiroEstado) {
    Graficos.definir_cor(cor_rgb(24, 24, 32));
    Graficos.limpar();

    // Cabeçalho
    Graficos.definir_cor(cor_rgb(36, 36, 48));
    Graficos.desenhar_retangulo(0, 0, 800, 60, falso, verdadeiro);
    Graficos.definir_cor(cor_rgb(245, 205, 86));
    Graficos.definir_tamanho_texto(22.0);
    Graficos.desenhar_texto(20, 10, "OFICINA DO CAVALEIRO MEDIEVAL");
    Graficos.definir_cor(cor_rgb(190, 196, 212));
    Graficos.definir_tamanho_texto(12.0);
    Graficos.desenhar_texto(20, 38, "[Setas Cima/Baixo] Categoria  |  [Setas Esq/Dir] Trocar Item  |  [A] Aleatorio  |  [P] Ficha  |  [ESC] Sair");

    // Palco do personagem
    desenhar_cenario(e.cenario);
    desenhar_cavaleiro(e);

    // Painel direito de seleção
    Graficos.definir_cor(cor_rgb(34, 36, 46));
    Graficos.desenhar_retangulo(480, 74, 300, 460, verdadeiro, verdadeiro);

    seja rotulos: vetor < cadeia > = ["ARMADURA", "ESCUDO", "ARMA", "ELMO", "CENARIO"];
    seja valores: vetor < cadeia > = [
    nome_armadura(e.armadura),
    nome_escudo(e.escudo),
    nome_arma(e.arma),
    nome_elmo(e.elmo),
    nome_cenario(e.cenario)
    ];

    para (seja mutavel i = 0; i < 5; i += 1) {
        seja py: inteiro = 92 + i * 62;
        se (i == e.categoria) {
            Graficos.definir_cor(cor_rgb(70, 62, 42));
            Graficos.desenhar_retangulo(494, py, 272, 52, verdadeiro, verdadeiro);
            Graficos.definir_cor(cor_rgb(245, 205, 86));
            Graficos.desenhar_retangulo(494, py, 272, 52, verdadeiro, falso);
        } senao {
            Graficos.definir_cor(cor_rgb(44, 48, 60));
            Graficos.desenhar_retangulo(494, py, 272, 52, verdadeiro, verdadeiro);
        }

        Graficos.definir_cor(cor_rgb(180, 188, 205));
        Graficos.definir_tamanho_texto(11.0);
        Graficos.desenhar_texto(508, py + 7, rotulos[i]);

        Graficos.definir_cor(Graficos.COR_BRANCO);
        Graficos.definir_tamanho_texto(15.0);
        Graficos.desenhar_texto(508, py + 24, "<  " + valores[i] + "  >");
    }

    // Atributos calculados
    seja ataque: inteiro = 55 + e.arma * 12 + e.armadura * 3;
    seja defesa: inteiro = 50 + e.escudo * 14 + e.armadura * 5 + e.elmo * 4;
    seja agilidade: inteiro = 90 - e.escudo * 7 - e.armadura * 4 + e.elmo * 5;

    se (e.exibir_ficha) {
        Graficos.definir_cor(cor_rgb(26, 28, 38));
        Graficos.desenhar_retangulo(494, 412, 272, 108, verdadeiro, verdadeiro);
        Graficos.definir_cor(cor_rgb(245, 205, 86));
        Graficos.definir_tamanho_texto(13.0);
        Graficos.desenhar_texto(508, 420, "ATRIBUTOS DO CAVALEIRO");

        Graficos.definir_cor(cor_rgb(240, 96, 96));
        Graficos.desenhar_texto(508, 444, "Ataque: " + Tipos.inteiro_para_cadeia(ataque));
        Graficos.desenhar_retangulo(610, 446, ataque, 10, verdadeiro, verdadeiro);

        Graficos.definir_cor(cor_rgb(80, 180, 250));
        Graficos.desenhar_texto(508, 468, "Defesa: " + Tipos.inteiro_para_cadeia(defesa));
        Graficos.desenhar_retangulo(610, 470, defesa, 10, verdadeiro, verdadeiro);

        Graficos.definir_cor(cor_rgb(96, 224, 132));
        Graficos.desenhar_texto(508, 492, "Agilid: " + Tipos.inteiro_para_cadeia(agilidade));
        Graficos.desenhar_retangulo(610, 494, agilidade, 10, verdadeiro, verdadeiro);
    }

    Graficos.renderizar();
}

funcao inicio() {
    Graficos.iniciar_modo_grafico(verdadeiro);
    Graficos.definir_dimensoes_janela(800, 560);
    Graficos.definir_titulo_janela("Medieval - Personalizador de Cavaleiro");

    seja mutavel estado: CavaleiroEstado = CavaleiroEstado {
        categoria: 0,
        armadura: 0,
        escudo: 1,
        arma: 0,
        elmo: 0,
        cenario: 0,
        exibir_ficha: verdadeiro,
        cima_estava: falso,
        baixo_estava: falso,
        esq_estava: falso,
        dir_estava: falso,
        a_estava: falso,
        p_estava: falso,
    }
    ;

    enquanto (!Teclado.tecla_pressionada(Teclado.TECLA_ESC)) {
        estado = atualizar(estado);
        desenhar(estado);
        Util.aguarde(16);
    }

    Graficos.encerrar_modo_grafico();
}
