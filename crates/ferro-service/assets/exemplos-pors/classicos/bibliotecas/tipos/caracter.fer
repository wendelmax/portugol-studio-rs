funcao inicio() {
    seja cad1: cadeia = "Olá";
    seja cad2: cadeia = "A";

    // A função "cadeia_e_caracter" verifica se uma cadeia possui exatamente 1 caracter
    se (Tipos.cadeia_e_caracter(cad1)) {
        escreval("A cadeia \"", cad1, "\" representa um caracter");
    } senao {
        escreval("A cadeia \"", cad1, "\" não representa um único caracter");
    }

    se (Tipos.cadeia_e_caracter(cad2)) {
        escreval("A cadeia \"", cad2, "\" representa um caracter");

        // Converte a cadeia para caracter com segurança usando Resultado<caracter, cadeia>
        escolha Tipos.para_caracter(cad2) {
            caso Resultado::Ok(car) => {
                escreval("Caracter convertido: '", car, "'");
                escreval("Convertido de volta para cadeia: \"", Tipos.caracter_para_cadeia(car), "\"");
            }
            caso Resultado::Erro(erro) => {
                escreval("Erro ao converter para caracter: ", erro);
            }
        }
    }

    // Conversão entre dígito caracter ('0'..'9') e inteiro
    seja digito: caracter = '7';
    escolha Tipos.caracter_para_inteiro(digito) {
        caso Resultado::Ok(valor) => {
            escreval("\nCaracter '", digito, "' convertido para inteiro: ", valor);
        }
        caso Resultado::Erro(erro) => {
            escreval("Erro ao converter caracter para inteiro: ", erro);
        }
    }

    // Conversão de inteiro (0..9) para caracter
    escolha Tipos.inteiro_para_caracter(5) {
        caso Resultado::Ok(c) => {
            escreval("Inteiro 5 convertido para caracter: '", c, "'");
        }
        caso Resultado::Erro(erro) => {
            escreval("Erro ao converter inteiro para caracter: ", erro);
        }
    }
}
