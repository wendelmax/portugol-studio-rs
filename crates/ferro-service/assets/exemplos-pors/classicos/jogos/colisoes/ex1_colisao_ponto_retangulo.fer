 * desde que este cabeçalho, contendo os direitos autorais e a descrição do programa,
 * seja mantido.
 *
 * Descrição:
 *
 *   Este exemplo demonstra como é detectada a colisão entre um ponto e um retângulo.
 *
 *   Controles:
 *     - Setas: movem o retângulo A
 *     - W, A, S, D: movem o ponto P
 *     - G: exibe/oculta as guias visuais de projeção
 *     - C: ativa/desativa o tratamento (bloqueio) de colisões
 *     - ESC: encerra o programa
 *
 * Autor (versão original):
 *
 *   Luiz Fernando Noschang (noschang@univali.br)
 *
 * Data original: 26/06/2017
 * Adaptado para Ferro (.pors)
 */

registro CenaPontoRetangulo {
    rx: inteiro,
    ry: inteiro,
    rl: inteiro,
    ra: inteiro,
    px: inteiro,
    py: inteiro,
    exibir_guias: logico,
    tratar_colisoes: logico,
    tecla_g_estava: logico,
    tecla_c_estava: logico,
}

funcao cor_rgb(r: inteiro, g: inteiro, b: inteiro) -> inteiro {
    escolha Graficos.criar_cor(r, g, b) {
        caso Resultado::Ok(cor) => {
            retorne cor;
        }
        caso Resultado::Erro(_) => {
            retorne Graficos.COR_BRANCO;
        }
    }
}

funcao ponto_dentro_retangulo(px: inteiro, py: inteiro, rx: inteiro, ry: inteiro, rl: inteiro, ra: inteiro) -> logico {
    seja direita: inteiro = rx + rl;
    seja base: inteiro = ry + ra;
    retorne px >= rx && px <= direita && py >= ry && py <= base;
}

funcao ocorreu_colisao(cena: CenaPontoRetangulo) -> logico {
    retorne ponto_dentro_retangulo(cena.px, cena.py, cena.rx, cena.ry, cena.rl, cena.ra);
}

funcao limitar(valor: inteiro, minimo: inteiro, maximo: inteiro) -> inteiro {
    se (valor < minimo) {
        retorne minimo;
    }
    se (valor > maximo) {
        retorne maximo;
    }
    retorne valor;
}

funcao atualizar(cena: CenaPontoRetangulo) -> CenaPontoRetangulo {
    seja mutavel nova: CenaPontoRetangulo = cena;
    seja passo: inteiro = 3;

    // Alternar guias [G]
    seja g_pressionada: logico = Teclado.tecla_pressionada(Teclado.TECLA_G);
    se (g_pressionada && !nova.tecla_g_estava) {
        nova.exibir_guias = !nova.exibir_guias;
    }
    nova.tecla_g_estava = g_pressionada;

    // Alternar tratamento de colisões [C]
    seja c_pressionada: logico = Teclado.tecla_pressionada(Teclado.TECLA_C);
    se (c_pressionada && !nova.tecla_c_estava) {
        nova.tratar_colisoes = !nova.tratar_colisoes;
        se (nova.tratar_colisoes && ocorreu_colisao(nova)) {
            nova.rx = 160;
            nova.ry = 280;
            nova.px = 520;
            nova.py = 310;
        }
    }
    nova.tecla_c_estava = c_pressionada;

    // Movimento do retângulo (Setas)
    seja rx_ant: inteiro = nova.rx;
    seja ry_ant: inteiro = nova.ry;
    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_ESQUERDA)) {
        nova.rx = limitar(nova.rx - passo, 20, 780 - nova.rl);
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_DIREITA)) {
        nova.rx = limitar(nova.rx + passo, 20, 780 - nova.rl);
    }
    se (nova.tratar_colisoes && ocorreu_colisao(nova)) {
        nova.rx = rx_ant;
    }

    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_ACIMA)) {
        nova.ry = limitar(nova.ry - passo, 90, 580 - nova.ra);
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_ABAIXO)) {
        nova.ry = limitar(nova.ry + passo, 90, 580 - nova.ra);
    }
    se (nova.tratar_colisoes && ocorreu_colisao(nova)) {
        nova.ry = ry_ant;
    }

    // Movimento do ponto (WASD)
    seja px_ant: inteiro = nova.px;
    seja py_ant: inteiro = nova.py;
    se (Teclado.tecla_pressionada(Teclado.TECLA_A)) {
        nova.px = limitar(nova.px - passo, 20, 780);
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_D)) {
        nova.px = limitar(nova.px + passo, 20, 780);
    }
    se (nova.tratar_colisoes && ocorreu_colisao(nova)) {
        nova.px = px_ant;
    }

    se (Teclado.tecla_pressionada(Teclado.TECLA_W)) {
        nova.py = limitar(nova.py - passo, 90, 580);
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_S)) {
        nova.py = limitar(nova.py + passo, 90, 580);
    }
    se (nova.tratar_colisoes && ocorreu_colisao(nova)) {
        nova.py = py_ant;
    }

    retorne nova;
}

funcao desenhar(cena: CenaPontoRetangulo) {
    seja colidiu: logico = ocorreu_colisao(cena);

    Graficos.definir_cor(cor_rgb(245, 247, 250));
    Graficos.limpar();

    // Cabeçalho de instruções
    Graficos.definir_cor(cor_rgb(30, 38, 52));
    Graficos.desenhar_retangulo(0, 0, 800, 76, falso, verdadeiro);
    Graficos.definir_cor(Graficos.COR_BRANCO);
    Graficos.definir_tamanho_texto(18.0);
    Graficos.desenhar_texto(18, 12, "Colisao 1: Ponto x Retangulo");
    Graficos.definir_tamanho_texto(12.0);
    Graficos.definir_cor(cor_rgb(200, 210, 225));
    Graficos.desenhar_texto(18, 40, "[Setas] Mover Retangulo  |  [WASD] Mover Ponto  |  [G] Guias  |  [C] Tratar Colisao  |  [ESC] Sair");

    seja mutavel texto_status: cadeia = "Sem colisao";
    se (colidiu) {
        texto_status = "COLISAO DETECTADA!";
        Graficos.definir_cor(cor_rgb(255, 100, 100));
    } senao {
        Graficos.definir_cor(cor_rgb(120, 230, 150));
    }
    Graficos.definir_tamanho_texto(14.0);
    Graficos.desenhar_texto(560, 14, texto_status);

    // Guias visuais
    se (cena.exibir_guias) {
        Graficos.definir_cor(cor_rgb(170, 180, 195));
        Graficos.desenhar_linha(cena.rx, 76, cena.rx, 600);
        Graficos.desenhar_linha(cena.rx + cena.rl, 76, cena.rx + cena.rl, 600);
        Graficos.desenhar_linha(0, cena.ry, 800, cena.ry);
        Graficos.desenhar_linha(0, cena.ry + cena.ra, 800, cena.ry + cena.ra);

        Graficos.definir_cor(cor_rgb(150, 0, 150));
        Graficos.desenhar_linha(cena.px, 76, cena.px, 600);
        Graficos.desenhar_linha(0, cena.py, 800, cena.py);
    }

    // Retângulo
    se (colidiu) {
        Graficos.definir_cor(cor_rgb(102, 255, 153));
    } senao {
        Graficos.definir_cor(cor_rgb(102, 204, 255));
    }
    Graficos.desenhar_retangulo(cena.rx, cena.ry, cena.rl, cena.ra, falso, verdadeiro);
    Graficos.definir_cor(cor_rgb(30, 60, 90));
    Graficos.desenhar_retangulo(cena.rx, cena.ry, cena.rl, cena.ra, falso, falso);
    Graficos.definir_tamanho_texto(14.0);
    Graficos.desenhar_texto(cena.rx + cena.rl / 2 - 6, cena.ry + cena.ra / 2 - 7, "R");

    // Ponto
    se (colidiu) {
        Graficos.definir_cor(cor_rgb(230, 30, 30));
    } senao {
        Graficos.definir_cor(cor_rgb(0, 120, 40));
    }
    Graficos.desenhar_elipse(cena.px - 6, cena.py - 6, 12, 12, verdadeiro);
    Graficos.desenhar_texto(cena.px + 10, cena.py - 12, "P(" + Tipos.inteiro_para_cadeia(cena.px) + "," + Tipos.inteiro_para_cadeia(cena.py) + ")");

    // Rodapé pedagógico
    Graficos.definir_cor(cor_rgb(40, 45, 55));
    Graficos.definir_tamanho_texto(12.0);
    seja cond_str: cadeia = "Condicao: px >= rx && px <= rx+rl && py >= ry && py <= ry+ra";
    Graficos.desenhar_texto(18, 574, cond_str + "  |  Tratar colisoes: " + Tipos.logico_para_cadeia(cena.tratar_colisoes) + "  |  Guias: " + Tipos.logico_para_cadeia(cena.exibir_guias));

    Graficos.renderizar();
}

funcao inicio() {
    Graficos.iniciar_modo_grafico(verdadeiro);
    Graficos.definir_dimensoes_janela(800, 600);
    Graficos.definir_titulo_janela("Colisao: Ponto e Retangulo - Ferro");

    seja mutavel cena: CenaPontoRetangulo = CenaPontoRetangulo {
        rx: 180,
        ry: 260,
        rl: 140,
        ra: 100,
        px: 520,
        py: 310,
        exibir_guias: verdadeiro,
        tratar_colisoes: falso,
        tecla_g_estava: falso,
        tecla_c_estava: falso,
    }
    ;

    enquanto (!Teclado.tecla_pressionada(Teclado.TECLA_ESC)) {
        cena = atualizar(cena);
        desenhar(cena);
        Util.aguarde(16);
    }

    Graficos.encerrar_modo_grafico();
}
