 *
 * Descrição:
 *
 *     Este exemplo pede ao usuário que informe um valor inteiro. Logo após, calcula e
 *     exibe a soma dos números de 1 até o número digitado.
 *
 * Autores:
 *
 *     Giordana Maria da Costa Valle
 *     Carlos Alexandre Krueger
 *
 * Data: 01/06/2013
 */

funcao inicio() {
    seja mutavel soma: inteiro = 0;
    seja mutavel numero: inteiro = 0;

    escreva("Digite o número até o qual deseja somar: ");
    leia(numero);

    // Repete até o contador atingir o valor informado pelo usuário
    para (seja mutavel contador: inteiro = 0; contador <= numero; contador += 1) {
        // Soma o valor atual do contador
        soma += contador;
    }

    escreva("A soma de 1 até ", numero, " é: ", soma, "\n");
}
