 * seja mantido.
 *
 * Descrição:
 *
 *     Este exemplo cria e preenche um vetor com números aleatórios. Logo após exibe o vetor
 *     no console de duas formas diferentes:
 *
 *       a) Na ordem em que os números foram preenchidos
 *       b) Na ordem inversa em que os números foram preenchidos
 *
 * Autores:
 *
 *     Giordana Maria da Costa Valle
 *     Carlos Alexandre Krueger
 *
 * Data: 01/06/2013
 */

funcao sortear(minimo: inteiro, maximo: inteiro) -> inteiro {
    escolha Util.sorteia(minimo, maximo) {
        caso Resultado::Ok(valor) => {
            retorne valor;
        }
        caso Resultado::Erro(_) => {
            retorne minimo;
        }
    }
}

funcao inicio() {
    seja mutavel numeros: vetor < inteiro > = [];

    // Preenche o vetor com 10 números aleatórios
    para (seja mutavel posicao = 0; posicao < 10; posicao += 1) {
        adicionar(numeros, sortear(1, 100));
    }

    // Exibe o vetor na ordem original
    escreval("Vetor na ordem original:");
    para (seja mutavel posicao = 0; posicao < tamanho(numeros); posicao += 1) {
        escreva(numeros[posicao], " ");
    }

    // Exibe o vetor na ordem inversa
    escreval("\n\nVetor na ordem inversa:");
    para (seja mutavel posicao: inteiro = tamanho(numeros) - 1; posicao >= 0; posicao -= 1) {
        escreva(numeros[posicao], " ");
    }
    escreval();
}
