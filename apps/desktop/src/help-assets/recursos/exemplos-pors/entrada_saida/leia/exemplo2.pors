funcao inicio() {
    escreva("Informe a sua idade: ");
    seja mutavel idade: inteiro = leia();

    escreva("Informe seu salário: ");
    seja mutavel salario: real = leia();

    escreva("Informe o seu nome: ");
    seja mutavel nome = leia();

    escreva("Informe o seu sobrenome: ");
    seja mutavel sobrenome = leia();

    escreval("Informe as suas três notas (uma por linha):");
    seja mutavel nota1: real = leia();
    seja mutavel nota2: real = leia();
    seja mutavel nota3: real = leia();

    escreval("Seu nome é: ", nome, " ", sobrenome);
    escreval("Você tem ", idade, " anos e ganha de salário ", salario);
    escreval("Suas três notas foram:");
    escreval("Nota 1: ", nota1);
    escreval("Nota 2: ", nota2);
    escreval("Nota 3: ", nota3);
}
