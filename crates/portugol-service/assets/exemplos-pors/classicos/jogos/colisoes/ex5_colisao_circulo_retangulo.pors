 * desde que este cabeçalho, contendo os direitos autorais e a descrição do programa,
 * seja mantido.
 *
 * Descrição:
 *
 *   Este exemplo demonstra como é detectada a colisão entre um círculo e um
 *   retângulo, verificando o ponto mais próximo do retângulo ao centro do círculo
 *   e também exibindo os vértices e pontos trigonométricos de referência.
 *
 *   Controles:
 *     - Setas: movem o círculo C
 *     - W, A, S, D: movem o retângulo R
 *     - G: exibe/oculta as guias geométricas (ponto mais próximo e pontos trigonométricos)
 *     - C: ativa/desativa o bloqueio de colisões
 *     - ESC: encerra o programa
 *
 * Autor (versão original):
 *
 *   Luiz Fernando Noschang (noschang@univali.br)
 *
 * Data original: 26/06/2017
 * Adaptado para Portugol-RS (.pors)
 */

registro CenaCirculoRetangulo {
    cx: inteiro,
    cy: inteiro,
    raio: inteiro,
    rx: inteiro,
    ry: inteiro,
    rl: inteiro,
    ra: inteiro,
    pontos_guia: inteiro,
    exibir_guias: logico,
    tratar_colisoes: logico,
    tecla_g_estava: logico,
    tecla_c_estava: logico,
}

funcao cor_rgb(r: inteiro, g: inteiro, b: inteiro) -> inteiro {
    escolha Graficos.criar_cor(r, g, b) {
        caso Resultado::Ok(cor) => {
            retorne cor;
        }
        caso Resultado::Erro(_) => {
            retorne Graficos.COR_BRANCO;
        }
    }
}

funcao limitar(valor: inteiro, minimo: inteiro, maximo: inteiro) -> inteiro {
    se (valor < minimo) {
        retorne minimo;
    }
    se (valor > maximo) {
        retorne maximo;
    }
    retorne valor;
}

funcao distancia_pontos(xa: inteiro, ya: inteiro, xb: inteiro, yb: inteiro) -> real {
    seja dx: real = Tipos.inteiro_para_real(xb - xa);
    seja dy: real = Tipos.inteiro_para_real(yb - ya);
    retorne Matematica.raiz_quadrada(dx * dx + dy * dy);
}

funcao ocorreu_colisao(cena: CenaCirculoRetangulo) -> logico {
    // Encontra o ponto do retângulo mais próximo do centro do círculo
    seja px: inteiro = limitar(cena.cx, cena.rx, cena.rx + cena.rl);
    seja py: inteiro = limitar(cena.cy, cena.ry, cena.ry + cena.ra);
    retorne distancia_pontos(cena.cx, cena.cy, px, py) <= Tipos.inteiro_para_real(cena.raio);
}

funcao atualizar(cena: CenaCirculoRetangulo) -> CenaCirculoRetangulo {
    seja mutavel nova: CenaCirculoRetangulo = cena;
    seja passo: inteiro = 3;

    seja g_p: logico = Teclado.tecla_pressionada(Teclado.TECLA_G);
    se (g_p && !nova.tecla_g_estava) {
        nova.exibir_guias = !nova.exibir_guias;
    }
    nova.tecla_g_estava = g_p;

    seja c_p: logico = Teclado.tecla_pressionada(Teclado.TECLA_C);
    se (c_p && !nova.tecla_c_estava) {
        nova.tratar_colisoes = !nova.tratar_colisoes;
        se (nova.tratar_colisoes && ocorreu_colisao(nova)) {
            nova.cx = 200;
            nova.cy = 310;
            nova.rx = 480;
            nova.ry = 250;
        }
    }
    nova.tecla_c_estava = c_p;

    // Círculo (Setas)
    seja cx_ant: inteiro = nova.cx;
    seja cy_ant: inteiro = nova.cy;
    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_ESQUERDA)) {
        nova.cx = limitar(nova.cx - passo, 16 + nova.raio, 784 - nova.raio);
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_DIREITA)) {
        nova.cx = limitar(nova.cx + passo, 16 + nova.raio, 784 - nova.raio);
    }
    se (nova.tratar_colisoes && ocorreu_colisao(nova)) {
        nova.cx = cx_ant;
    }

    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_ACIMA)) {
        nova.cy = limitar(nova.cy - passo, 84 + nova.raio, 560 - nova.raio);
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_ABAIXO)) {
        nova.cy = limitar(nova.cy + passo, 84 + nova.raio, 560 - nova.raio);
    }
    se (nova.tratar_colisoes && ocorreu_colisao(nova)) {
        nova.cy = cy_ant;
    }

    // Retângulo (WASD)
    seja rx_ant: inteiro = nova.rx;
    seja ry_ant: inteiro = nova.ry;
    se (Teclado.tecla_pressionada(Teclado.TECLA_A)) {
        nova.rx = limitar(nova.rx - passo, 16, 784 - nova.rl);
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_D)) {
        nova.rx = limitar(nova.rx + passo, 16, 784 - nova.rl);
    }
    se (nova.tratar_colisoes && ocorreu_colisao(nova)) {
        nova.rx = rx_ant;
    }

    se (Teclado.tecla_pressionada(Teclado.TECLA_W)) {
        nova.ry = limitar(nova.ry - passo, 84, 560 - nova.ra);
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_S)) {
        nova.ry = limitar(nova.ry + passo, 84, 560 - nova.ra);
    }
    se (nova.tratar_colisoes && ocorreu_colisao(nova)) {
        nova.ry = ry_ant;
    }

    retorne nova;
}

funcao desenhar(cena: CenaCirculoRetangulo) {
    seja colidiu: logico = ocorreu_colisao(cena);
    seja px_prox: inteiro = limitar(cena.cx, cena.rx, cena.rx + cena.rl);
    seja py_prox: inteiro = limitar(cena.cy, cena.ry, cena.ry + cena.ra);
    seja dist: inteiro = Tipos.real_para_inteiro(distancia_pontos(cena.cx, cena.cy, px_prox, py_prox));

    Graficos.definir_cor(cor_rgb(245, 247, 250));
    Graficos.limpar();

    // Cabeçalho
    Graficos.definir_cor(cor_rgb(30, 38, 52));
    Graficos.desenhar_retangulo(0, 0, 800, 76, falso, verdadeiro);
    Graficos.definir_cor(Graficos.COR_BRANCO);
    Graficos.definir_tamanho_texto(18.0);
    Graficos.desenhar_texto(18, 12, "Colisao 5: Circulo x Retangulo");
    Graficos.definir_tamanho_texto(12.0);
    Graficos.definir_cor(cor_rgb(200, 210, 225));
    Graficos.desenhar_texto(18, 40, "[Setas] Mover Circulo  |  [WASD] Mover Retangulo  |  [G] Guias  |  [C] Tratar Colisao  |  [ESC] Sair");

    se (colidiu) {
        Graficos.definir_cor(cor_rgb(255, 100, 100));
        Graficos.definir_tamanho_texto(14.0);
        Graficos.desenhar_texto(560, 14, "COLISAO DETECTADA!");
    } senao {
        Graficos.definir_cor(cor_rgb(120, 230, 150));
        Graficos.definir_tamanho_texto(14.0);
        Graficos.desenhar_texto(560, 14, "Sem colisao");
    }

    // Círculo
    se (colidiu) {
        Graficos.definir_cor(cor_rgb(102, 255, 153));
    } senao {
        Graficos.definir_cor(cor_rgb(102, 204, 255));
    }
    Graficos.desenhar_elipse(cena.cx - cena.raio, cena.cy - cena.raio, cena.raio * 2, cena.raio * 2, verdadeiro);
    Graficos.definir_cor(cor_rgb(30, 60, 90));
    Graficos.desenhar_elipse(cena.cx - cena.raio, cena.cy - cena.raio, cena.raio * 2, cena.raio * 2, falso);
    Graficos.definir_tamanho_texto(15.0);
    Graficos.desenhar_texto(cena.cx - 6, cena.cy - 24, "C");

    // Retângulo
    se (colidiu) {
        Graficos.definir_cor(cor_rgb(255, 153, 102));
    } senao {
        Graficos.definir_cor(cor_rgb(255, 240, 110));
    }
    Graficos.desenhar_retangulo(cena.rx, cena.ry, cena.rl, cena.ra, falso, verdadeiro);
    Graficos.definir_cor(cor_rgb(100, 75, 20));
    Graficos.desenhar_retangulo(cena.rx, cena.ry, cena.rl, cena.ra, falso, falso);
    Graficos.desenhar_texto(cena.rx + cena.rl / 2 - 6, cena.ry + cena.ra / 2 - 8, "R");

    // Guias geométricas
    se (cena.exibir_guias) {
        // Pontos trigonométricos na borda do círculo
        seja inc: real = (Matematica.PI * 2.0) / Tipos.inteiro_para_real(cena.pontos_guia);
        Graficos.definir_cor(cor_rgb(153, 0, 153));
        para (seja mutavel i = 0; i < cena.pontos_guia; i += 1) {
            seja ang: real = inc * Tipos.inteiro_para_real(i);
            seja gx: inteiro = cena.cx + Tipos.real_para_inteiro(Matematica.cosseno(ang) * Tipos.inteiro_para_real(cena.raio));
            seja gy: inteiro = cena.cy + Tipos.real_para_inteiro(Matematica.seno(ang) * Tipos.inteiro_para_real(cena.raio));
            Graficos.desenhar_elipse(gx - 3, gy - 3, 6, 6, verdadeiro);
        }

        // Segmento até o ponto mais próximo do retângulo
        Graficos.definir_cor(Graficos.COR_PRETO);
        Graficos.desenhar_linha(cena.cx, cena.cy, px_prox, py_prox);
        Graficos.definir_cor(cor_rgb(220, 30, 30));
        Graficos.desenhar_elipse(px_prox - 5, py_prox - 5, 10, 10, verdadeiro);
        Graficos.definir_cor(Graficos.COR_PRETO);
        Graficos.definir_tamanho_texto(12.0);
        Graficos.desenhar_texto((cena.cx + px_prox) / 2, (cena.cy + py_prox) / 2 - 14, "d=" + Tipos.inteiro_para_cadeia(dist));
    }

    // Rodapé pedagógico
    Graficos.definir_cor(cor_rgb(40, 45, 55));
    Graficos.definir_tamanho_texto(12.0);
    Graficos.desenhar_texto(18, 574, "Distancia ao ponto mais proximo: " + Tipos.inteiro_para_cadeia(dist) + " px  |  Raio: " + Tipos.inteiro_para_cadeia(cena.raio) + " px  |  Tratar: " + Tipos.logico_para_cadeia(cena.tratar_colisoes));

    Graficos.renderizar();
}

funcao inicio() {
    Graficos.iniciar_modo_grafico(verdadeiro);
    Graficos.definir_dimensoes_janela(800, 600);
    Graficos.definir_titulo_janela("Colisao: Circulo e Retangulo - Portugol-RS");

    seja mutavel cena: CenaCirculoRetangulo = CenaCirculoRetangulo {
        cx: 200,
        cy: 310,
        raio: 58,
        rx: 460,
        ry: 240,
        rl: 150,
        ra: 120,
        pontos_guia: 8,
        exibir_guias: verdadeiro,
        tratar_colisoes: falso,
        tecla_g_estava: falso,
        tecla_c_estava: falso,
    }
    ;

    enquanto (!Teclado.tecla_pressionada(Teclado.TECLA_ESC)) {
        cena = atualizar(cena);
        desenhar(cena);
        Util.aguarde(16);
    }

    Graficos.encerrar_modo_grafico();
}
