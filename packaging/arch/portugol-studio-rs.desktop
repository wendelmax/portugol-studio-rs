[Desktop Entry]
Name=Ferro Studio
Comment=Ferro Studio — Programe em português, crie apps e jogos e evolua para Rust
Exec=/usr/bin/portugol-desktop %F
Icon=portugol-studio-rs
Terminal=false
Type=Application
Categories=Development;Education;IDE;
