 * Adaptado para Portugol-RS (.pors)
 *
 * Este arquivo de código fonte é livre para utilização, cópia e/ou modificação
 * desde que este cabeçalho, contendo os direitos autorais e a descrição do programa,
 * seja mantido.
 *
 * Descrição:
 *
 *     Este exemplo ilustra como representar uma matriz bidimensional no Portugol-RS
 *     usando um vetor linear (vetor<caracter>) e preenchendo sua diagonal principal.
 *
 *     No Portugol-RS, uma matriz de L linhas por C colunas é armazenada em um vetor
 *     de tamanho L * C, onde o elemento na posição (linha, coluna) fica no índice
 *     `linha * colunas + coluna`.
 *
 *     Na matemática, a diagonal principal de uma matriz é o conjunto dos elementos em que
 *     a linha e a coluna do elemento são iguais:
 *
 *       [*][ ][ ][ ]
 *       [ ][*][ ][ ]
 *       [ ][ ][*][ ]
 *       [ ][ ][ ][*]
 *
 * Autores:
 *
 *     Giordana Maria da Costa Valle
 *     Carlos Alexandre Krueger
 *
 * Data: 01/06/2013
 */

// Converte coordenadas (linha, coluna) para o índice no vetor linear
funcao indice_matriz(linha: inteiro, coluna: inteiro, colunas: inteiro) -> inteiro {
    retorne linha * colunas + coluna;
}

// Cria e preenche a diagonal principal da matriz quadrada
funcao preencher_diagonal(lado: inteiro) -> vetor < caracter > {
    seja mutavel matriz: vetor < caracter > = [];

    para (seja mutavel linha: inteiro = 0; linha < lado; linha += 1) {
        para (seja mutavel coluna: inteiro = 0; coluna < lado; coluna += 1) {
            se (linha == coluna) {
                adicionar(matriz, '*');
            } senao {
                adicionar(matriz, ' ');
            }
        }
    }

    retorne matriz;
}

// Percorre e exibe a matriz
funcao exibir_matriz(matriz: vetor < caracter >, linhas: inteiro, colunas: inteiro) {
    para (seja mutavel linha: inteiro = 0; linha < linhas; linha += 1) {
        para (seja mutavel coluna: inteiro = 0; coluna < colunas; coluna += 1) {
            seja idx: inteiro = indice_matriz(linha, coluna, colunas);
            escreva("[", matriz[idx], "]");
        }
        escreva("\n");
    }
}

funcao inicio() {
    // Define as dimensões (linhas e colunas) da matriz quadrada
    seja TAMANHO: inteiro = 5;

    seja matriz: vetor < caracter > = preencher_diagonal(TAMANHO);
    exibir_matriz(matriz, TAMANHO, TAMANHO);
}
