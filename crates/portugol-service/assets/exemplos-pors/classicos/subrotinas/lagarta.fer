funcao branco(quantidade: inteiro) {
    seja mutavel brancos: inteiro = 1;

    enquanto (brancos <= quantidade) {
        escreva(" ");
        brancos += 1;
    }
}

funcao desenhar_lagarta(coluna: inteiro, andando: inteiro) {
    se (andando == 0) {
        branco((coluna * 3) + 14);
        escreval("\\ /");
        branco(coluna * 3);
        escreva("( )( )( )( )( 0.0 )");
    } senao {
        branco((coluna * 3) + 7);
        escreva("( )");
        branco(4);
        escreval("\\ /");
        branco((coluna * 3) + 2);
        escreva("( )( ) ( )( 0.0 )");
    }

    escreval();
}

funcao animar(coluna_inicial: inteiro, passos: inteiro) {
    seja coluna_final: inteiro = coluna_inicial + passos;

    para (seja mutavel coluna: inteiro = coluna_inicial; coluna < coluna_final; coluna += 1) {
        para (seja mutavel andando = 0; andando <= 1; andando += 1) {
            escreval();
            desenhar_lagarta(coluna, andando);
            Util.aguarde(250);
        }
    }

    escreval();
    desenhar_lagarta(coluna_final, 0);
}

funcao inicio() {
    seja coluna_inicial = 0;
    seja passos: inteiro = 10;

    animar(coluna_inicial, passos);
}
