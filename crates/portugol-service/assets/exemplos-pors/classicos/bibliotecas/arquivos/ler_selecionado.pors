 * seja mantido.
 *
 * Descrição:
 *
 * 	Este exemplo lista os arquivos disponíveis no workspace para que o usuário
 * 	escolha qual arquivo ler. Caso informe um arquivo válido, o programa lê e exibe
 * 	todas as suas linhas; caso contrário, informa que nenhum arquivo foi selecionado.
 *
 * Autores:
 *
 * 	Luiz Fernando Noschang (noschang@univali.br)
 *
 * Data: 10/02/2016
 * Adaptado para Portugol-RS (.pors)
 */

funcao listar_workspace() -> Resultado < vetor < cadeia >, cadeia > {
    seja entradas: vetor < cadeia > = Arquivos.listar(".")?;
    retorne Resultado::Ok(entradas);
}

funcao ler_arquivo_escolhido(caminho: cadeia) -> Resultado < vetor < cadeia >, cadeia > {
    seja encontrado: logico = Arquivos.existe(caminho)?;
    se (!encontrado) {
        retorne Resultado::Erro("Arquivo não encontrado no workspace: " + caminho);
    }
    retorne Arquivos.ler_linhas(caminho);
}

funcao inicio() {
    escolha listar_workspace() {
        caso Resultado::Ok(entradas) => {
            escreva("Arquivos disponíveis no workspace:\n");
            para (seja mutavel i: inteiro = 0; i < tamanho(entradas); i += 1) {
                escreva(" - ", entradas[i], "\n");
            }

            seja mutavel arquivo_selecionado: cadeia = "";
            escreva("\nDigite o nome do arquivo para ler (ou deixe vazio para cancelar): ");
            leia(arquivo_selecionado);
            arquivo_selecionado = Texto.aparar(arquivo_selecionado);

            se (arquivo_selecionado != "") {
                escolha ler_arquivo_escolhido(arquivo_selecionado) {
                    caso Resultado::Ok(linhas) => {
                        escreva("\n");
                        para (seja mutavel i: inteiro = 0; i < tamanho(linhas); i += 1) {
                            escreva("Linha ", i + 1, ": ", linhas[i], "\n");
                        }
                    }
                    caso Resultado::Erro(erro) => {
                        escreva("Erro: ", erro, "\n");
                    }
                }
            } senao {
                escreva("O usuário não selecionou nenhum arquivo\n");
            }
        }
        caso Resultado::Erro(erro) => {
            escreva("Erro ao listar workspace: ", erro, "\n");
        }
    }
}
