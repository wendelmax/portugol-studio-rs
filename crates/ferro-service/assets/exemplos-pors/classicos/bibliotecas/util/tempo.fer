funcao inicio() {
    seja tempo_inicial: inteiro = Util.tempo_decorrido();
    seja mutavel tempo_atual: inteiro = tempo_inicial;
    seja mutavel tempo_total = 0;

    seja mutavel mensagem1: logico = falso;
    seja mutavel mensagem2: logico = falso;
    seja mutavel mensagem3: logico = falso;

    faca {
        // Atualiza o instante atual em milissegundos e calcula o tempo decorrido
        tempo_atual = Util.tempo_decorrido();
        tempo_total = tempo_atual - tempo_inicial;

        se (tempo_total >= 1000 && !mensagem1) {
            escreval("Primeira mensagem");
            mensagem1 = verdadeiro;
        } senao se (tempo_total >= 5000 && !mensagem2) {
            escreval("Segunda mensagem");
            mensagem2 = verdadeiro;
        } senao se (tempo_total >= 7000 && !mensagem3) {
            escreval("Terceira mensagem");
            mensagem3 = verdadeiro;
        }
    } enquanto (tempo_total < 10000); // Finaliza o programa após 10 segundos

    escreval("\nTempo Inicial: ", tempo_inicial);
    escreval("Tempo Atual: ", tempo_atual);
    escreval("Tempo Total: ", tempo_total);
}
