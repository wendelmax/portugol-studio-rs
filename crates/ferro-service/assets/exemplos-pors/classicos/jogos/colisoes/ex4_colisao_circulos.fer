 * desde que este cabeçalho, contendo os direitos autorais e a descrição do programa,
 * seja mantido.
 *
 * Descrição:
 *
 *   Este exemplo demonstra como é detectada a colisão entre dois círculos
 *   comparando a distância entre seus centros com a soma de seus raios.
 *
 *   Controles:
 *     - Setas: movem o círculo A
 *     - W, A, S, D: movem o círculo B
 *     - G: exibe/oculta as guias de distância entre centros e soma dos raios
 *     - C: ativa/desativa o bloqueio de colisões
 *     - ESC: encerra o programa
 *
 * Autor (versão original):
 *
 *   Luiz Fernando Noschang (noschang@univali.br)
 *
 * Data original: 26/06/2017
 * Adaptado para Ferro (.pors)
 */

registro Circulo {
    cx: inteiro,
    cy: inteiro,
    raio: inteiro,
}

registro CenaCirculos {
    a: Circulo,
    b: Circulo,
    exibir_guias: logico,
    tratar_colisoes: logico,
    tecla_g_estava: logico,
    tecla_c_estava: logico,
}

funcao cor_rgb(r: inteiro, g: inteiro, b: inteiro) -> inteiro {
    escolha Graficos.criar_cor(r, g, b) {
        caso Resultado::Ok(cor) => {
            retorne cor;
        }
        caso Resultado::Erro(_) => {
            retorne Graficos.COR_BRANCO;
        }
    }
}

funcao distancia_centros(a: Circulo, b: Circulo) -> real {
    seja dx: real = Tipos.inteiro_para_real(b.cx - a.cx);
    seja dy: real = Tipos.inteiro_para_real(b.cy - a.cy);
    retorne Matematica.raiz_quadrada(dx * dx + dy * dy);
}

funcao ocorreu_colisao(a: Circulo, b: Circulo) -> logico {
    retorne distancia_centros(a, b) < Tipos.inteiro_para_real(a.raio + b.raio);
}

funcao limitar(valor: inteiro, minimo: inteiro, maximo: inteiro) -> inteiro {
    se (valor < minimo) {
        retorne minimo;
    }
    se (valor > maximo) {
        retorne maximo;
    }
    retorne valor;
}

funcao atualizar(cena: CenaCirculos) -> CenaCirculos {
    seja mutavel nova: CenaCirculos = cena;
    seja mutavel a: Circulo = nova.a;
    seja mutavel b: Circulo = nova.b;
    seja passo: inteiro = 3;

    seja g_p: logico = Teclado.tecla_pressionada(Teclado.TECLA_G);
    se (g_p && !nova.tecla_g_estava) {
        nova.exibir_guias = !nova.exibir_guias;
    }
    nova.tecla_g_estava = g_p;

    seja c_p: logico = Teclado.tecla_pressionada(Teclado.TECLA_C);
    se (c_p && !nova.tecla_c_estava) {
        nova.tratar_colisoes = !nova.tratar_colisoes;
        se (nova.tratar_colisoes && ocorreu_colisao(a, b)) {
            a.cx = 210;
            a.cy = 310;
            b.cx = 560;
            b.cy = 310;
        }
    }
    nova.tecla_c_estava = c_p;

    // Círculo A (Setas)
    seja ax_ant: inteiro = a.cx;
    seja ay_ant: inteiro = a.cy;
    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_ESQUERDA)) {
        a.cx = limitar(a.cx - passo, 16 + a.raio, 784 - a.raio);
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_DIREITA)) {
        a.cx = limitar(a.cx + passo, 16 + a.raio, 784 - a.raio);
    }
    se (nova.tratar_colisoes && ocorreu_colisao(a, b)) {
        a.cx = ax_ant;
    }

    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_ACIMA)) {
        a.cy = limitar(a.cy - passo, 84 + a.raio, 560 - a.raio);
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_ABAIXO)) {
        a.cy = limitar(a.cy + passo, 84 + a.raio, 560 - a.raio);
    }
    se (nova.tratar_colisoes && ocorreu_colisao(a, b)) {
        a.cy = ay_ant;
    }

    // Círculo B (WASD)
    seja bx_ant: inteiro = b.cx;
    seja by_ant: inteiro = b.cy;
    se (Teclado.tecla_pressionada(Teclado.TECLA_A)) {
        b.cx = limitar(b.cx - passo, 16 + b.raio, 784 - b.raio);
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_D)) {
        b.cx = limitar(b.cx + passo, 16 + b.raio, 784 - b.raio);
    }
    se (nova.tratar_colisoes && ocorreu_colisao(a, b)) {
        b.cx = bx_ant;
    }

    se (Teclado.tecla_pressionada(Teclado.TECLA_W)) {
        b.cy = limitar(b.cy - passo, 84 + b.raio, 560 - b.raio);
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_S)) {
        b.cy = limitar(b.cy + passo, 84 + b.raio, 560 - b.raio);
    }
    se (nova.tratar_colisoes && ocorreu_colisao(a, b)) {
        b.cy = by_ant;
    }

    nova.a = a;
    nova.b = b;
    retorne nova;
}

funcao desenhar(cena: CenaCirculos) {
    seja colidiu: logico = ocorreu_colisao(cena.a, cena.b);
    seja dist: inteiro = Tipos.real_para_inteiro(distancia_centros(cena.a, cena.b));
    seja soma_raios: inteiro = cena.a.raio + cena.b.raio;

    Graficos.definir_cor(cor_rgb(245, 247, 250));
    Graficos.limpar();

    // Cabeçalho
    Graficos.definir_cor(cor_rgb(30, 38, 52));
    Graficos.desenhar_retangulo(0, 0, 800, 76, falso, verdadeiro);
    Graficos.definir_cor(Graficos.COR_BRANCO);
    Graficos.definir_tamanho_texto(18.0);
    Graficos.desenhar_texto(18, 12, "Colisao 4: Circulo x Circulo");
    Graficos.definir_tamanho_texto(12.0);
    Graficos.definir_cor(cor_rgb(200, 210, 225));
    Graficos.desenhar_texto(18, 40, "[Setas] Mover Circulo A  |  [WASD] Mover Circulo B  |  [G] Guias  |  [C] Tratar Colisao  |  [ESC] Sair");

    se (colidiu) {
        Graficos.definir_cor(cor_rgb(255, 100, 100));
        Graficos.definir_tamanho_texto(14.0);
        Graficos.desenhar_texto(560, 14, "COLISAO DETECTADA!");
    } senao {
        Graficos.definir_cor(cor_rgb(120, 230, 150));
        Graficos.definir_tamanho_texto(14.0);
        Graficos.desenhar_texto(560, 14, "Sem colisao");
    }

    // Círculo A
    se (colidiu) {
        Graficos.definir_cor(cor_rgb(102, 255, 153));
    } senao {
        Graficos.definir_cor(cor_rgb(102, 204, 255));
    }
    Graficos.desenhar_elipse(cena.a.cx - cena.a.raio, cena.a.cy - cena.a.raio, cena.a.raio * 2, cena.a.raio * 2, verdadeiro);
    Graficos.definir_cor(cor_rgb(30, 60, 90));
    Graficos.desenhar_elipse(cena.a.cx - cena.a.raio, cena.a.cy - cena.a.raio, cena.a.raio * 2, cena.a.raio * 2, falso);
    Graficos.definir_tamanho_texto(15.0);
    Graficos.desenhar_texto(cena.a.cx - 6, cena.a.cy - 22, "A");

    // Círculo B
    se (colidiu) {
        Graficos.definir_cor(cor_rgb(255, 153, 102));
    } senao {
        Graficos.definir_cor(cor_rgb(255, 240, 110));
    }
    Graficos.desenhar_elipse(cena.b.cx - cena.b.raio, cena.b.cy - cena.b.raio, cena.b.raio * 2, cena.b.raio * 2, verdadeiro);
    Graficos.definir_cor(cor_rgb(100, 75, 20));
    Graficos.desenhar_elipse(cena.b.cx - cena.b.raio, cena.b.cy - cena.b.raio, cena.b.raio * 2, cena.b.raio * 2, falso);
    Graficos.desenhar_texto(cena.b.cx - 6, cena.b.cy - 22, "B");

    // Guias de distância e Pitágoras
    se (cena.exibir_guias) {
        Graficos.definir_cor(cor_rgb(153, 0, 153));
        Graficos.desenhar_linha(cena.a.cx, cena.a.cy, cena.b.cx, cena.a.cy);
        Graficos.desenhar_linha(cena.b.cx, cena.a.cy, cena.b.cx, cena.b.cy);

        Graficos.definir_cor(Graficos.COR_PRETO);
        Graficos.desenhar_linha(cena.a.cx, cena.a.cy, cena.b.cx, cena.b.cy);
        Graficos.desenhar_elipse(cena.a.cx - 3, cena.a.cy - 3, 6, 6, verdadeiro);
        Graficos.desenhar_elipse(cena.b.cx - 3, cena.b.cy - 3, 6, 6, verdadeiro);

        Graficos.definir_tamanho_texto(12.0);
        Graficos.desenhar_texto((cena.a.cx + cena.b.cx) / 2 - 20, (cena.a.cy + cena.b.cy) / 2 + 8, "dc=" + Tipos.inteiro_para_cadeia(dist));
    }

    // Rodapé pedagógico
    Graficos.definir_cor(cor_rgb(40, 45, 55));
    Graficos.definir_tamanho_texto(12.0);
    Graficos.desenhar_texto(18, 574, "Distancia centros: " + Tipos.inteiro_para_cadeia(dist) + " px  |  Soma raios (rA+rB): " + Tipos.inteiro_para_cadeia(soma_raios) + " px  |  Tratar: " + Tipos.logico_para_cadeia(cena.tratar_colisoes));

    Graficos.renderizar();
}

funcao inicio() {
    Graficos.iniciar_modo_grafico(verdadeiro);
    Graficos.definir_dimensoes_janela(800, 600);
    Graficos.definir_titulo_janela("Colisao: Dois Circulos - Ferro");

    seja mutavel cena: CenaCirculos = CenaCirculos {
        a: Circulo {
            cx: 210, cy: 310, raio: 55
        }
        ,
        b: Circulo {
            cx: 560, cy: 290, raio: 75
        }
        ,
        exibir_guias: verdadeiro,
        tratar_colisoes: falso,
        tecla_g_estava: falso,
        tecla_c_estava: falso,
    }
    ;

    enquanto (!Teclado.tecla_pressionada(Teclado.TECLA_ESC)) {
        cena = atualizar(cena);
        desenhar(cena);
        Util.aguarde(16);
    }

    Graficos.encerrar_modo_grafico();
}
