 * desde que este cabeçalho, contendo os direitos autorais e a descrição do programa,
 * seja mantido.
 *
 * Descrição:
 *
 *     Este exemplo pede ao usuário que informe um valor de 0 a 6. Logo após, o programa
 *     sorteia um valor também de 0 a 6 e exibe uma mensagem informando se o número sorteado
 *     e o número digitado são iguais.
 *
 * Autores:
 *
 *     Giordana Maria da Costa Valle
 *     Carlos Alexandre Krueger
 *
 * Data: 01/06/2013
 */

funcao inicio() {
    escreva("Informe um número de 0 a 6: ");
    seja mutavel num_digitado: inteiro = leia();

    escolha Util.sorteia(0, 6) {
        caso Resultado::Ok(num_sorteado) => {
            se (num_digitado >= 0 && num_digitado <= 6) {
                // Verifica se o valor sorteado é igual ao valor digitado pelo usuário
                se (num_digitado == num_sorteado) {
                    escreva("Os números são iguais!");
                } senao {
                    escreva("Os números são diferentes!");
                }

                escreva("\n\nNúmero digitado: ", num_digitado);
                escreval("\nNúmero sorteado: ", num_sorteado);
            } senao {
                escreval("O número digitado deve estar entre 0 e 6");
            }
        }
        caso Resultado::Erro(erro) => {
            escreval("Erro ao sortear número: ", erro);
        }
    }
}
