 * seja mantido.
 *
 * Descrição:
 *
 *   Este exemplo demonstra o controle de reprodução de áudio com a biblioteca
 *   Sons: iniciar, pausar, reposicionar o tempo da música e interromper a
 *   reprodução com liberação segura de memória.
 *
 * Autores:
 *
 *   Luiz Fernando Noschang (noschang@univali.br)
 *   Adaptado e implementado para Portugol-RS (.pors)
 *
 * Data: 18/07/2014
 */

funcao inicio() {
    seja caminho: cadeia = "audio/musica.mp3";

    escreva("=== Biblioteca Sons: Pausar, Reposicionar e Interromper ===\n");
    escreva("Carregando: ", caminho, "\n");

    escolha Sons.carregar_som(caminho) {
        caso Resultado::Ok(som) => {
            escolha Sons.reproduzir_som(som, verdadeiro) {
                caso Resultado::Ok(reproducao) => {
                    escreva("1) Reproduzindo música em repetição contínua...\n");
                    Util.aguarde(1000);

                    escreva(
                    "2) Pausando na posição ",
                    Sons.obter_posicao_atual_musica(reproducao),
                    " ms...\n"
                    );
                    Sons.pausar_som(reproducao);
                    Util.aguarde(500);

                    escreva("3) Reposicionando para o início (0 ms)...\n");
                    escolha Sons.definir_posicao_atual_musica(reproducao, 0) {
                        caso Resultado::Ok(_) => {
                            escreva("   Posição redefinida com sucesso.\n");
                        }
                        caso Resultado::Erro(erro_pos) => {
                            escreva("   Não foi possível reposicionar: ", erro_pos, "\n");
                        }
                    }

                    escreva("4) Interrompendo reprodução...\n");
                    Sons.interromper_som(reproducao);
                    escreva("Reprodução interrompida com sucesso.\n");
                }
                caso Resultado::Erro(erro_rep) => {
                    escreva("Erro ao iniciar reprodução: ", erro_rep, "\n");
                }
            }

            Sons.liberar_som(som);
            escreva("Som liberado.\n");
        }
        caso Resultado::Erro(erro) => {
            escreva("Não foi possível carregar '", caminho, "': ", erro, "\n");
            escreva("Coloque um arquivo de áudio nesse caminho para testar o controle completo.\n");
        }
    }
}
