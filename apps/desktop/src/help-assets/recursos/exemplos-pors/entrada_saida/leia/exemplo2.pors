funcao inicio() {
    seja mutavel idade: inteiro = 0;
    seja mutavel salario: real = 0.0;
    seja mutavel nota1: real = 0.0;
    seja mutavel nota2: real = 0.0;
    seja mutavel nota3: real = 0.0;
    seja mutavel nome: cadeia = "";
    seja mutavel sobrenome: cadeia = "";

    escreva("Informe a sua idade: ");
    leia(idade);

    escreva("Informe seu salário: ");
    leia(salario);

    escreva("Informe o seu nome: ");
    leia(nome);

    escreva("Informe o seu sobrenome: ");
    leia(sobrenome);

    escreva("Informe as suas três notas (uma por linha):\n");
    leia(nota1);
    leia(nota2);
    leia(nota3);

    escreva("Seu nome é: ", nome, " ", sobrenome, "\n");
    escreva("Você tem ", idade, " anos e ganha de salário ", salario, "\n");
    escreva("Suas três notas foram:\n");
    escreva("Nota 1: ", nota1, "\n");
    escreva("Nota 2: ", nota2, "\n");
    escreva("Nota 3: ", nota3, "\n");
}
