funcao inicio() {
    seja texto: cadeia = "4.78";

    // Usa "cadeia_e_real" para verificar se a cadeia representa um número real
    se (Tipos.cadeia_e_real(texto)) {
        // Converte a cadeia em número real usando "para_real"
        escolha Tipos.para_real(texto) {
            caso Resultado::Ok(valor_inicial) => {
                seja mutavel num_real: real = valor_inicial * 2.0;
                escreval("Valor convertido em real: ", num_real);

                // Algumas operações, como o resto (%), só podem ser feitas entre inteiros.
                // Ao converter real para inteiro, a parte fracionária é truncada.
                seja num_inteiro: inteiro = Tipos.real_para_inteiro(num_real);
                escreval("Valor convertido em inteiro: ", num_inteiro);

                // Por último, transforma novamente o valor real em uma cadeia
                num_real = num_real + 5.0;
                seja texto_final: cadeia = Tipos.real_para_cadeia(num_real);
                escreval("Valor convertido em cadeia: ", texto_final);
            }
            caso Resultado::Erro(erro) => {
                escreval("Erro ao converter para real: ", erro);
            }
        }
    }
}
