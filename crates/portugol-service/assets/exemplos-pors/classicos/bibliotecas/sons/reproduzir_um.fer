 * desde que este cabeçalho, contendo os direitos autorais e a descrição do programa,
 * seja mantido.
 *
 * Descrição:
 *
 *   Este exemplo demonstra como carregar e reproduzir um único arquivo de áudio
 *   usando a biblioteca Sons, ajustando o volume global e consultando duração
 *   e posição atual da reprodução.
 *
 * Autores:
 *
 *   Luiz Fernando Noschang (noschang@univali.br)
 *   Adaptado e implementado para Portugol-RS (.pors)
 *
 * Data: 18/07/2014
 */

funcao inicio() {
    seja caminho_som: cadeia = "audio/exemplo.mp3";

    escreval("=== Biblioteca Sons: Reproduzir Um Som ===");
    escreval("Tentando carregar o arquivo: ", caminho_som);

    escolha Sons.carregar_som(caminho_som) {
        caso Resultado::Ok(som) => {
            Sons.definir_volume(80);
            escreval("Volume global configurado para: ", Sons.obter_volume(), "%");

            escolha Sons.reproduzir_som(som, falso) {
                caso Resultado::Ok(reproducao) => {
                    seja duracao: inteiro = Sons.obter_tamanho_musica(som);
                    escreval("Reprodução iniciada (ID: ", reproducao, ").");
                    escreval("Duração total estimada: ", duracao, " ms");

                    Util.aguarde(1500);
                    seja posicao: inteiro = Sons.obter_posicao_atual_musica(reproducao);
                    escreval("Posição atual após 1,5s: ", posicao, " ms");

                    Sons.interromper_som(reproducao);
                    escreval("Reprodução finalizada.");
                }
                caso Resultado::Erro(erro_rep) => {
                    escreval("Não foi possível reproduzir o som: ", erro_rep);
                }
            }

            Sons.liberar_som(som);
            escreval("Recurso de áudio liberado da memória.");
        }
        caso Resultado::Erro(erro) => {
            escreval("Arquivo de áudio não encontrado ou indisponível: ", erro);
            escreval(
            "Dica: coloque um arquivo MP3/WAV em '",
            caminho_som,
            "' para ouvir a reprodução."
            );
        }
    }
}
