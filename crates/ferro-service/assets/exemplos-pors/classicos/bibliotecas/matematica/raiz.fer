 * Descrição:
 *
 * 	Este exemplo demonstra como obter a raiz de um número usando a função "raiz" da
 * 	biblioteca "Matematica".
 *
 * Autores:
 *
 * 	Luiz Fernando Noschang (noschang@univali.br)
 *
 * Data: 18/07/2014
 * Adaptado para Ferro (.pors)
 */

funcao inicio() {
    seja mutavel numero: real = 4.0;
    seja mutavel resultado: real = Matematica.raiz(numero, 2.0); // Obtém a raiz quadrada do número

    escreval("A raiz quadrada de ", numero, " é: ", resultado);

    numero = 27.0;
    resultado = Matematica.raiz(numero, 3.0); // Obtém a raiz cúbica do número

    escreval("A raiz cúbica de ", numero, " é: ", resultado);
}
