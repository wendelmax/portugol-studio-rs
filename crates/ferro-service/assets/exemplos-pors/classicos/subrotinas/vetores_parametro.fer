 * seja mantido.
 *
 * Descrição:
 *
 *     Este exemplo ilustra a passagem e o retorno de vetores em funções no Ferro.
 *
 *     No Ferro, vetores são passados por valor. Por isso, funções que criam ou
 *     modificam um vetor (como preencher, ordenar e trocar) retornam o vetor atualizado
 *     de forma explícita.
 *
 * Autores:
 *
 *     Giordana Maria da Costa Valle
 *     Carlos Alexandre Krueger
 *
 * Data: 01/06/2013
 */

funcao sortear(minimo: inteiro, maximo: inteiro) -> inteiro {
    escolha Util.sorteia(minimo, maximo) {
        caso Resultado::Ok(valor) => {
            retorne valor;
        }
        caso Resultado::Erro(_) => {
            retorne minimo;
        }
    }
}

// Cria e preenche um vetor com números aleatórios
funcao preencher(quantidade: inteiro) -> vetor < inteiro > {
    seja mutavel v: vetor < inteiro > = [];

    para (seja mutavel i = 0; i < quantidade; i += 1) {
        adicionar(v, sortear(1, 100));
    }

    retorne v;
}

funcao exibir(v: vetor < inteiro >) {
    para (seja mutavel i = 0; i < tamanho(v); i += 1) {
        escreva(v[i], " ");
    }
}

funcao trocar(mutavel v: vetor < inteiro >, a: inteiro, b: inteiro) -> vetor < inteiro > {
    seja c: inteiro = v[a];
    v[a] = v[b];
    v[b] = c;
    retorne v;
}

// Ordena o vetor em ordem crescente e retorna o vetor ordenado
funcao ordenar(mutavel v: vetor < inteiro >) -> vetor < inteiro > {
    seja n: inteiro = tamanho(v);

    para (seja mutavel i = 0; i < n; i += 1) {
        para (seja mutavel j = 0; j < n - 1; j += 1) {
            se (v[j] > v[j + 1]) {
                v = trocar(v, j, j + 1);
            }
        }
    }

    retorne v;
}

funcao inicio() {
    seja mutavel vet: vetor < inteiro > = preencher(10);

    escreval("Vetor antes da ordenação:");
    exibir(vet);

    vet = ordenar(vet);

    escreval("\n\nVetor após a ordenação:");
    exibir(vet);

    escreval();
}
