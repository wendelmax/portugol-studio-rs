 * desde que este cabeçalho, contendo os direitos autorais e a descrição do programa,
 * seja mantido.
 *
 * Descrição:
 *
 * 	Este exemplo demonstra como representar e percorrer dinamicamente uma matriz
 * 	em Ferro usando um registro com dimensões explícitas e um vetor linear
 * 	(acessado pelo índice linha * colunas + coluna).
 *
 * Autores:
 *
 * 	Luiz Fernando Noschang (noschang@univali.br)
 *
 * Data: 18/07/2014
 * Adaptado para Ferro (.fer)
 */

registro MatrizInteiro {
    linhas: inteiro,
    colunas: inteiro,
    dados: vetor < inteiro >,
}

funcao inicio() {
    // Cria uma matriz com 3 linhas e 4 colunas armazenada em um vetor linear
    seja mat: MatrizInteiro = MatrizInteiro {
        linhas: 3,
        colunas: 4,
        dados: [
        4, 2, 9, 3,
        8, 6, 5, 4,
        9, 0, 1, 3
        ],
    }
    ;

    /*
     * Experimente substituir a matriz acima por uma matriz 4x2:
     * MatrizInteiro { linhas: 4, colunas: 2, dados: [4, 2, 8, 6, 9, 0, 2, 7] }
     */

    seja dados: vetor < inteiro > = mat.dados;

    escreval("A matriz possui ", mat.linhas, " linhas");
    escreval("A matriz possui ", mat.colunas, " colunas");
    escreval("Total de elementos: ", tamanho(dados), "\n");

    // Percorre todas as linhas e colunas usando o índice (linha * colunas + coluna)
    para (seja mutavel linha = 0; linha < mat.linhas; linha += 1) {
        para (seja mutavel coluna = 0; coluna < mat.colunas; coluna += 1) {
            seja indice: inteiro = linha * mat.colunas + coluna;
            escreva("[", dados[indice], "]");
        }
        escreval();
    }
}
