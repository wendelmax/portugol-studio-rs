# Maintainer: Ferro Studio Contributors <https://github.com/wendelmax/portugol-studio-rs>
pkgname=portugol-studio-rs
pkgver=0.7.0
pkgrel=1
pkgdesc="Ferro Studio — IDE educacional em português com ponte para Rust"
arch=('x86_64' 'aarch64')
url="https://github.com/wendelmax/portugol-studio-rs"
license=('LGPL-3.0-only')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'alsa-lib'
  'hicolor-icon-theme'
  'cairo'
  'gdk-pixbuf2'
  'glib2'
  'libsoup3'
)
optdepends=(
  'rust: compilar e executar arquivos .rs e projetos Cargo'
  'cargo: executar e testar projetos Cargo'
)
makedepends=(
  'rust'
  'cargo'
  'nodejs'
  'npm'
  'pkgconf'
  'webkit2gtk-4.1'
  'gtk3'
  'alsa-lib'
)
options=('!lto' '!debug')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
  cd "${pkgname}-${pkgver}"
  npm --prefix apps/desktop ci
  npm --prefix apps/desktop run build
  export CARGO_TARGET_DIR="${srcdir}/${pkgname}-${pkgver}/target"
  cargo build --release --locked -p portugol-desktop --features tauri/custom-protocol
}

package() {
  cd "${pkgname}-${pkgver}"

  install -Dm755 "target/release/portugol-desktop" "${pkgdir}/usr/bin/portugol-desktop"
  ln -s portugol-desktop "${pkgdir}/usr/bin/portugol-studio-rs"

  install -Dm644 "packaging/arch/portugol-studio-rs.desktop" \
    "${pkgdir}/usr/share/applications/portugol-studio-rs.desktop"
  install -Dm644 "packaging/arch/portugol-studio-rs.xml" \
    "${pkgdir}/usr/share/mime/packages/portugol-studio-rs.xml"

  install -Dm644 "apps/desktop/src-tauri/icons/32x32.png" \
    "${pkgdir}/usr/share/icons/hicolor/32x32/apps/portugol-studio-rs.png"
  install -Dm644 "apps/desktop/src-tauri/icons/64x64.png" \
    "${pkgdir}/usr/share/icons/hicolor/64x64/apps/portugol-studio-rs.png"
  install -Dm644 "apps/desktop/src-tauri/icons/128x128.png" \
    "${pkgdir}/usr/share/icons/hicolor/128x128/apps/portugol-studio-rs.png"
  install -Dm644 "apps/desktop/src-tauri/icons/128x128@2x.png" \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/portugol-studio-rs.png"
  install -Dm644 "apps/desktop/src-tauri/icons/icon.png" \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/portugol-studio-rs.png"
  install -Dm644 "apps/desktop/src-tauri/icons/icon.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/portugol-studio-rs.svg"

  install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
