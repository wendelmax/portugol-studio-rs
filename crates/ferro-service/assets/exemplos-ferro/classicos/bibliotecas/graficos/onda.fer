registro TabelaOnda {
    coordenadas_x: vetor < inteiro >,
    coordenadas_y: vetor < inteiro >
}

funcao cor_rgb(r: inteiro, g: inteiro, b: inteiro) -> inteiro {
    escolha Graficos.criar_cor(r, g, b) {
        caso Resultado::Ok(cor) => {
            retorne cor;
        }
        caso Resultado::Erro(_) => {
            retorne Graficos.COR_PRETO;
        }
    }
}

funcao calcular_coordenadas(raio_movimento: inteiro) -> TabelaOnda {
    seja mutavel xs: vetor < inteiro > = [];
    seja mutavel ys: vetor < inteiro > = [];
    seja mutavel angulo: real = 0.0;
    seja incremento_angulo: real = (Matematica.PI * 2.0) / 360.0;
    seja raio_real: real = Tipos.inteiro_para_real(raio_movimento);

    para (seja mutavel i = 0; i < 360; i += 1) {
        seja x: real = Matematica.arredondar(Matematica.cosseno(angulo) * raio_real, 0);
        seja y: real = Matematica.arredondar(Matematica.seno(angulo) * raio_real, 0);

        adicionar(xs, Tipos.real_para_inteiro(x));
        adicionar(ys, Tipos.real_para_inteiro(y));

        angulo += incremento_angulo;
    }

    retorne TabelaOnda {
        coordenadas_x: xs,
        coordenadas_y: ys
    }
    ;
}

funcao desenhar_particula(
centro_x: inteiro,
centro_y: inteiro,
iteracao_atual: inteiro,
raio_particula: inteiro,
tabela: TabelaOnda
) {
    seja xs: vetor < inteiro > = tabela.coordenadas_x;
    seja ys: vetor < inteiro > = tabela.coordenadas_y;
    seja x: inteiro = centro_x + xs[iteracao_atual] - raio_particula;
    seja y: inteiro = centro_y + ys[iteracao_atual] - raio_particula;

    Graficos.desenhar_retangulo(x, y, raio_particula, raio_particula, falso, verdadeiro);
}

funcao desenhar_ondas(
iteracao: inteiro,
particulas_horizontal: inteiro,
particulas_vertical: inteiro,
raio_movimento: inteiro,
raio_particula: inteiro,
cor_particula: inteiro,
tabela: TabelaOnda
) {
    seja mutavel it: inteiro = iteracao;
    Graficos.definir_cor(cor_particula);

    para (seja mutavel i: inteiro = -1; i <= particulas_horizontal; i += 1) {
        para (seja mutavel j: inteiro = -1; j <= particulas_vertical; j += 1) {
            desenhar_particula(
            i * raio_movimento,
            j * raio_movimento,
            it,
            raio_particula,
            tabela
            );
            it = (it + 1) % 360;
        }
    }
}

funcao inicio() {
    seja largura_janela: inteiro = 350;
    seja altura_janela: inteiro = 350;
    seja raio_movimento: inteiro = 20;
    seja tamanho_particula: inteiro = 4;
    seja raio_particula: inteiro = tamanho_particula / 2;

    seja particulas_horizontal: inteiro = (largura_janela / raio_movimento) + 2;
    seja particulas_vertical: inteiro = (altura_janela / raio_movimento) + 2;

    seja cor_fundo: inteiro = cor_rgb(210, 210, 255);
    seja cor_particula: inteiro = Graficos.COR_PRETO;
    seja tabela: TabelaOnda = calcular_coordenadas(raio_movimento);

    Graficos.iniciar_modo_grafico(verdadeiro);
    Graficos.definir_dimensoes_janela(largura_janela, altura_janela);
    Graficos.definir_titulo_janela("Onda");

    seja mutavel iteracao = 0;

    enquanto (!Teclado.tecla_pressionada(Teclado.TECLA_ESC)) {
        Graficos.definir_cor(cor_fundo);
        Graficos.limpar();

        desenhar_ondas(
        iteracao,
        particulas_horizontal,
        particulas_vertical,
        raio_movimento,
        raio_particula,
        cor_particula,
        tabela
        );

        Graficos.renderizar();

        iteracao = (iteracao + 1) % 360;
        Util.aguarde(15);
    }

    Graficos.encerrar_modo_grafico();
}
