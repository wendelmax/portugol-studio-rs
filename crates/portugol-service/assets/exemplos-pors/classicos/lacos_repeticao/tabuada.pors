 * desde que este cabeçalho, contendo os direitos autorais e a descrição do programa,
 * seja mantido.
 *
 * Descrição:
 *
 *     Este exemplo pede ao usuário que informe um número inteiro. Logo após, utiliza um
 *     laço de repetição do tipo "para" para calcular e exibir a tabuada do número informado.
 *
 * Autores:
 *
 *     Giordana Maria da Costa Valle
 *     Carlos Alexandre Krueger
 *
 * Data: 01/06/2013
 */

funcao inicio() {
    escreva("Informe um número para ver sua tabuada: ");
    seja mutavel numero: inteiro = leia();

    escreval();

    para (seja mutavel contador: inteiro = 1; contador <= 10; contador += 1) {
        seja resultado: inteiro = numero * contador;
        escreval(numero, " X ", contador, " = ", resultado);
    }
}
