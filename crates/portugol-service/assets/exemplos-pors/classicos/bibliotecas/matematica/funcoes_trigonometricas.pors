funcao inicio() {
    seja mutavel numero: real = 0.0;

    escreva("Digite um número: ");
    leia(numero);

    seja seno: real = Matematica.seno(numero);
    seja cosseno: real = Matematica.cosseno(numero);
    seja tangente: real = Matematica.tangente(numero);

    escreva("\nO seno de ", numero, " é: ", seno);
    escreva("\nO cosseno de ", numero, " é: ", cosseno);
    escreva("\nA tangente de ", numero, " é: ", tangente);
    escreva("\n");
}
