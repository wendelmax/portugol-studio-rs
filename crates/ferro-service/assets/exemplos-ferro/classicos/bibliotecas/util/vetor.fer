 * desde que este cabeçalho, contendo os direitos autorais e a descrição do programa,
 * seja mantido.
 *
 * Descrição:
 *
 * 	Este exemplo demonstra como descobrir dinamicamente o número de elementos contidos
 * 	em um vetor. Em Ferro, utiliza-se a função nativa "tamanho(vetor)".
 *
 * Autores:
 *
 * 	Luiz Fernando Noschang (noschang@univali.br)
 *
 * Data: 18/07/2014
 * Adaptado para Ferro (.fer)
 */

funcao inicio() {
    // Cria um vetor com 5 elementos
    seja vet: vetor < inteiro > = [4, 2, 9, 3, 8];

    // Experimente substituir o vetor acima por este e veja que
    // o programa consegue percorrer normalmente o novo vetor:
    // seja vet: vetor<inteiro> = [4, 2, 9, 3, 8, 6, 5, 6, 2, 3, 9, 1];

    seja elementos: inteiro = tamanho(vet);

    escreval("O vetor possui ", elementos, " elementos:\n");

    // Utiliza o tamanho obtido para percorrer o vetor e exibir seus valores
    para (seja mutavel elemento = 0; elemento < elementos; elemento += 1) {
        se (elemento == 0) {
            escreva("{ ");
        }

        escreva(vet[elemento]);

        se (elemento < elementos - 1) {
            escreva(", ");
        }

        se (elemento == elementos - 1) {
            escreva(" }");
        }
    }

    escreval();
}
