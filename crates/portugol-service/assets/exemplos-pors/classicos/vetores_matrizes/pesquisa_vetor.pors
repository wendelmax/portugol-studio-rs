 * Adaptado para Portugol-RS (.pors)
 *
 * Este arquivo de código fonte é livre para utilização, cópia e/ou modificação
 * desde que este cabeçalho, contendo os direitos autorais e a descrição do programa,
 * seja mantido.
 *
 * Descrição:
 *
 *     Este exemplo ilustra o uso dos vetores na linguagem Portugol-RS.
 *
 *     Neste exemplo, é criado um vetor com valores pré-definidos. Logo após, o programa
 *     pede ao usuário que informe um valor e percorre o vetor procurando pelo valor
 *     informado.
 *
 *     Por último, o programa exibe uma mensagem informando se o valor informado foi encontrado
 *     dentro do vetor ou não.
 *
 * Autores:
 *
 *     Giordana Maria da Costa Valle
 *     Carlos Alexandre Krueger
 *
 * Data: 01/06/2013
 */

funcao inicio() {
    // Cria o vetor com valores pré-definidos
    seja numeros: vetor < inteiro > = [1, 3, 5, 7, 9];
    // Variável para armazenar o resultado da procura
    seja mutavel achou: logico = falso;

    escreva("Qual número deseja procurar? ");
    seja mutavel numero: inteiro = leia();

    para (seja mutavel posicao = 0; posicao < tamanho(numeros); posicao += 1) {
        se (numeros[posicao] == numero) {
            escreval("Encontrado na posição: ", posicao);
            achou = verdadeiro;
        }
    }

    se (!achou) {
        escreval("O número não está no vetor");
    }
}
