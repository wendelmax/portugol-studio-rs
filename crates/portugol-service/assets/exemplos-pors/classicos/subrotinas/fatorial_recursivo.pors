 * Este arquivo de código fonte é livre para utilização, cópia e/ou modificação
 * desde que este cabeçalho, contendo os direitos autorais e a descrição do programa,
 * seja mantido.
 *
 * Descrição:
 *
 *     Este exemplo pede ao usuário que informe um número inteiro. Logo após, calcula
 *     e exibe o fatorial do número informado.
 *
 *     Neste exemplo, o fatorial é calculado chamando recursivamente a função "fatorial"
 *     definida no programa.
 *
 *     O fatorial de um número é calculado multiplicando todos os valores inteiros entre 1 e
 *     o próprio número. Exemplos:
 *
 *     Fatorial de 3 = 1 * 2 * 3 = 6
 *     Fatorial de 4 = 1 * 2 * 3 * 4 = 24
 *     Fatorial de 5 = 1 * 2 * 3 * 4 * 5 = 120
 *
 *     Na matemática, o fatorial é representado pelo símbolo '!'.
 *     Exemplo: 5!
 *
 * Autores:
 *
 *     Giordana Maria da Costa Valle
 *     Carlos Alexandre Krueger
 *
 * Data: 01/06/2013
 */

// Função recursiva que calcula o fatorial do número passado
funcao fatorial(numero: inteiro) -> inteiro {
    se (numero <= 1) {
        retorne 1;
    }

    retorne numero * fatorial(numero - 1);
}

funcao inicio() {
    escreva("Digite um número: ");
    seja mutavel numero: inteiro = leia();

    escreval("\nO fatorial de ", numero, " é: ", fatorial(numero));
}
