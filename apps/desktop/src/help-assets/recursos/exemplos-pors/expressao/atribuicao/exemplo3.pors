funcao inicio() {
    // Atribuicao de valor literal a uma variavel mutavel
    seja mutavel a = 0;
    a = 2;

    // Entrada informada pelo usuario convertida para inteiro
    seja b: inteiro = leia();

    // Atribuicao atraves do valor de outra variavel
    seja mutavel c = 0;
    c = b;

    escreval("a = ", a, ", b = ", b, ", c = ", c);
}
