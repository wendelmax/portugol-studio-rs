 * desde que este cabeçalho, contendo os direitos autorais e a descrição do programa,
 * seja mantido.
 *
 * Descrição:
 *
 *   Jogo clássico da Serpente (Snake) escrito em Portugol-RS. A serpente cresce
 *   a cada comida coletada e o jogador perde se colidir com as bordas ou com o
 *   próprio corpo. Inclui níveis de dificuldade, placar e recorde da sessão.
 *
 *   Controles:
 *     - Setas ou W, A, S, D: controlam a direção da serpente
 *     - D (no menu): alterna a dificuldade (Facil / Medio / Dificil)
 *     - ENTER ou ESPACO: inicia / reinicia a partida
 *     - ESC: encerra o jogo
 *
 * Autor (versão original):
 *
 *   Luiz Fernando Noschang (noschang@univali.br)
 *
 * Data original: 08/09/2013
 * Adaptado para Portugol-RS (.pors)
 */

enum Direcao {
    Acima,
    Abaixo,
    Esquerda,
    Direita,
}

enum Dificuldade {
    Facil,
    Medio,
    Dificil,
}

enum TelaSerpente {
    Menu,
    Jogando,
    Derrota,
    Vitoria,
}

registro Segmento {
    linha: inteiro,
    coluna: inteiro,
}

registro JogoSerpente {
    tela: TelaSerpente,
    dificuldade: Dificuldade,
    corpo: vetor < Segmento >,
    direcao: Direcao,
    proxima_direcao: Direcao,
    comida_linha: inteiro,
    comida_coluna: inteiro,
    pontuacao: inteiro,
    recorde: inteiro,
    ultimo_passo_ms: inteiro,
    tecla_enter_estava: logico,
    tecla_d_estava: logico,
}

funcao cor_rgb(r: inteiro, g: inteiro, b: inteiro) -> inteiro {
    escolha Graficos.criar_cor(r, g, b) {
        caso Resultado::Ok(cor) => {
            retorne cor;
        }
        caso Resultado::Erro(_) => {
            retorne Graficos.COR_BRANCO;
        }
    }
}

funcao sortear_entre(minimo: inteiro, maximo: inteiro) -> inteiro {
    escolha Util.sorteia(minimo, maximo) {
        caso Resultado::Ok(v) => {
            retorne v;
        }
        caso Resultado::Erro(_) => {
            retorne minimo;
        }
    }
}

funcao intervalo_dificuldade(dif: Dificuldade) -> inteiro {
    escolha dif {
        caso Dificuldade::Facil => {
            retorne 150;
        }
        caso Dificuldade::Medio => {
            retorne 100;
        }
        caso Dificuldade::Dificil => {
            retorne 65;
        }
    }
}

funcao pontos_dificuldade(dif: Dificuldade) -> inteiro {
    escolha dif {
        caso Dificuldade::Facil => {
            retorne 10;
        }
        caso Dificuldade::Medio => {
            retorne 25;
        }
        caso Dificuldade::Dificil => {
            retorne 50;
        }
    }
}

funcao nome_dificuldade(dif: Dificuldade) -> cadeia {
    escolha dif {
        caso Dificuldade::Facil => {
            retorne "Facil";
        }
        caso Dificuldade::Medio => {
            retorne "Medio";
        }
        caso Dificuldade::Dificil => {
            retorne "Dificil";
        }
    }
}

funcao proxima_dificuldade(dif: Dificuldade) -> Dificuldade {
    escolha dif {
        caso Dificuldade::Facil => {
            retorne Dificuldade::Medio;
        }
        caso Dificuldade::Medio => {
            retorne Dificuldade::Dificil;
        }
        caso Dificuldade::Dificil => {
            retorne Dificuldade::Facil;
        }
    }
}

funcao celula_ocupada(corpo: vetor < Segmento >, linha: inteiro, coluna: inteiro) -> logico {
    seja total: inteiro = tamanho(corpo);
    para (seja mutavel i = 0; i < total; i += 1) {
        seja seg: Segmento = corpo[i];
        se (seg.linha == linha && seg.coluna == coluna) {
            retorne verdadeiro;
        }
    }
    retorne falso;
}

funcao sortear_comida(corpo: vetor < Segmento >) -> Segmento {
    // Grade 24 linhas x 34 colunas
    para (seja mutavel tentativa = 0; tentativa < 200; tentativa += 1) {
        seja l: inteiro = sortear_entre(0, 23);
        seja c: inteiro = sortear_entre(0, 33);
        se (!celula_ocupada(corpo, l, c)) {
            retorne Segmento {
                linha: l, coluna: c
            }
            ;
        }
    }
    para (seja mutavel l = 0; l < 24; l += 1) {
        para (seja mutavel c = 0; c < 34; c += 1) {
            se (!celula_ocupada(corpo, l, c)) {
                retorne Segmento {
                    linha: l, coluna: c
                }
                ;
            }
        }
    }
    retorne Segmento {
        linha: 0, coluna: 0
    }
    ;
}

funcao criar_partida(tela: TelaSerpente, dif: Dificuldade, recorde: inteiro) -> JogoSerpente {
    seja mutavel corpo: vetor < Segmento > = [];
    adicionar(corpo, Segmento {
        linha: 12, coluna: 16
    }
    );
    adicionar(corpo, Segmento {
        linha: 12, coluna: 15
    }
    );
    adicionar(corpo, Segmento {
        linha: 12, coluna: 14
    }
    );
    adicionar(corpo, Segmento {
        linha: 12, coluna: 13
    }
    );

    seja comida: Segmento = sortear_comida(corpo);

    retorne JogoSerpente {
        tela: tela,
        dificuldade: dif,
        corpo: corpo,
        direcao: Direcao::Direita,
        proxima_direcao: Direcao::Direita,
        comida_linha: comida.linha,
        comida_coluna: comida.coluna,
        pontuacao: 0,
        recorde: recorde,
        ultimo_passo_ms: Util.tempo_decorrido(),
        tecla_enter_estava: falso,
        tecla_d_estava: falso,
    }
    ;
}

funcao sao_opostas(a: Direcao, b: Direcao) -> logico {
    escolha a {
        caso Direcao::Acima => {
            escolha b {
                caso Direcao::Abaixo => {
                    retorne verdadeiro;
                }
                caso _ => {
                    retorne falso;
                }
            }
        }
        caso Direcao::Abaixo => {
            escolha b {
                caso Direcao::Acima => {
                    retorne verdadeiro;
                }
                caso _ => {
                    retorne falso;
                }
            }
        }
        caso Direcao::Esquerda => {
            escolha b {
                caso Direcao::Direita => {
                    retorne verdadeiro;
                }
                caso _ => {
                    retorne falso;
                }
            }
        }
        caso Direcao::Direita => {
            escolha b {
                caso Direcao::Esquerda => {
                    retorne verdadeiro;
                }
                caso _ => {
                    retorne falso;
                }
            }
        }
    }
}

funcao atualizar(jogo: JogoSerpente) -> JogoSerpente {
    seja mutavel j: JogoSerpente = jogo;

    seja enter_agora: logico = Teclado.tecla_pressionada(Teclado.TECLA_ENTER) || Teclado.tecla_pressionada(Teclado.TECLA_ESPACO);
    seja enter_disparado: logico = enter_agora && !j.tecla_enter_estava;
    j.tecla_enter_estava = enter_agora;

    seja d_agora: logico = Teclado.tecla_pressionada(Teclado.TECLA_D);
    seja d_disparado: logico = d_agora && !j.tecla_d_estava;
    j.tecla_d_estava = d_agora;

    escolha j.tela {
        caso TelaSerpente::Menu => {
            se (d_disparado) {
                j.dificuldade = proxima_dificuldade(j.dificuldade);
            }
            se (enter_disparado) {
                j = criar_partida(TelaSerpente::Jogando, j.dificuldade, j.recorde);
                j.tecla_enter_estava = verdadeiro;
            }
            retorne j;
        }
        caso TelaSerpente::Derrota => {
            se (enter_disparado) {
                j = criar_partida(TelaSerpente::Jogando, j.dificuldade, j.recorde);
                j.tecla_enter_estava = verdadeiro;
            }
            retorne j;
        }
        caso TelaSerpente::Vitoria => {
            se (enter_disparado) {
                j = criar_partida(TelaSerpente::Jogando, j.dificuldade, j.recorde);
                j.tecla_enter_estava = verdadeiro;
            }
            retorne j;
        }
        caso TelaSerpente::Jogando => {}
    }

    // Leitura da direção sem permitir inversão imediata de 180 graus
    seja mutavel desejada: Direcao = j.proxima_direcao;
    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_ACIMA) || Teclado.tecla_pressionada(Teclado.TECLA_W)) {
        desejada = Direcao::Acima;
    } senao se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_ABAIXO) || Teclado.tecla_pressionada(Teclado.TECLA_S)) {
        desejada = Direcao::Abaixo;
    } senao se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_ESQUERDA) || Teclado.tecla_pressionada(Teclado.TECLA_A)) {
        desejada = Direcao::Esquerda;
    } senao se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_DIREITA) || Teclado.tecla_pressionada(Teclado.TECLA_D)) {
        desejada = Direcao::Direita;
    }
    se (!sao_opostas(j.direcao, desejada)) {
        j.proxima_direcao = desejada;
    }

    seja agora: inteiro = Util.tempo_decorrido();
    se (agora - j.ultimo_passo_ms < intervalo_dificuldade(j.dificuldade)) {
        retorne j;
    }
    j.ultimo_passo_ms = agora;
    j.direcao = j.proxima_direcao;

    seja corpo_atual: vetor < Segmento > = j.corpo;
    seja cabeca: Segmento = corpo_atual[0];
    seja mutavel nova_linha: inteiro = cabeca.linha;
    seja mutavel nova_coluna: inteiro = cabeca.coluna;

    escolha j.direcao {
        caso Direcao::Acima => {
            nova_linha -= 1;
        }
        caso Direcao::Abaixo => {
            nova_linha += 1;
        }
        caso Direcao::Esquerda => {
            nova_coluna -= 1;
        }
        caso Direcao::Direita => {
            nova_coluna += 1;
        }
    }

    // Colisão com paredes
    se (nova_linha < 0 || nova_linha >= 24 || nova_coluna < 0 || nova_coluna >= 34) {
        j.tela = TelaSerpente::Derrota;
        retorne j;
    }

    // Colisão com próprio corpo
    se (celula_ocupada(corpo_atual, nova_linha, nova_coluna)) {
        j.tela = TelaSerpente::Derrota;
        retorne j;
    }

    seja comeu: logico = nova_linha == j.comida_linha && nova_coluna == j.comida_coluna;

    seja mutavel novo_corpo: vetor < Segmento > = [];
    adicionar(novo_corpo, Segmento {
        linha: nova_linha, coluna: nova_coluna
    }
    );

    seja total_antigo: inteiro = tamanho(corpo_atual);
    seja mutavel limite_copia: inteiro = total_antigo - 1;
    se (comeu) {
        limite_copia = total_antigo;
    }
    para (seja mutavel i = 0; i < limite_copia; i += 1) {
        adicionar(novo_corpo, corpo_atual[i]);
    }
    j.corpo = novo_corpo;

    se (comeu) {
        j.pontuacao += pontos_dificuldade(j.dificuldade);
        se (j.pontuacao > j.recorde) {
            j.recorde = j.pontuacao;
        }
        se (tamanho(novo_corpo) >= 24 * 34) {
            j.tela = TelaSerpente::Vitoria;
        } senao {
            seja nova_comida: Segmento = sortear_comida(novo_corpo);
            j.comida_linha = nova_comida.linha;
            j.comida_coluna = nova_comida.coluna;
        }
    }

    retorne j;
}

funcao desenhar(jogo: JogoSerpente) {
    Graficos.definir_cor(cor_rgb(20, 28, 24));
    Graficos.limpar();

    // Painel superior
    Graficos.definir_cor(cor_rgb(30, 42, 36));
    Graficos.desenhar_retangulo(0, 0, 720, 52, falso, verdadeiro);
    Graficos.definir_cor(cor_rgb(110, 235, 130));
    Graficos.definir_tamanho_texto(18.0);
    Graficos.desenhar_texto(18, 14, "SERPENTE");

    Graficos.definir_cor(Graficos.COR_BRANCO);
    Graficos.definir_tamanho_texto(14.0);
    Graficos.desenhar_texto(165, 17, "Pontos: " + Tipos.inteiro_para_cadeia(jogo.pontuacao));
    Graficos.desenhar_texto(315, 17, "Recorde: " + Tipos.inteiro_para_cadeia(jogo.recorde));
    Graficos.definir_cor(cor_rgb(255, 210, 90));
    Graficos.desenhar_texto(475, 17, "Nivel: " + nome_dificuldade(jogo.dificuldade));

    // Arena 34x24 células de 20x20 px (x=20..700, y=64..544)
    seja cel: inteiro = 20;
    seja ox: inteiro = 20;
    seja oy: inteiro = 64;

    Graficos.definir_cor(cor_rgb(28, 38, 32));
    Graficos.desenhar_retangulo(ox, oy, 34 * cel, 24 * cel, falso, verdadeiro);
    Graficos.definir_cor(cor_rgb(70, 120, 86));
    Graficos.desenhar_retangulo(ox, oy, 34 * cel, 24 * cel, falso, falso);

    // Comida (maçã)
    seja fx: inteiro = ox + jogo.comida_coluna * cel;
    seja fy: inteiro = oy + jogo.comida_linha * cel;
    Graficos.definir_cor(cor_rgb(240, 70, 70));
    Graficos.desenhar_elipse(fx + 2, fy + 2, cel - 4, cel - 4, verdadeiro);
    Graficos.definir_cor(cor_rgb(130, 240, 110));
    Graficos.desenhar_retangulo(fx + 8, fy, 4, 4, falso, verdadeiro);

    // Corpo da serpente
    seja corpo: vetor < Segmento > = jogo.corpo;
    seja total: inteiro = tamanho(corpo);
    para (seja mutavel i: inteiro = total - 1; i >= 0; i -= 1) {
        seja seg: Segmento = corpo[i];
        seja sx: inteiro = ox + seg.coluna * cel;
        seja sy: inteiro = oy + seg.linha * cel;
        se (i == 0) {
            Graficos.definir_cor(cor_rgb(140, 255, 140));
            Graficos.desenhar_retangulo(sx + 1, sy + 1, cel - 2, cel - 2, verdadeiro, verdadeiro);
            // Olhos
            Graficos.definir_cor(cor_rgb(20, 30, 20));
            Graficos.desenhar_elipse(sx + 5, sy + 5, 3, 3, verdadeiro);
            Graficos.desenhar_elipse(sx + 12, sy + 5, 3, 3, verdadeiro);
        } senao {
            se (i % 2 == 0) {
                Graficos.definir_cor(cor_rgb(72, 196, 102));
            } senao {
                Graficos.definir_cor(cor_rgb(56, 168, 86));
            }
            Graficos.desenhar_retangulo(sx + 2, sy + 2, cel - 4, cel - 4, verdadeiro, verdadeiro);
        }
    }

    // Rodapé
    Graficos.definir_cor(cor_rgb(165, 185, 170));
    Graficos.definir_tamanho_texto(12.0);
    Graficos.desenhar_texto(130, 554, "[Setas / WASD] Mover  |  [ENTER] Iniciar/Reiniciar  |  [ESC] Sair");

    // Sobreposições de estado
    escolha jogo.tela {
        caso TelaSerpente::Menu => {
            Graficos.definir_cor(cor_rgb(16, 26, 22));
            Graficos.desenhar_retangulo(150, 195, 420, 190, verdadeiro, verdadeiro);
            Graficos.definir_cor(cor_rgb(110, 235, 130));
            Graficos.desenhar_retangulo(150, 195, 420, 190, verdadeiro, falso);
            Graficos.definir_tamanho_texto(30.0);
            Graficos.desenhar_texto(232, 220, "JOGO DA SERPENTE");
            Graficos.definir_cor(Graficos.COR_BRANCO);
            Graficos.definir_tamanho_texto(15.0);
            Graficos.desenhar_texto(218, 276, "Dificuldade: " + nome_dificuldade(jogo.dificuldade) + "  (tecla D)");
            Graficos.definir_cor(cor_rgb(255, 220, 90));
            Graficos.desenhar_texto(215, 326, "Pressione [ENTER] para comecar");
        }
        caso TelaSerpente::Derrota => {
            Graficos.definir_cor(cor_rgb(48, 18, 22));
            Graficos.desenhar_retangulo(170, 215, 380, 150, verdadeiro, verdadeiro);
            Graficos.definir_cor(cor_rgb(255, 100, 100));
            Graficos.definir_tamanho_texto(26.0);
            Graficos.desenhar_texto(272, 240, "FIM DE JOGO");
            Graficos.definir_cor(Graficos.COR_BRANCO);
            Graficos.definir_tamanho_texto(15.0);
            Graficos.desenhar_texto(255, 286, "Pontuacao: " + Tipos.inteiro_para_cadeia(jogo.pontuacao) + "  |  Recorde: " + Tipos.inteiro_para_cadeia(jogo.recorde));
            Graficos.definir_cor(cor_rgb(255, 220, 90));
            Graficos.desenhar_texto(215, 324, "Pressione [ENTER] para jogar novamente");
        }
        caso TelaSerpente::Vitoria => {
            Graficos.definir_cor(cor_rgb(18, 48, 28));
            Graficos.desenhar_retangulo(170, 215, 380, 150, verdadeiro, verdadeiro);
            Graficos.definir_cor(cor_rgb(120, 255, 140));
            Graficos.definir_tamanho_texto(26.0);
            Graficos.desenhar_texto(270, 240, "VOCE VENCEU!");
            Graficos.definir_cor(Graficos.COR_BRANCO);
            Graficos.definir_tamanho_texto(15.0);
            Graficos.desenhar_texto(255, 286, "Pontuacao maxima: " + Tipos.inteiro_para_cadeia(jogo.pontuacao));
            Graficos.desenhar_texto(215, 324, "Pressione [ENTER] para jogar novamente");
        }
        caso TelaSerpente::Jogando => {}
    }

    Graficos.renderizar();
}

funcao inicio() {
    Graficos.iniciar_modo_grafico(verdadeiro);
    Graficos.definir_dimensoes_janela(720, 580);
    Graficos.definir_titulo_janela("Jogo da Serpente - Portugol-RS");

    seja mutavel jogo: JogoSerpente = criar_partida(TelaSerpente::Menu, Dificuldade::Medio, 0);

    enquanto (!Teclado.tecla_pressionada(Teclado.TECLA_ESC)) {
        jogo = atualizar(jogo);
        desenhar(jogo);
        Util.aguarde(16);
    }

    Graficos.encerrar_modo_grafico();
}
