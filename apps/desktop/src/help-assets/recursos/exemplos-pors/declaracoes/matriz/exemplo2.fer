funcao inicio() {
    // Em Portugol-RS, uma matriz de L linhas por C colunas e representada
    // por um vetor linear usando o indice (linha * colunas + coluna).
    seja colunas_matriz: inteiro = 2;
    seja mutavel matriz: vetor < inteiro > = [
    15, 22,
    10, 11
    ];

    // Atribui -1 na primeira linha (0) e segunda coluna (1)
    matriz[0 * colunas_matriz + 1] = -1;

    // Imprime o valor 15 correspondente a primeira linha e primeira coluna
    seja i = 0;
    escreval(matriz[i * colunas_matriz + 0]);

    // Imprime o valor 11 correspondente a ultima linha e ultima coluna
    escreval(matriz[1 * colunas_matriz + 1]);

    // Matriz de reais de 2 linhas por 4 colunas (8 posicoes) inicializada com 0.0
    seja mutavel outra_matriz: vetor < real > = [];
    para (seja mutavel k = 0; k < 2 * 4; k += 1) {
        adicionar(outra_matriz, 0.0);
    }

    // Matriz 3x3 de caracteres representando um tabuleiro de jogo da velha
    seja colunas_velha: inteiro = 3;
    seja jogo_velha: vetor < caracter > = [
    'X', 'O', 'X',
    'O', 'X', 'O',
    ' ', ' ', 'X'
    ];
    escreval("Centro do tabuleiro: ", jogo_velha[1 * colunas_velha + 1]);
}
