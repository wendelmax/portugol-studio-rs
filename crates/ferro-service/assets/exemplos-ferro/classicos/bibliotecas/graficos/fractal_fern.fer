/*
 * Exemplo clássico do Ferro Studio adaptado para Ferro (.fer)
 *
 * Descrição:
 *
 *   Este exemplo desenha o Fractal de Barnsley (samambaia / fern) utilizando
 *   um Sistema de Funções Iteradas (IFS) com probabilidades sorteadas em
 *   Util.sorteia() e renderização progressiva na biblioteca Graficos.
 */

registro PontoFractal {
    x: real,
    y: real
}

funcao cor_rgb(r: inteiro, g: inteiro, b: inteiro) -> inteiro {
    escolha Graficos.criar_cor(r, g, b) {
        caso Resultado::Ok(cor) => {
            retorne cor;
        }
        caso Resultado::Erro(_) => {
            retorne Graficos.COR_PRETO;
        }
    }
}

funcao sortear_real() -> real {
    escolha Util.sorteia(0, 1000) {
        caso Resultado::Ok(n) => {
            retorne Tipos.inteiro_para_real(n) / 1000.0;
        }
        caso Resultado::Erro(_) => {
            retorne 0.5;
        }
    }
}

funcao aguardar_enter() {
    seja mutavel aguardando: logico = verdadeiro;
    enquanto (aguardando) {
        escolha Teclado.ler_tecla() {
            caso Resultado::Ok(tecla) => {
                se (tecla == Teclado.TECLA_ENTER || tecla == Teclado.TECLA_ESC) {
                    aguardando = falso;
                }
            }
            caso Resultado::Erro(_) => {
                aguardando = falso;
            }
        }
    }
}

funcao iterar_ponto(mutavel p: PontoFractal, numero_iteracoes: inteiro) -> PontoFractal {
    para (seja mutavel iteracao: inteiro = 1; iteracao <= numero_iteracoes; iteracao += 1) {
        seja numero_sorteado: real = sortear_real();
        seja mutavel novox: real = 0.0;
        seja mutavel novoy: real = 0.0;

        se (numero_sorteado < 0.01) {
            novox = 0.0;
            novoy = 0.16 * p.y;
        } senao se (numero_sorteado < 0.86) {
            novox = (0.85 * p.x) + (0.04 * p.y);
            novoy = (-0.04 * p.x) + (0.85 * p.y) + 1.6;
        } senao se (numero_sorteado < 0.93) {
            novox = (0.2 * p.x) - (0.26 * p.y);
            novoy = (0.23 * p.x) + (0.22 * p.y) + 1.6;
        } senao {
            novox = (-0.15 * p.x) + (0.28 * p.y);
            novoy = (0.26 * p.x) + (0.24 * p.y) + 0.44;
        }

        p.x = novox;
        p.y = novoy;
    }

    retorne p;
}

funcao exibir_tela_inicial(cor_fundo: inteiro, cor_texto: inteiro) {
    Graficos.definir_cor(cor_fundo);
    Graficos.limpar();
    Graficos.definir_tamanho_texto(18.0);
    Graficos.definir_cor(cor_texto);
    Graficos.definir_estilo_texto(falso, falso, falso);
    Graficos.desenhar_texto(15, 15, "Este exemplo desenha um Fractal de Fern na tela");
    Graficos.desenhar_texto(15, 40, "O desenho leva alguns segundos para ficar pronto");
    Graficos.desenhar_texto(15, 65, "Pressione <ENTER> para continuar");
    Graficos.renderizar();

    aguardar_enter();
}

funcao inicio() {
    seja numero_iteracoes: inteiro = 5;
    seja numero_pontos: inteiro = 100000;
    seja largura_janela: inteiro = 700;
    seja altura_janela: inteiro = 600;
    seja intervalo_atualizacao: inteiro = 10;

    seja cor_fundo: inteiro = cor_rgb(246, 246, 246);
    seja cor_texto: inteiro = cor_rgb(255, 0, 0);
    seja cor_folha: inteiro = cor_rgb(28, 138, 54);

    seja relacao_x: real = Tipos.inteiro_para_real(largura_janela) / 10.0;
    seja relacao_y: real = Tipos.inteiro_para_real(altura_janela) / -10.0;

    Graficos.iniciar_modo_grafico(verdadeiro);
    Graficos.definir_dimensoes_janela(largura_janela, altura_janela);
    Graficos.definir_titulo_janela("Fractal");

    seja mutavel imagem_ponto: Opcao < inteiro > = Opcao::Nenhum;
    escolha Graficos.carregar_imagem("fractal_fern/ponto.png") {
        caso Resultado::Ok(id) => {
            imagem_ponto = Opcao::Algum(id);
        }
        caso Resultado::Erro(_) => {
            imagem_ponto = Opcao::Nenhum;
        }
    }

    exibir_tela_inicial(cor_fundo, cor_texto);

    Graficos.definir_cor(cor_fundo);
    Graficos.limpar();
    Graficos.definir_cor(cor_texto);
    Graficos.desenhar_texto(15, 15, "Status: 0% concluído");
    Graficos.renderizar();

    seja mutavel estado: PontoFractal = PontoFractal {
        x: sortear_real(),
        y: sortear_real()
    }
    ;
    seja mutavel ultima_porcentagem = 0;

    para (seja mutavel ponto: inteiro = 1; ponto <= numero_pontos; ponto += 1) {
        estado = iterar_ponto(estado, numero_iteracoes);

        seja px: inteiro = Tipos.real_para_inteiro((estado.x + 5.0) * relacao_x);
        seja py: inteiro = Tipos.real_para_inteiro((estado.y - 10.0) * relacao_y);

        escolha imagem_ponto {
            caso Opcao::Algum(img) => {
                Graficos.desenhar_imagem(px, py, img);
            }
            caso Opcao::Nenhum => {
                Graficos.definir_cor(cor_folha);
                Graficos.desenhar_ponto(px, py);
            }
        }

        seja porcentagem: inteiro = (ponto * 100) / numero_pontos;
        se (porcentagem >= ultima_porcentagem + intervalo_atualizacao) {
            ultima_porcentagem = porcentagem;
            Graficos.definir_cor(cor_fundo);
            Graficos.desenhar_retangulo(0, 0, 260, 48, falso, verdadeiro);
            Graficos.definir_cor(cor_texto);
            Graficos.desenhar_texto(
            15,
            15,
            "Status: " + Tipos.inteiro_para_cadeia(porcentagem) + "% concluído"
            );
            Graficos.renderizar();
        }
    }

    Graficos.definir_cor(cor_texto);
    Graficos.desenhar_texto(15, 42, "Pressione <ENTER> para sair");
    Graficos.renderizar();

    aguardar_enter();

    escolha imagem_ponto {
        caso Opcao::Algum(img) => {
            Graficos.liberar_imagem(img);
        }
        caso Opcao::Nenhum => {}
    }

    Graficos.encerrar_modo_grafico();
}
