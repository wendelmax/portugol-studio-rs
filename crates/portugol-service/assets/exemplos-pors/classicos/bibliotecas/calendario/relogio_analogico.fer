registro Ponto {
    x: inteiro,
    y: inteiro,
}

registro EstadoRelogio {
    exibir_linhas_horas: logico,
    exibir_linhas_minutos: logico,
    largura_janela: inteiro,
    altura_janela: inteiro,
    centro_x: inteiro,
    centro_y: inteiro,
    tam_relogio: inteiro,
    x_relogio: inteiro,
    y_relogio: inteiro,
    tam_borda_relogio: inteiro,
    x_borda_relogio: inteiro,
    y_borda_relogio: inteiro,
    tam_circulo_hr: inteiro,
    x_circulo_hr: inteiro,
    y_circulo_hr: inteiro,
    tam_circulo_min: inteiro,
    x_circulo_min: inteiro,
    y_circulo_min: inteiro,
    tam_fonte_horas: real,
    tam_fonte_dicas: real,
    cor_fundo_padrao: inteiro,
    sombra_relogio: inteiro,
    cor_fundo_dicas: inteiro,
    coordenadas_x_hr_ext: vetor < inteiro >,
    coordenadas_y_hr_ext: vetor < inteiro >,
    coordenadas_x_hr_int: vetor < inteiro >,
    coordenadas_y_hr_int: vetor < inteiro >,
    coordenadas_x_min: vetor < inteiro >,
    coordenadas_y_min: vetor < inteiro >,
    coordenadas_x_seg: vetor < inteiro >,
    coordenadas_y_seg: vetor < inteiro >,
    angulos_horas: vetor < real >,
    angulos_minutos: vetor < real >,
}

funcao cor_rgb(r: inteiro, g: inteiro, b: inteiro, padrao: inteiro) -> inteiro {
    escolha Graficos.criar_cor(r, g, b) {
        caso Resultado::Ok(cor) => {
            retorne cor;
        }
        caso Resultado::Erro(_) => {
            retorne padrao;
        }
    }
}

funcao criar_vetor_inteiros(qtd: inteiro) -> vetor < inteiro > {
    seja mutavel v: vetor < inteiro > = [];
    para (seja mutavel i = 0; i < qtd; i += 1) {
        adicionar(v, 0);
    }
    retorne v;
}

funcao criar_vetor_reais(qtd: inteiro) -> vetor < real > {
    seja mutavel v: vetor < real > = [];
    para (seja mutavel i = 0; i < qtd; i += 1) {
        adicionar(v, 0.0);
    }
    retorne v;
}

funcao inicializar() -> EstadoRelogio {
    Graficos.iniciar_modo_grafico(verdadeiro);
    Graficos.definir_titulo_janela("Relógio Analógico");
    Graficos.definir_dimensoes_janela(800, 600);

    seja largura: inteiro = Graficos.largura_janela();
    seja altura: inteiro = Graficos.altura_janela();
    seja largura_r: real = Tipos.inteiro_para_real(largura);
    seja altura_r: real = Tipos.inteiro_para_real(altura);

    seja tam_relogio_r: real = altura_r - altura_r * 0.15;
    seja tam_relogio: inteiro = Tipos.real_para_inteiro(tam_relogio_r);
    seja tam_borda: inteiro = Tipos.real_para_inteiro(tam_relogio_r + tam_relogio_r * 0.1);
    seja tam_circulo_hr: inteiro = Tipos.real_para_inteiro(tam_relogio_r - tam_relogio_r * 0.1);
    seja tam_circulo_min: inteiro = Tipos.real_para_inteiro(tam_relogio_r - tam_relogio_r * 0.05);

    seja mutavel tam_fonte_horas: real = 50.0;
    seja mutavel tam_fonte_dicas: real = 14.0;
    seja aspect_ratio: real = Matematica.arredondar(largura_r / altura_r, 1);

    se (aspect_ratio == 1.3) {
        tam_fonte_horas = 50.0 * (altura_r / 600.0);
        tam_fonte_dicas = 14.0;
    } senao se (aspect_ratio == 1.8) {
        tam_fonte_horas = 70.0 * (altura_r / 768.0);
        tam_fonte_dicas = 16.0;
    } senao se (aspect_ratio == 2.4) {
        tam_fonte_horas = 100.0 * (altura_r / 1080.0);
        tam_fonte_dicas = 20.0;
    }

    seja mutavel x_hr_ext: vetor < inteiro > = criar_vetor_inteiros(12);
    seja mutavel y_hr_ext: vetor < inteiro > = criar_vetor_inteiros(12);
    seja mutavel x_hr_int: vetor < inteiro > = criar_vetor_inteiros(12);
    seja mutavel y_hr_int: vetor < inteiro > = criar_vetor_inteiros(12);
    seja mutavel x_min: vetor < inteiro > = criar_vetor_inteiros(60);
    seja mutavel y_min: vetor < inteiro > = criar_vetor_inteiros(60);
    seja mutavel x_seg: vetor < inteiro > = criar_vetor_inteiros(60);
    seja mutavel y_seg: vetor < inteiro > = criar_vetor_inteiros(60);
    seja mutavel ang_hr: vetor < real > = criar_vetor_reais(12);
    seja mutavel ang_min: vetor < real > = criar_vetor_reais(60);

    // Calcula coordenadas externas e internas das 12 marcações de horas
    seja inc_hr: real = (Matematica.PI * 2.0) / 12.0;
    seja mutavel angulo: real = 0.0;
    para (seja mutavel camada = 0; camada < 2; camada += 1) {
        seja mutavel a = 0;
        para (seja mutavel j: inteiro = 9; j < 21; j += 1) {
            seja mutavel raio: real = tam_relogio_r / 2.0;
            se (camada == 1) {
                raio = (tam_relogio_r - tam_relogio_r * 0.25) / 2.0;
            }
            seja cx: inteiro = Tipos.real_para_inteiro(Matematica.arredondar(Matematica.cosseno(angulo) * raio, 0));
            seja cy: inteiro = Tipos.real_para_inteiro(Matematica.arredondar(Matematica.seno(angulo) * raio, 0));

            seja mutavel idx: inteiro = j;
            se (j >= 12) {
                idx = a;
                a += 1;
            }

            se (camada == 0) {
                x_hr_ext[idx] = cx;
                y_hr_ext[idx] = cy;
            } senao {
                x_hr_int[idx] = cx;
                y_hr_int[idx] = cy;
            }
            ang_hr[idx] = angulo;
            angulo += inc_hr;
        }
    }

    // Calcula coordenadas das 60 marcações de minutos e ponteiro de segundos
    seja inc_min: real = (Matematica.PI * 2.0) / 60.0;
    angulo = 0.0;
    seja mutavel k = 0;
    para (seja mutavel i: inteiro = 45; i < 105; i += 1) {
        seja raio_min: real = tam_relogio_r / 2.0;
        seja raio_seg: real = (tam_relogio_r - tam_relogio_r * 0.2) / 2.0;

        seja mx: inteiro = Tipos.real_para_inteiro(Matematica.arredondar(Matematica.cosseno(angulo) * raio_min, 0));
        seja my: inteiro = Tipos.real_para_inteiro(Matematica.arredondar(Matematica.seno(angulo) * raio_min, 0));
        seja sx: inteiro = Tipos.real_para_inteiro(Matematica.arredondar(Matematica.cosseno(angulo) * raio_seg, 0));
        seja sy: inteiro = Tipos.real_para_inteiro(Matematica.arredondar(Matematica.seno(angulo) * raio_seg, 0));

        seja mutavel idx: inteiro = i;
        se (i >= 60) {
            idx = k;
            k += 1;
        }

        x_min[idx] = mx;
        y_min[idx] = my;
        x_seg[idx] = sx;
        y_seg[idx] = sy;
        ang_min[idx] = angulo;
        angulo += inc_min;
    }

    retorne EstadoRelogio {
        exibir_linhas_horas: falso,
        exibir_linhas_minutos: falso,
        largura_janela: largura,
        altura_janela: altura,
        centro_x: largura / 2,
        centro_y: altura / 2,
        tam_relogio: tam_relogio,
        x_relogio: (largura / 2) - (tam_relogio / 2),
        y_relogio: (altura / 2) - (tam_relogio / 2),
        tam_borda_relogio: tam_borda,
        x_borda_relogio: (largura / 2) - (tam_borda / 2),
        y_borda_relogio: (altura / 2) - (tam_borda / 2),
        tam_circulo_hr: tam_circulo_hr,
        x_circulo_hr: (largura / 2) - (tam_circulo_hr / 2),
        y_circulo_hr: (altura / 2) - (tam_circulo_hr / 2),
        tam_circulo_min: tam_circulo_min,
        x_circulo_min: (largura / 2) - (tam_circulo_min / 2),
        y_circulo_min: (altura / 2) - (tam_circulo_min / 2),
        tam_fonte_horas: tam_fonte_horas,
        tam_fonte_dicas: tam_fonte_dicas,
        cor_fundo_padrao: cor_rgb(157, 159, 168, Graficos.COR_BRANCO),
        sombra_relogio: cor_rgb(71, 72, 76, Graficos.COR_PRETO),
        cor_fundo_dicas: cor_rgb(200, 203, 214, Graficos.COR_BRANCO),
        coordenadas_x_hr_ext: x_hr_ext,
        coordenadas_y_hr_ext: y_hr_ext,
        coordenadas_x_hr_int: x_hr_int,
        coordenadas_y_hr_int: y_hr_int,
        coordenadas_x_min: x_min,
        coordenadas_y_min: y_min,
        coordenadas_x_seg: x_seg,
        coordenadas_y_seg: y_seg,
        angulos_horas: ang_hr,
        angulos_minutos: ang_min,
    }
    ;
}

funcao calcular_ponteiro_hora(est: EstadoRelogio, hora: inteiro, minuto: inteiro) -> Ponto {
    seja ang_hr: vetor < real > = est.angulos_horas;
    seja a: real = ang_hr[hora] + 0.009 * Tipos.inteiro_para_real(minuto);
    seja tam_r: real = Tipos.inteiro_para_real(est.tam_relogio);
    seja raio: real = (tam_r - tam_r * 0.45) / 2.0;
    retorne Ponto {
        x: Tipos.real_para_inteiro(Matematica.arredondar(Matematica.cosseno(a) * raio, 0)),
        y: Tipos.real_para_inteiro(Matematica.arredondar(Matematica.seno(a) * raio, 0)),
    }
    ;
}

funcao calcular_ponteiro_minuto(est: EstadoRelogio, minuto: inteiro, segundo: inteiro) -> Ponto {
    seja ang_min: vetor < real > = est.angulos_minutos;
    seja a: real = ang_min[minuto] + 0.0017 * Tipos.inteiro_para_real(segundo);
    seja tam_r: real = Tipos.inteiro_para_real(est.tam_relogio);
    seja raio: real = (tam_r - tam_r * 0.25) / 2.0;
    retorne Ponto {
        x: Tipos.real_para_inteiro(Matematica.arredondar(Matematica.cosseno(a) * raio, 0)),
        y: Tipos.real_para_inteiro(Matematica.arredondar(Matematica.seno(a) * raio, 0)),
    }
    ;
}

funcao desenhar_relogio(est: EstadoRelogio) {
    seja x_min: vetor < inteiro > = est.coordenadas_x_min;
    seja y_min: vetor < inteiro > = est.coordenadas_y_min;
    seja x_hr_ext: vetor < inteiro > = est.coordenadas_x_hr_ext;
    seja y_hr_ext: vetor < inteiro > = est.coordenadas_y_hr_ext;
    seja x_hr_int: vetor < inteiro > = est.coordenadas_x_hr_int;
    seja y_hr_int: vetor < inteiro > = est.coordenadas_y_hr_int;

    Graficos.definir_cor(est.cor_fundo_padrao);
    Graficos.limpar();

    Graficos.definir_cor(est.sombra_relogio);
    Graficos.desenhar_elipse(est.x_borda_relogio - 10, est.y_borda_relogio - 5, est.tam_borda_relogio, est.tam_borda_relogio, verdadeiro);

    Graficos.definir_cor(Graficos.COR_PRETO);
    Graficos.desenhar_elipse(est.x_borda_relogio, est.y_borda_relogio, est.tam_borda_relogio, est.tam_borda_relogio, verdadeiro);

    Graficos.definir_cor(Graficos.COR_BRANCO);
    Graficos.desenhar_elipse(est.x_relogio, est.y_relogio, est.tam_relogio, est.tam_relogio, verdadeiro);

    para (seja mutavel i = 0; i < 60; i += 1) {
        Graficos.definir_cor(Graficos.COR_PRETO);
        se (!(i % 5 == 0)) {
            Graficos.desenhar_linha(est.centro_x, est.centro_y, est.centro_x + x_min[i], est.centro_y - y_min[i]);
        }
    }

    Graficos.definir_cor(Graficos.COR_BRANCO);
    Graficos.desenhar_elipse(est.x_circulo_min, est.y_circulo_min, est.tam_circulo_min, est.tam_circulo_min, verdadeiro);

    para (seja mutavel i = 0; i < 12; i += 1) {
        Graficos.definir_cor(Graficos.COR_PRETO);
        Graficos.desenhar_linha(est.centro_x, est.centro_y, est.centro_x + x_hr_ext[i], est.centro_y - y_hr_ext[i]);
    }

    Graficos.definir_cor(Graficos.COR_BRANCO);
    Graficos.desenhar_elipse(est.x_circulo_hr, est.y_circulo_hr, est.tam_circulo_hr, est.tam_circulo_hr, verdadeiro);

    seja marca: cadeia = "lite";
    seja deslocamento_marca: inteiro = Tipos.real_para_inteiro(Tipos.inteiro_para_real(est.tam_relogio / 2) * 0.4);
    Graficos.definir_cor(Graficos.COR_PRETO);
    Graficos.definir_tamanho_texto(est.tam_fonte_horas - est.tam_fonte_horas * 0.4);
    Graficos.desenhar_texto(est.centro_x - Graficos.largura_texto(marca) / 2, est.centro_y - deslocamento_marca, marca);
    Graficos.desenhar_retangulo(
    est.centro_x - Graficos.largura_texto(marca) / 2,
    est.centro_y - deslocamento_marca + Graficos.altura_texto(marca),
    Graficos.largura_texto(marca),
    2,
    falso,
    verdadeiro
    );

    // Números das horas
    Graficos.definir_tamanho_texto(est.tam_fonte_horas);
    para (seja mutavel i = 0; i < 12; i += 1) {
        seja mutavel num: cadeia = Tipos.inteiro_para_cadeia(i);
        se (i == 0) {
            num = "12";
        }
        Graficos.desenhar_texto(
        est.centro_x - x_hr_int[i] - Graficos.largura_texto(num) / 2,
        est.centro_y - y_hr_int[i] - Graficos.altura_texto(num) / 2,
        num
        );
    }
}

funcao desenhar_linhas_orientacao(est: EstadoRelogio) {
    seja x_min: vetor < inteiro > = est.coordenadas_x_min;
    seja y_min: vetor < inteiro > = est.coordenadas_y_min;
    seja x_hr_ext: vetor < inteiro > = est.coordenadas_x_hr_ext;
    seja y_hr_ext: vetor < inteiro > = est.coordenadas_y_hr_ext;

    se (est.exibir_linhas_minutos) {
        Graficos.definir_cor(Graficos.COR_AZUL);
        para (seja mutavel i = 0; i < 60; i += 1) {
            Graficos.desenhar_linha(est.centro_x, est.centro_y, est.centro_x + x_min[i], est.centro_y - y_min[i]);
        }
    }

    se (est.exibir_linhas_horas) {
        Graficos.definir_cor(Graficos.COR_VERDE);
        para (seja mutavel i = 0; i < 12; i += 1) {
            Graficos.desenhar_linha(est.centro_x, est.centro_y, est.centro_x + x_hr_ext[i], est.centro_y - y_hr_ext[i]);
        }
    }
}

funcao desenhar_dicas(est: EstadoRelogio) {
    Graficos.definir_tamanho_texto(est.tam_fonte_dicas);

    seja mutavel dica_seg_0: cadeia = "Pressione a tecla 'V' para ativar";
    se (est.exibir_linhas_minutos) {
        dica_seg_0 = "Pressione a tecla 'V' para desativar";
    }
    seja dica_seg_1: cadeia = "as linhas de orientação dos segundos.";

    seja mutavel dica_hr_0: cadeia = "Pressione a tecla 'ESPAÇO' para ativar";
    se (est.exibir_linhas_horas) {
        dica_hr_0 = "Pressione a tecla 'ESPAÇO' para desativar";
    }
    seja dica_hr_1: cadeia = "as linhas de orientação das horas.";
    seja dica_fechar: cadeia = "Pressione a tecla 'ESC' para sair.";

    seja alt_s0: inteiro = Graficos.altura_texto(dica_seg_0);
    seja alt_h0: inteiro = Graficos.altura_texto(dica_hr_0);
    seja alt_h1: inteiro = Graficos.altura_texto(dica_hr_1);
    seja alt_f: inteiro = Graficos.altura_texto(dica_fechar);

    Graficos.definir_cor(est.cor_fundo_dicas);
    Graficos.desenhar_retangulo(5, 10, Graficos.largura_texto(dica_seg_1) + 10, alt_s0 * 2 + 10, verdadeiro, verdadeiro);
    Graficos.desenhar_retangulo(5, est.altura_janela - alt_h0 - alt_h1 - 20, Graficos.largura_texto(dica_hr_0) + 10, alt_h0 + alt_h1 + 10, verdadeiro, verdadeiro);
    Graficos.desenhar_retangulo(est.largura_janela - Graficos.largura_texto(dica_fechar) - 20, 10, Graficos.largura_texto(dica_fechar) + 10, alt_f + 15, verdadeiro, verdadeiro);

    Graficos.definir_cor(Graficos.COR_PRETO);
    Graficos.desenhar_retangulo(5, 10, Graficos.largura_texto(dica_seg_1) + 10, alt_s0 * 2 + 10, verdadeiro, falso);
    Graficos.desenhar_retangulo(5, est.altura_janela - alt_h0 - alt_h1 - 20, Graficos.largura_texto(dica_hr_0) + 10, alt_h0 + alt_h1 + 10, verdadeiro, falso);
    Graficos.desenhar_retangulo(est.largura_janela - Graficos.largura_texto(dica_fechar) - 20, 10, Graficos.largura_texto(dica_fechar) + 10, alt_f + 15, verdadeiro, falso);

    Graficos.desenhar_texto(10, alt_s0, dica_seg_0);
    Graficos.desenhar_texto(10, alt_s0 * 2, dica_seg_1);
    Graficos.desenhar_texto(10, est.altura_janela - alt_h0 - alt_h1 - 15, dica_hr_0);
    Graficos.desenhar_texto(10, est.altura_janela - alt_h1 - 15, dica_hr_1);
    Graficos.desenhar_texto(est.largura_janela - Graficos.largura_texto(dica_fechar) - 15, alt_f + 2, dica_fechar);
}

funcao desenhar(est: EstadoRelogio) {
    seja hora: inteiro = Calendario.hora_atual(verdadeiro) % 12;
    seja minuto: inteiro = Calendario.minuto_atual() % 60;
    seja segundo: inteiro = Calendario.segundo_atual() % 60;

    desenhar_relogio(est);
    desenhar_linhas_orientacao(est);

    // Círculo central preto
    seja tam_central_1: inteiro = 18;
    seja tam_central_2: inteiro = 10;
    Graficos.definir_cor(Graficos.COR_PRETO);
    Graficos.desenhar_elipse(est.centro_x - tam_central_1 / 2, est.centro_y - tam_central_1 / 2, tam_central_1, tam_central_1, verdadeiro);

    // Ponteiro das horas
    seja p_hora: Ponto = calcular_ponteiro_hora(est, hora, minuto);
    para (seja mutavel i = 0; i < 6; i += 1) {
        Graficos.desenhar_linha(est.centro_x - i, est.centro_y, est.centro_x - p_hora.x, est.centro_y - p_hora.y);
        Graficos.desenhar_linha(est.centro_x + i, est.centro_y, est.centro_x - p_hora.x, est.centro_y - p_hora.y);
        Graficos.desenhar_linha(est.centro_x, est.centro_y - i, est.centro_x - p_hora.x, est.centro_y - p_hora.y);
        Graficos.desenhar_linha(est.centro_x, est.centro_y + i, est.centro_x - p_hora.x, est.centro_y - p_hora.y);
    }

    // Ponteiro dos minutos
    seja p_min: Ponto = calcular_ponteiro_minuto(est, minuto, segundo);
    para (seja mutavel i = 0; i < 4; i += 1) {
        Graficos.desenhar_linha(est.centro_x - i, est.centro_y, est.centro_x - p_min.x, est.centro_y - p_min.y);
        Graficos.desenhar_linha(est.centro_x + i, est.centro_y, est.centro_x - p_min.x, est.centro_y - p_min.y);
        Graficos.desenhar_linha(est.centro_x, est.centro_y - i, est.centro_x - p_min.x, est.centro_y - p_min.y);
        Graficos.desenhar_linha(est.centro_x, est.centro_y + i, est.centro_x - p_min.x, est.centro_y - p_min.y);
    }

    // Ponteiro dos segundos
    seja x_seg: vetor < inteiro > = est.coordenadas_x_seg;
    seja y_seg: vetor < inteiro > = est.coordenadas_y_seg;
    Graficos.definir_cor(Graficos.COR_VERMELHO);
    para (seja mutavel i = 0; i < 2; i += 1) {
        Graficos.desenhar_linha(est.centro_x - i, est.centro_y, est.centro_x - x_seg[segundo], est.centro_y - y_seg[segundo]);
        Graficos.desenhar_linha(est.centro_x + i, est.centro_y, est.centro_x - x_seg[segundo], est.centro_y - y_seg[segundo]);
        Graficos.desenhar_linha(est.centro_x, est.centro_y - i, est.centro_x - x_seg[segundo], est.centro_y - y_seg[segundo]);
        Graficos.desenhar_linha(est.centro_x, est.centro_y + i, est.centro_x - x_seg[segundo], est.centro_y - y_seg[segundo]);
    }

    // Círculo central vermelho
    Graficos.desenhar_elipse(est.centro_x - tam_central_2 / 2, est.centro_y - tam_central_2 / 2, tam_central_2, tam_central_2, verdadeiro);

    desenhar_dicas(est);
}

funcao inicio() {
    seja mutavel estado: EstadoRelogio = inicializar();

    enquanto (verdadeiro) {
        desenhar(estado);
        Graficos.renderizar();

        se (Teclado.tecla_pressionada(Teclado.TECLA_ESPACO)) {
            estado.exibir_linhas_horas = !estado.exibir_linhas_horas;
            enquanto (Teclado.alguma_tecla_pressionada()) {
                Util.aguarde(16);
            }
        }

        se (Teclado.tecla_pressionada(Teclado.TECLA_V)) {
            estado.exibir_linhas_minutos = !estado.exibir_linhas_minutos;
            enquanto (Teclado.alguma_tecla_pressionada()) {
                Util.aguarde(16);
            }
        }

        se (Teclado.tecla_pressionada(Teclado.TECLA_ESC)) {
            pare;
        }

        Util.aguarde(30);
    }

    Graficos.encerrar_modo_grafico();
}
