 * desde que este cabeçalho, contendo os direitos autorais e a descrição do programa,
 * seja mantido.
 *
 * Descrição:
 *
 *   Reprodutor de música interativo com playlist, barra de progresso, controle de
 *   volume, alternância de temas visuais, repetição de playlist e visualizador
 *   espectral animado.
 *
 *   Demonstra o uso da biblioteca "Sons" com tratamento seguro de `Resultado` e
 *   `Opcao`: caso os arquivos MP3 de demonstração não estejam presentes, o player
 *   mantém a simulação de reprodução e todos os controles ativos.
 *
 * Adaptado do exemplo clássico "musica/player.por" para Portugol-RS (.pors)
 */

enum TemaPlayer {
    Escuro,
    Oceano,
    Ametista,
}

registro Faixa {
    titulo: cadeia,
    artista: cadeia,
    caminho: cadeia,
    duracao_ms: inteiro,
}

registro EstadoPlayer {
    faixas: vetor < Faixa >,
    indice_atual: inteiro,
    tocando: logico,
    repetir_playlist: logico,
    mostrar_playlist: logico,
    mudo: logico,
    volume: inteiro,
    posicao_ms: inteiro,
    som_id: Opcao < inteiro >,
    reproducao_id: Opcao < inteiro >,
    audio_real: logico,
    tema: TemaPlayer,
    quadro: inteiro,
    mouse_estava: logico,
    espaco_estava: logico,
    dir_estava: logico,
    esq_estava: logico,
    v_estava: logico,
    t_estava: logico,
    r_estava: logico,
    p_estava: logico,
}

funcao cor_rgb(r: inteiro, g: inteiro, b: inteiro) -> inteiro {
    escolha Graficos.criar_cor(r, g, b) {
        caso Resultado::Ok(cor) => {
            retorne cor;
        }
        caso Resultado::Erro(_) => {
            retorne Graficos.COR_BRANCO;
        }
    }
}

funcao cor_fundo_tema(tema: TemaPlayer) -> inteiro {
    escolha tema {
        caso TemaPlayer::Escuro => {
            retorne cor_rgb(26, 28, 34);
        }
        caso TemaPlayer::Oceano => {
            retorne cor_rgb(18, 36, 52);
        }
        caso TemaPlayer::Ametista => {
            retorne cor_rgb(38, 22, 52);
        }
    }
}

funcao cor_destaque_tema(tema: TemaPlayer) -> inteiro {
    escolha tema {
        caso TemaPlayer::Escuro => {
            retorne cor_rgb(56, 210, 145);
        }
        caso TemaPlayer::Oceano => {
            retorne cor_rgb(72, 185, 255);
        }
        caso TemaPlayer::Ametista => {
            retorne cor_rgb(215, 115, 255);
        }
    }
}

funcao proximo_tema(tema: TemaPlayer) -> TemaPlayer {
    escolha tema {
        caso TemaPlayer::Escuro => {
            retorne TemaPlayer::Oceano;
        }
        caso TemaPlayer::Oceano => {
            retorne TemaPlayer::Ametista;
        }
        caso TemaPlayer::Ametista => {
            retorne TemaPlayer::Escuro;
        }
    }
}

funcao nome_tema(tema: TemaPlayer) -> cadeia {
    escolha tema {
        caso TemaPlayer::Escuro => {
            retorne "Escuro";
        }
        caso TemaPlayer::Oceano => {
            retorne "Oceano";
        }
        caso TemaPlayer::Ametista => {
            retorne "Ametista";
        }
    }
}

funcao formatar_tempo(ms: inteiro) -> cadeia {
    seja total_seg: inteiro = ms / 1000;
    seja minutos: inteiro = total_seg / 60;
    seja segundos: inteiro = total_seg % 60;
    seja min_str: cadeia = Texto.preencher_a_esquerda('0', 2, Tipos.inteiro_para_cadeia(minutos));
    seja seg_str: cadeia = Texto.preencher_a_esquerda('0', 2, Tipos.inteiro_para_cadeia(segundos));
    retorne min_str + ":" + seg_str;
}

funcao criar_playlist_padrao() -> vetor < Faixa > {
    seja mutavel lista: vetor < Faixa > = [];
    adicionar(lista, Faixa {
        titulo: "Buddy (Demo)",
        artista: "Bensound",
        caminho: "player/bensound-buddy.mp3",
        duracao_ms: 122000,
    }
    );
    adicionar(lista, Faixa {
        titulo: "Ritmo em Portugol",
        artista: "Estudio UNIVALI",
        caminho: "player/ritmo_portugol.mp3",
        duracao_ms: 95000,
    }
    );
    adicionar(lista, Faixa {
        titulo: "Sintetizador Retro",
        artista: "Chipset 8-bit",
        caminho: "player/sintetizador_retro.mp3",
        duracao_ms: 140000,
    }
    );
    adicionar(lista, Faixa {
        titulo: "Noturno Acustico",
        artista: "Colecao Classica",
        caminho: "player/noturno_acustico.mp3",
        duracao_ms: 110000,
    }
    );
    retorne lista;
}

funcao encerrar_som_atual(estado: EstadoPlayer) -> EstadoPlayer {
    seja mutavel novo: EstadoPlayer = estado;
    escolha novo.reproducao_id {
        caso Opcao::Algum(rep) => {
            Sons.interromper_som(rep);
        }
        caso Opcao::Nenhum => {}
    }
    escolha novo.som_id {
        caso Opcao::Algum(som) => {
            Sons.liberar_som(som);
        }
        caso Opcao::Nenhum => {}
    }
    novo.reproducao_id = Opcao::Nenhum;
    novo.som_id = Opcao::Nenhum;
    novo.audio_real = falso;
    retorne novo;
}

funcao carregar_faixa_atual(estado: EstadoPlayer) -> EstadoPlayer {
    seja mutavel novo: EstadoPlayer = encerrar_som_atual(estado);
    novo.posicao_ms = 0;

    seja faixas: vetor < Faixa > = novo.faixas;
    seja faixa: Faixa = faixas[novo.indice_atual];
    escolha Sons.carregar_som(faixa.caminho) {
        caso Resultado::Ok(som_id) => {
            novo.som_id = Opcao::Algum(som_id);
            novo.audio_real = verdadeiro;
            se (novo.tocando) {
                escolha Sons.reproduzir_som(som_id, falso) {
                    caso Resultado::Ok(rep_id) => {
                        novo.reproducao_id = Opcao::Algum(rep_id);
                        se (novo.mudo) {
                            Sons.definir_volume_reproducao(rep_id, 0);
                        } senao {
                            Sons.definir_volume_reproducao(rep_id, novo.volume);
                        }
                    }
                    caso Resultado::Erro(_) => {}
                }
            }
        }
        caso Resultado::Erro(_) => {
            novo.som_id = Opcao::Nenhum;
            novo.reproducao_id = Opcao::Nenhum;
            novo.audio_real = falso;
        }
    }

    retorne novo;
}

funcao alternar_reproducao(estado: EstadoPlayer) -> EstadoPlayer {
    seja mutavel novo: EstadoPlayer = estado;
    novo.tocando = !novo.tocando;
    se (novo.audio_real) {
        se (novo.tocando) {
            escolha novo.som_id {
                caso Opcao::Algum(som_id) => {
                    escolha Sons.reproduzir_som(som_id, falso) {
                        caso Resultado::Ok(rep_id) => {
                            novo.reproducao_id = Opcao::Algum(rep_id);
                            se (novo.mudo) {
                                Sons.definir_volume_reproducao(rep_id, 0);
                            } senao {
                                Sons.definir_volume_reproducao(rep_id, novo.volume);
                            }
                        }
                        caso Resultado::Erro(_) => {}
                    }
                }
                caso Opcao::Nenhum => {}
            }
        } senao {
            escolha novo.reproducao_id {
                caso Opcao::Algum(rep_id) => {
                    Sons.pausar_som(rep_id);
                }
                caso Opcao::Nenhum => {}
            }
        }
    }
    retorne novo;
}

funcao aplicar_volume(estado: EstadoPlayer) {
    seja vol: inteiro = estado.volume;
    se (estado.mudo) {
        Sons.definir_volume(0);
    } senao {
        Sons.definir_volume(vol);
    }
    escolha estado.reproducao_id {
        caso Opcao::Algum(rep_id) => {
            se (estado.mudo) {
                Sons.definir_volume_reproducao(rep_id, 0);
            } senao {
                Sons.definir_volume_reproducao(rep_id, vol);
            }
        }
        caso Opcao::Nenhum => {}
    }
}

funcao proxima_faixa(estado: EstadoPlayer) -> EstadoPlayer {
    seja mutavel novo: EstadoPlayer = estado;
    seja faixas: vetor < Faixa > = novo.faixas;
    seja total: inteiro = tamanho(faixas);
    novo.indice_atual = (novo.indice_atual + 1) % total;
    retorne carregar_faixa_atual(novo);
}

funcao faixa_anterior(estado: EstadoPlayer) -> EstadoPlayer {
    seja mutavel novo: EstadoPlayer = estado;
    seja faixas: vetor < Faixa > = novo.faixas;
    seja total: inteiro = tamanho(faixas);
    novo.indice_atual = (novo.indice_atual - 1 + total) % total;
    retorne carregar_faixa_atual(novo);
}

funcao ponto_no_retangulo(px: inteiro, py: inteiro, x: inteiro, y: inteiro, largura: inteiro, altura: inteiro) -> logico {
    retorne px >= x && px <= x + largura && py >= y && py <= y + altura;
}

funcao processar_entrada(estado: EstadoPlayer) -> EstadoPlayer {
    seja mutavel novo: EstadoPlayer = estado;

    seja espaco: logico = Teclado.tecla_pressionada(Teclado.TECLA_ESPACO);
    se (espaco && !novo.espaco_estava) {
        novo = alternar_reproducao(novo);
    }
    novo.espaco_estava = espaco;

    seja dir: logico = Teclado.tecla_pressionada(Teclado.TECLA_SETA_DIREITA);
    se (dir && !novo.dir_estava) {
        novo = proxima_faixa(novo);
    }
    novo.dir_estava = dir;

    seja esq: logico = Teclado.tecla_pressionada(Teclado.TECLA_SETA_ESQUERDA);
    se (esq && !novo.esq_estava) {
        novo = faixa_anterior(novo);
    }
    novo.esq_estava = esq;

    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_ACIMA)) {
        se (novo.volume < 100) {
            novo.volume += 1;
            novo.mudo = falso;
            aplicar_volume(novo);
        }
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_ABAIXO)) {
        se (novo.volume > 0) {
            novo.volume -= 1;
            aplicar_volume(novo);
        }
    }

    seja tv: logico = Teclado.tecla_pressionada(Teclado.TECLA_V);
    se (tv && !novo.v_estava) {
        novo.mudo = !novo.mudo;
        aplicar_volume(novo);
    }
    novo.v_estava = tv;

    seja tt: logico = Teclado.tecla_pressionada(Teclado.TECLA_T);
    se (tt && !novo.t_estava) {
        novo.tema = proximo_tema(novo.tema);
    }
    novo.t_estava = tt;

    seja tr: logico = Teclado.tecla_pressionada(Teclado.TECLA_R);
    se (tr && !novo.r_estava) {
        novo.repetir_playlist = !novo.repetir_playlist;
    }
    novo.r_estava = tr;

    seja tp: logico = Teclado.tecla_pressionada(Teclado.TECLA_P);
    se (tp && !novo.p_estava) {
        novo.mostrar_playlist = !novo.mostrar_playlist;
    }
    novo.p_estava = tp;

    seja clicando: logico = Mouse.botao_pressionado(Mouse.BOTAO_ESQUERDO);
    se (clicando && !novo.mouse_estava) {
        seja mx: inteiro = Mouse.posicao_x();
        seja my: inteiro = Mouse.posicao_y();

        // Controles da barra inferior (y = 515)
        se (ponto_no_retangulo(mx, my, 24, 512, 46, 36)) {
            novo = faixa_anterior(novo);
        }
        se (ponto_no_retangulo(mx, my, 78, 512, 74, 36)) {
            novo = alternar_reproducao(novo);
        }
        se (ponto_no_retangulo(mx, my, 160, 512, 46, 36)) {
            novo = proxima_faixa(novo);
        }

        // Barra de progresso (x=220..520, y=520..540)
        se (ponto_no_retangulo(mx, my, 220, 516, 300, 28)) {
            seja faixas: vetor < Faixa > = novo.faixas;
            seja faixa: Faixa = faixas[novo.indice_atual];
            seja proporcao: real = Tipos.inteiro_para_real(mx - 220) / 300.0;
            novo.posicao_ms = Tipos.real_para_inteiro(proporcao * Tipos.inteiro_para_real(faixa.duracao_ms));
            escolha novo.som_id {
                caso Opcao::Algum(sid) => {
                    escolha Sons.definir_posicao_atual_musica(sid, novo.posicao_ms) {
                        caso Resultado::Ok(_) => {}
                        caso Resultado::Erro(_) => {}
                    }
                }
                caso Opcao::Nenhum => {}
            }
        }

        // Barra de volume (x=610..710, y=516..544)
        se (ponto_no_retangulo(mx, my, 610, 516, 100, 28)) {
            novo.volume = mx - 610;
            novo.mudo = falso;
            aplicar_volume(novo);
        }

        // Botões Tema / Repetir / Playlist no topo
        se (ponto_no_retangulo(mx, my, 490, 20, 96, 30)) {
            novo.tema = proximo_tema(novo.tema);
        }
        se (ponto_no_retangulo(mx, my, 596, 20, 92, 30)) {
            novo.repetir_playlist = !novo.repetir_playlist;
        }
        se (ponto_no_retangulo(mx, my, 698, 20, 82, 30)) {
            novo.mostrar_playlist = !novo.mostrar_playlist;
        }

        // Cliques nos itens da playlist lateral
        se (novo.mostrar_playlist) {
            seja faixas_lista: vetor < Faixa > = novo.faixas;
            seja total_faixas: inteiro = tamanho(faixas_lista);
            para (seja mutavel i = 0; i < total_faixas; i += 1) {
                seja iy: inteiro = 112 + i * 58;
                se (ponto_no_retangulo(mx, my, 536, iy, 244, 50)) {
                    novo.indice_atual = i;
                    novo.tocando = verdadeiro;
                    novo = carregar_faixa_atual(novo);
                }
            }
        }
    }
    novo.mouse_estava = clicando;

    retorne novo;
}

funcao desenhar_botao(x: inteiro, y: inteiro, largura: inteiro, altura: inteiro, texto: cadeia, destaque: logico, cor_dest: inteiro) {
    se (destaque) {
        Graficos.definir_cor(cor_dest);
    } senao {
        Graficos.definir_cor(cor_rgb(54, 58, 70));
    }
    Graficos.desenhar_retangulo(x, y, largura, altura, verdadeiro, verdadeiro);
    se (destaque) {
        Graficos.definir_cor(cor_rgb(16, 18, 24));
    } senao {
        Graficos.definir_cor(Graficos.COR_BRANCO);
    }
    Graficos.definir_tamanho_texto(13.0);
    seja lw: inteiro = Graficos.largura_texto(texto);
    Graficos.desenhar_texto(x + (largura - lw) / 2, y + altura / 2 - 7, texto);
}

funcao desenhar(estado: EstadoPlayer) {
    seja fundo: inteiro = cor_fundo_tema(estado.tema);
    seja destaque: inteiro = cor_destaque_tema(estado.tema);
    seja painel: inteiro = cor_rgb(36, 40, 50);
    seja faixas: vetor < Faixa > = estado.faixas;
    seja faixa: Faixa = faixas[estado.indice_atual];

    Graficos.definir_cor(fundo);
    Graficos.limpar();

    // Barra superior
    Graficos.definir_cor(painel);
    Graficos.desenhar_retangulo(0, 0, 800, 68, falso, verdadeiro);
    Graficos.definir_cor(destaque);
    Graficos.definir_tamanho_texto(22.0);
    Graficos.desenhar_texto(24, 18, "PLAYER PORTUGOL-RS");
    Graficos.definir_cor(cor_rgb(175, 182, 198));
    Graficos.definir_tamanho_texto(12.0);
    Graficos.desenhar_texto(24, 46, "Tema: " + nome_tema(estado.tema) + " | [ESPACO] Play/Pause [Setas] Faixa/Vol [V] Mudo [T] Tema [ESC] Sair");

    desenhar_botao(490, 20, 96, 30, "Tema (T)", falso, destaque);
    desenhar_botao(596, 20, 92, 30, "Repetir", estado.repetir_playlist, destaque);
    desenhar_botao(698, 20, 82, 30, "Lista", estado.mostrar_playlist, destaque);

    // Área principal do reprodutor
    seja mutavel largura_area: inteiro = 752;
    se (estado.mostrar_playlist) {
        largura_area = 496;
    }

    Graficos.definir_cor(painel);
    Graficos.desenhar_retangulo(24, 86, largura_area, 396, verdadeiro, verdadeiro);

    // Disco giratório decorativo
    seja cx: inteiro = 24 + largura_area / 2;
    seja cy: inteiro = 205;
    Graficos.definir_cor(cor_rgb(20, 22, 28));
    Graficos.desenhar_elipse(cx - 72, cy - 72, 144, 144, verdadeiro);
    Graficos.definir_cor(destaque);
    Graficos.desenhar_elipse(cx - 72, cy - 72, 144, 144, falso);
    Graficos.desenhar_elipse(cx - 26, cy - 26, 52, 52, verdadeiro);
    Graficos.definir_cor(cor_rgb(20, 22, 28));
    Graficos.desenhar_elipse(cx - 8, cy - 8, 16, 16, verdadeiro);

    // Indicador de rotação do disco
    seja angulo: real = Tipos.inteiro_para_real(estado.quadro) * 0.08;
    seja px: inteiro = cx + Tipos.real_para_inteiro(Matematica.cosseno(angulo) * 48.0);
    seja py: inteiro = cy + Tipos.real_para_inteiro(Matematica.seno(angulo) * 48.0);
    Graficos.definir_cor(Graficos.COR_BRANCO);
    Graficos.desenhar_elipse(px - 4, py - 4, 8, 8, verdadeiro);

    // Título e artista
    Graficos.definir_cor(Graficos.COR_BRANCO);
    Graficos.definir_tamanho_texto(20.0);
    seja lw_tit: inteiro = Graficos.largura_texto(faixa.titulo);
    Graficos.desenhar_texto(cx - lw_tit / 2, 294, faixa.titulo);

    Graficos.definir_cor(cor_rgb(175, 182, 198));
    Graficos.definir_tamanho_texto(14.0);
    seja lw_art: inteiro = Graficos.largura_texto(faixa.artista);
    Graficos.desenhar_texto(cx - lw_art / 2, 322, faixa.artista);

    // Visualizador de barras espectrais
    seja num_barras: inteiro = 24;
    seja inicio_eq: inteiro = cx - (num_barras * 14) / 2;
    para (seja mutavel b = 0; b < num_barras; b += 1) {
        seja mutavel altura_barra: inteiro = 8;
        se (estado.tocando) {
            seja fase: real = Tipos.inteiro_para_real(estado.quadro) * 0.16 + Tipos.inteiro_para_real(b) * 0.45;
            seja onda: real = Matematica.valor_absoluto(Matematica.seno(fase)) * 62.0;
            altura_barra = 12 + Tipos.real_para_inteiro(onda);
        }
        Graficos.definir_cor(destaque);
        Graficos.desenhar_retangulo(inicio_eq + b * 14, 444 - altura_barra, 10, altura_barra, verdadeiro, verdadeiro);
    }

    // Status de áudio
    Graficos.definir_cor(cor_rgb(150, 158, 174));
    Graficos.definir_tamanho_texto(12.0);
    se (estado.audio_real) {
        Graficos.desenhar_texto(40, 456, "Audio ativo: " + faixa.caminho);
    } senao {
        Graficos.desenhar_texto(40, 456, "Modo demonstracao visual (arquivo MP3 nao encontrado: " + faixa.caminho + ")");
    }

    // Playlist lateral
    se (estado.mostrar_playlist) {
        Graficos.definir_cor(painel);
        Graficos.desenhar_retangulo(530, 86, 256, 396, verdadeiro, verdadeiro);
        Graficos.definir_cor(destaque);
        Graficos.definir_tamanho_texto(15.0);
        Graficos.desenhar_texto(544, 94, "PLAYLIST");

        seja total_faixas: inteiro = tamanho(faixas);
        para (seja mutavel i = 0; i < total_faixas; i += 1) {
            seja item: Faixa = faixas[i];
            seja iy: inteiro = 118 + i * 58;
            se (i == estado.indice_atual) {
                Graficos.definir_cor(cor_rgb(56, 68, 86));
            } senao {
                Graficos.definir_cor(cor_rgb(44, 48, 60));
            }
            Graficos.desenhar_retangulo(540, iy, 236, 48, verdadeiro, verdadeiro);

            se (i == estado.indice_atual) {
                Graficos.definir_cor(destaque);
            } senao {
                Graficos.definir_cor(Graficos.COR_BRANCO);
            }
            Graficos.definir_tamanho_texto(13.0);
            Graficos.desenhar_texto(550, iy + 8, Tipos.inteiro_para_cadeia(i + 1) + ". " + item.titulo);

            Graficos.definir_cor(cor_rgb(165, 170, 185));
            Graficos.definir_tamanho_texto(11.0);
            Graficos.desenhar_texto(550, iy + 27, item.artista + " - " + formatar_tempo(item.duracao_ms));
        }
    }

    // Barra inferior de transporte e volume
    Graficos.definir_cor(cor_rgb(20, 22, 28));
    Graficos.desenhar_retangulo(0, 498, 800, 72, falso, verdadeiro);

    desenhar_botao(24, 512, 46, 36, "<<", falso, destaque);
    se (estado.tocando) {
        desenhar_botao(78, 512, 74, 36, "PAUSA", verdadeiro, destaque);
    } senao {
        desenhar_botao(78, 512, 74, 36, "TOCAR", falso, destaque);
    }
    desenhar_botao(160, 512, 46, 36, ">>", falso, destaque);

    // Barra de progresso
    Graficos.definir_cor(cor_rgb(66, 70, 84));
    Graficos.desenhar_retangulo(220, 526, 300, 8, verdadeiro, verdadeiro);
    seja mutavel progresso = 0;
    se (faixa.duracao_ms > 0) {
        progresso = (estado.posicao_ms * 300) / faixa.duracao_ms;
    }
    se (progresso > 300) {
        progresso = 300;
    }
    Graficos.definir_cor(destaque);
    Graficos.desenhar_retangulo(220, 526, progresso, 8, verdadeiro, verdadeiro);
    Graficos.desenhar_elipse(220 + progresso - 6, 524, 12, 12, verdadeiro);

    Graficos.definir_cor(cor_rgb(200, 205, 220));
    Graficos.definir_tamanho_texto(12.0);
    Graficos.desenhar_texto(528, 523, formatar_tempo(estado.posicao_ms) + "/" + formatar_tempo(faixa.duracao_ms));

    // Volume
    Graficos.definir_cor(cor_rgb(66, 70, 84));
    Graficos.desenhar_retangulo(610, 526, 100, 8, verdadeiro, verdadeiro);
    se (!estado.mudo) {
        Graficos.definir_cor(destaque);
        Graficos.desenhar_retangulo(610, 526, estado.volume, 8, verdadeiro, verdadeiro);
    }
    Graficos.definir_cor(Graficos.COR_BRANCO);
    se (estado.mudo) {
        Graficos.desenhar_texto(718, 523, "MUDO");
    } senao {
        Graficos.desenhar_texto(718, 523, "Vol " + Tipos.inteiro_para_cadeia(estado.volume) + "%");
    }

    Graficos.renderizar();
}

funcao inicio() {
    Graficos.iniciar_modo_grafico(verdadeiro);
    Graficos.definir_dimensoes_janela(800, 570);
    Graficos.definir_titulo_janela("Player de Musica - Portugol-RS");

    seja mutavel estado: EstadoPlayer = EstadoPlayer {
        faixas: criar_playlist_padrao(),
        indice_atual: 0,
        tocando: verdadeiro,
        repetir_playlist: verdadeiro,
        mostrar_playlist: verdadeiro,
        mudo: falso,
        volume: 80,
        posicao_ms: 0,
        som_id: Opcao::Nenhum,
        reproducao_id: Opcao::Nenhum,
        audio_real: falso,
        tema: TemaPlayer::Escuro,
        quadro: 0,
        mouse_estava: falso,
        espaco_estava: falso,
        dir_estava: falso,
        esq_estava: falso,
        v_estava: falso,
        t_estava: falso,
        r_estava: falso,
        p_estava: falso,
    }
    ;

    estado = carregar_faixa_atual(estado);
    aplicar_volume(estado);

    seja mutavel ultimo_tempo: inteiro = Util.tempo_decorrido();

    enquanto (!Teclado.tecla_pressionada(Teclado.TECLA_ESC)) {
        seja agora: inteiro = Util.tempo_decorrido();
        seja delta: inteiro = agora - ultimo_tempo;
        ultimo_tempo = agora;

        estado = processar_entrada(estado);

        se (estado.tocando) {
            estado.quadro += 1;
            se (estado.audio_real) {
                escolha estado.som_id {
                    caso Opcao::Algum(sid) => {
                        estado.posicao_ms = Sons.obter_posicao_atual_musica(sid);
                    }
                    caso Opcao::Nenhum => {
                        estado.posicao_ms += delta;
                    }
                }
            } senao {
                estado.posicao_ms += delta;
            }

            seja faixas_loop: vetor < Faixa > = estado.faixas;
            seja total_loop: inteiro = tamanho(faixas_loop);
            seja faixa_atual: Faixa = faixas_loop[estado.indice_atual];
            se (estado.posicao_ms >= faixa_atual.duracao_ms) {
                se (estado.indice_atual + 1 < total_loop || estado.repetir_playlist) {
                    estado = proxima_faixa(estado);
                } senao {
                    estado.tocando = falso;
                    estado.posicao_ms = faixa_atual.duracao_ms;
                }
            }
        }

        desenhar(estado);
        Util.aguarde(16);
    }

    estado = encerrar_som_atual(estado);
    Graficos.encerrar_modo_grafico();
}
