 * desde que este cabeçalho, contendo os direitos autorais e a descrição do programa,
 * seja mantido.
 *
 * Descrição:
 *
 *     Este exemplo pede ao usuário que informe um valor inteiro; logo após, exibe uma
 *     mensagem indicando se o número informado é múltiplo de 5 ou não.
 *
 * Autores:
 *
 *     Giordana Maria da Costa Valle
 *     Carlos Alexandre Krueger
 *
 * Data: 01/06/2013
 */

funcao inicio() {
    escreva("Digite um número: ");
    seja mutavel numero: inteiro = leia();

    /*
     * Para verificar se um número é múltiplo de outro utiliza-se a operação
     * módulo, representada no Portugol-RS pelo operador %.
     *
     * Se o resultado da operação for 0, então um número é múltiplo do outro.
     */
    escreval();

    se (numero % 5 == 0) {
        escreva("O número ", numero, " é múltiplo de 5");
    } senao {
        escreva("O número ", numero, " não é múltiplo de 5");
    }

    escreval();
}
