 *
 * Descrição:
 *
 * 	Este exemplo utiliza a biblioteca "Arquivos" para ler todas as linhas de um arquivo
 * 	de texto contendo o placar de um jogo e exibi-lo para o usuário.
 *
 * Autores:
 *
 * 	Luiz Fernando Noschang (noschang@univali.br)
 *
 * Data: 10/02/2016
 * Adaptado para Ferro (.fer)
 */

funcao garantir_placar_exemplo(caminho: cadeia) -> Resultado < logico, cadeia > {
    seja ja_existe: logico = Arquivos.existe(caminho)?;
    se (!ja_existe) {
        seja conteudo: cadeia = "  1| João    | 1250 pontos\n"
        + "  2| Julia   | 1157 pontos\n"
        + "  3| Rafael  |  981 pontos\n"
        + "  4| Alisson |  965 pontos\n"
        + "  5| Marcos  |  810 pontos\n"
        + "  6| Maria   |  805 pontos\n"
        + "  7| Jéssica |  756 pontos\n"
        + "  8| Paulo   |  732 pontos\n"
        + "  9| Gustavo |  640 pontos\n"
        + " 10| Luiz    |  500 pontos\n";
        seja _ok: logico = Arquivos.escrever_texto(caminho, conteudo)?;
    }
    retorne Resultado::Ok(verdadeiro);
}

funcao ler_placar(caminho: cadeia) -> Resultado < vetor < cadeia >, cadeia > {
    seja _pronto: logico = garantir_placar_exemplo(caminho)?;
    // Em Ferro, ler_linhas carrega todas as linhas do arquivo de forma segura
    seja linhas: vetor < cadeia > = Arquivos.ler_linhas(caminho)?;
    retorne Resultado::Ok(linhas);
}

funcao inicio() {
    // Caminhos em Ferro são relativos ao workspace configurado
    seja caminho_do_arquivo: cadeia = "placar.txt";

    escolha ler_placar(caminho_do_arquivo) {
        caso Resultado::Ok(linhas) => {
            para (seja mutavel i = 0; i < tamanho(linhas); i += 1) {
                escreval("Linha ", i + 1, ": ", linhas[i]);
            }
        }
        caso Resultado::Erro(erro) => {
            escreval("Erro ao ler arquivo: ", erro);
        }
    }
}
