 * seja mantido.
 *
 * Descrição:
 *
 * 	Este exemplo demonstra o uso da constante "PI" da biblioteca "Matematica". Neste
 * 	exemplo, a constante é utilizada para calcular a área de uma circunferência.
 *
 * Autores:
 *
 * 	Luiz Fernando Noschang (noschang@univali.br)
 *
 * Data: 18/07/2014
 * Adaptado para Portugol-RS (.pors)
 */

funcao inicio() {
    seja mutavel area: real = 0.0;

    escreva("Informe o raio da circunferência em cm: ");
    seja mutavel raio: real = leia();

    // Calcula a área da circunferência utilizando a constante PI da biblioteca
    area = Matematica.PI * Matematica.potencia(raio, 2.0);

    // Arredonda o resultado para 2 casas decimais para facilitar a visualização
    area = Matematica.arredondar(area, 2);

    escreva("\nO valor de PI é: ", Matematica.PI);
    escreval("\nA área da circunferência é: ", area, " cm²");
}
