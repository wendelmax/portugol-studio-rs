{
  "schema_version": 1,
  "id": "ferro-02-maior-de-dois",
  "title": "Maior de dois inteiros",
  "statement": "Leia dois números inteiros e escreva apenas o maior entre eles.",
  "starter_code": "funcao inicio() {\n    seja mutavel a: inteiro = leia();\n    seja mutavel b: inteiro = leia();\n    escreva(a);\n}\n",
  "hints": [
    "Use se (a >= b) { escreva(a); } senao { escreva(b); }."
  ],
  "cases": [
    { "name": "primeiro maior", "input": "15\n9\n", "expected_output": "15" },
    { "name": "segundo maior", "input": "4\n12\n", "expected_output": "12" },
    { "name": "iguais", "input": "7\n7\n", "expected_output": "7" }
  ]
}
