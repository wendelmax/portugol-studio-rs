funcao testar_cadeia_logica(texto: cadeia) {
    se (Tipos.cadeia_e_logico(texto)) {
        escolha Tipos.para_logico(texto) {
            caso Resultado::Ok(valor) => {
                escreval("A cadeia \"", texto, "\" representa o lógico: ", valor);
                escreval("  -> em cadeia: ", Tipos.logico_para_cadeia(valor));
                escreval("  -> em inteiro: ", Tipos.logico_para_inteiro(valor));
            }
            caso Resultado::Erro(erro) => {
                escreval("Erro ao converter \"", texto, "\": ", erro);
            }
        }
    } senao {
        escreval("A cadeia \"", texto, "\" não representa um valor lógico");
    }
}

funcao inicio() {
    // Verifica e converte diferentes cadeias para o tipo lógico
    testar_cadeia_logica("verdadeiro");
    testar_cadeia_logica("falso");
    testar_cadeia_logica("talvez");
}
