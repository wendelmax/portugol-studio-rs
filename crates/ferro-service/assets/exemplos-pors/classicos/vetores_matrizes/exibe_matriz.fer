 * desde que este cabeçalho, contendo os direitos autorais e a descrição do programa,
 * seja mantido.
 *
 * Descrição:
 *
 *     Este exemplo cria e exibe uma matriz de números aleatórios para ilustrar
 *     como matrizes bidimensionais são representadas no Ferro usando um
 *     vetor linear (vetor<inteiro>) indexado por `linha * colunas + coluna`.
 *
 * Autores:
 *
 *     Giordana Maria da Costa Valle
 *     Carlos Alexandre Krueger
 *
 * Data: 01/06/2013
 */

funcao sortear(minimo: inteiro, maximo: inteiro) -> inteiro {
    escolha Util.sorteia(minimo, maximo) {
        caso Resultado::Ok(valor) => {
            retorne valor;
        }
        caso Resultado::Erro(_) => {
            retorne minimo;
        }
    }
}

funcao inicio() {
    // Define as dimensões (linhas e colunas) da matriz
    seja TAMANHO: inteiro = 5;

    // Representa a matriz TAMANHO x TAMANHO como um vetor linear
    seja mutavel matriz: vetor < inteiro > = [];

    para (seja mutavel linha = 0; linha < TAMANHO; linha += 1) {
        para (seja mutavel coluna = 0; coluna < TAMANHO; coluna += 1) {
            // Atribui um valor aleatório à posição da matriz
            adicionar(matriz, sortear(1, 9));
            // Exibe o valor contido na posição (linha, coluna)
            escreva("[", matriz[linha * TAMANHO + coluna], "]");
        }
        escreval();
    }
}
