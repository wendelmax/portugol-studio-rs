 *
 * Descrição:
 *
 *   Este exemplo demonstra como utilizar as funções básicas da biblioteca
 *   Graficos para iniciar o ambiente gráfico, configurar a janela, desenhar
 *   formas geométricas e encerrar o modo gráfico corretamente.
 *
 * Autores:
 *
 *   Luiz Fernando Noschang (noschang@univali.br)
 *   Adaptado e implementado para Portugol-RS (.pors)
 *
 * Data: 18/07/2014
 */

funcao cor_rgb(r: inteiro, g: inteiro, b: inteiro) -> inteiro {
    escolha Graficos.criar_cor(r, g, b) {
        caso Resultado::Ok(cor) => {
            retorne cor;
        }
        caso Resultado::Erro(_) => {
            retorne Graficos.COR_PRETO;
        }
    }
}

funcao inicio() {
    Graficos.iniciar_modo_grafico(verdadeiro);
    Graficos.definir_dimensoes_janela(640, 480);
    Graficos.definir_titulo_janela("Iniciando o Modo Gráfico");

    seja cor_fundo: inteiro = cor_rgb(24, 34, 52);
    seja cor_cartao: inteiro = cor_rgb(38, 52, 78);
    seja cor_destaque: inteiro = cor_rgb(80, 200, 140);

    enquanto (!Teclado.tecla_pressionada(Teclado.TECLA_ESC)) {
        Graficos.definir_cor(cor_fundo);
        Graficos.limpar();

        // Cartão central
        Graficos.definir_cor(cor_cartao);
        Graficos.desenhar_retangulo(60, 50, 520, 380, verdadeiro, verdadeiro);

        // Título
        Graficos.definir_cor(Graficos.COR_BRANCO);
        Graficos.definir_tamanho_texto(26.0);
        Graficos.definir_estilo_texto(falso, verdadeiro, falso);
        Graficos.desenhar_texto(115, 85, "Bem-vindo ao Modo Gráfico!");

        // Formas básicas
        Graficos.definir_cor(cor_destaque);
        Graficos.desenhar_retangulo(115, 160, 110, 110, verdadeiro, verdadeiro);

        Graficos.definir_cor(cor_rgb(255, 190, 70));
        Graficos.desenhar_elipse(265, 160, 110, 110, verdadeiro);

        Graficos.definir_cor(cor_rgb(95, 170, 255));
        Graficos.desenhar_retangulo(415, 160, 110, 110, falso, falso);
        Graficos.desenhar_linha(415, 160, 525, 270);
        Graficos.desenhar_linha(525, 160, 415, 270);

        // Rodapé informativo
        Graficos.definir_cor(cor_rgb(200, 215, 235));
        Graficos.definir_tamanho_texto(16.0);
        Graficos.definir_estilo_texto(falso, falso, falso);
        Graficos.desenhar_texto(135, 340, "Pressione ESC para encerrar o modo gráfico.");

        Graficos.renderizar();
        Util.aguarde(16);
    }

    Graficos.encerrar_modo_grafico();
}
