 *
 * Descrição:
 *
 * 	Este exemplo demonstra como utilizar a função "menor_numero" da biblioteca "Matematica"
 * 	para escolher o menor entre dois números reais (para inteiros, utilize "menor_inteiro").
 *
 * Autores:
 *
 * 	Luiz Fernando Noschang (noschang@univali.br)
 *
 * Data: 18/07/2014
 * Adaptado para Portugol-RS (.pors)
 */

funcao inicio() {
    seja mutavel numero1: real = 0.0;
    seja mutavel numero2: real = 0.0;

    escreva("Informe o primeiro número: ");
    leia(numero1);

    escreva("Informe o segundo número: ");
    leia(numero2);

    // Obtém o menor dos dois números
    seja menor: real = Matematica.menor_numero(numero1, numero2);
    escreva("\nO menor número é: ", menor, "\n");
}
