 *
 * Descrição:
 *
 * 	Este exemplo demonstra como utilizar a função "maior_numero" da biblioteca "Matematica"
 * 	para escolher o maior entre dois números reais (para inteiros, utilize "maior_inteiro").
 *
 * Autores:
 *
 * 	Luiz Fernando Noschang (noschang@univali.br)
 *
 * Data: 18/07/2014
 * Adaptado para Ferro (.pors)
 */

funcao inicio() {
    escreva("Informe o primeiro número: ");
    seja mutavel numero1: real = leia();

    escreva("Informe o segundo número: ");
    seja mutavel numero2: real = leia();

    // Obtém o maior dos dois números
    seja maior: real = Matematica.maior_numero(numero1, numero2);
    escreval("\nO maior número é: ", maior);
}
