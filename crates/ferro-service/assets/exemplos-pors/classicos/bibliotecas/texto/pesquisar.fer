 *
 * Descrição:
 *
 * 	Este exemplo demonstra o uso da função "posicao_texto" da biblioteca "Texto" para
 * 	descobrir se um dado do tipo cadeia contém uma sequência de caracteres.
 *
 * Autores:
 *
 * 	Luiz Fernando Noschang (noschang@univali.br)
 *
 * Data: 18/07/2014
 * Adaptado para Ferro (.pors)
 */

funcao mostrar_busca(busca: cadeia, texto: cadeia, inicio_busca: inteiro) {
    // Em Ferro, posicao_texto retorna Opcao<inteiro>:
    // Opcao::Algum(indice) quando encontra ou Opcao::Nenhum quando não existe
    escolha Texto.posicao_texto(busca, texto, inicio_busca) {
        caso Opcao::Algum(posicao) => {
            escreval("A posição do texto \"", busca, "\" na palavra \"", texto, "\" é: ", posicao);
        }
        caso Opcao::Nenhum => {
            escreval("O texto \"", busca, "\" não foi encontrado na palavra \"", texto, "\"");
        }
    }
}

funcao inicio() {
    /*
     * Ao utilizar a função "posicao_texto", devem ser considerados os seguintes aspectos:
     *
     * 1 - A função sempre retorna a posição da primeira ocorrência encontrada a partir
     *     do índice informado.
     * 2 - A função diferencia letras maiúsculas e minúsculas na hora de procurar o texto.
     */

    // Procura "CA" em "MACACO" a partir do índice 0 -> encontra no índice 2
    mostrar_busca("CA", "MACACO", 0);

    // Procura "CA" em "MACACA" a partir do índice 3 -> encontra a segunda ocorrência no índice 4
    mostrar_busca("CA", "MACACA", 3);

    // Procura "CA" em "macaca" (minúsculas) -> Opcao::Nenhum
    mostrar_busca("CA", "macaca", 0);

    seja frase: cadeia = "MACACO GOSTA DE BANANA";
    escreval("\nA frase \"", frase, "\" possui a letra 'A' nas seguintes posições:");

    // Descobre a posição de todas as letras 'A' dentro da frase,
    // avançando o ponto inicial para (posicao + 1) a cada ocorrência encontrada
    seja mutavel proximo_inicio = 0;
    seja mutavel encontrou: logico = verdadeiro;

    enquanto (encontrou) {
        escolha Texto.posicao_texto("A", frase, proximo_inicio) {
            caso Opcao::Algum(posicao) => {
                escreva(posicao, " ");
                proximo_inicio = posicao + 1;
            }
            caso Opcao::Nenhum => {
                encontrou = falso;
            }
        }
    }

    escreval();
}
