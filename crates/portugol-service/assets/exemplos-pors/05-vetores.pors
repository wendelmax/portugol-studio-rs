funcao somar_vetor(itens: vetor<inteiro>) -> inteiro {
    seja mutavel total: inteiro = 0;
    para (seja mutavel i: inteiro = 0; i < tamanho(itens); i += 1) {
        total += itens[i];
    }
    retorne total;
}

funcao inicio() {
    seja mutavel notas: vetor<inteiro> = [7, 8, 9];
    notas[2] = 10;
    escreva("Total=", somar_vetor(notas), " Qtd=", tamanho(notas));
}
