 * desde que este cabeçalho, contendo os direitos autorais e a descrição do programa,
 * seja mantido.
 *
 * Descrição:
 *
 *   Este exemplo demonstra como é detectada a colisão entre um ponto e um círculo
 *   utilizando o Teorema de Pitágoras para calcular a distância euclidiana entre
 *   o ponto e o centro do círculo.
 *
 *   Controles:
 *     - Setas: movem o círculo C
 *     - W, A, S, D: movem o ponto P
 *     - G: exibe/oculta as guias do triângulo de Pitágoras
 *     - C: ativa/desativa o bloqueio de colisões
 *     - ESC: encerra o programa
 *
 * Autor (versão original):
 *
 *   Luiz Fernando Noschang (noschang@univali.br)
 *
 * Data original: 26/06/2017
 * Adaptado para Ferro (.fer)
 */

registro CenaPontoCirculo {
    cx: inteiro,
    cy: inteiro,
    raio: inteiro,
    px: inteiro,
    py: inteiro,
    exibir_guias: logico,
    tratar_colisoes: logico,
    tecla_g_estava: logico,
    tecla_c_estava: logico,
}

funcao cor_rgb(r: inteiro, g: inteiro, b: inteiro) -> inteiro {
    escolha Graficos.criar_cor(r, g, b) {
        caso Resultado::Ok(cor) => {
            retorne cor;
        }
        caso Resultado::Erro(_) => {
            retorne Graficos.COR_BRANCO;
        }
    }
}

funcao distancia_entre_pontos(xa: inteiro, ya: inteiro, xb: inteiro, yb: inteiro) -> real {
    seja dx: real = Tipos.inteiro_para_real(xb - xa);
    seja dy: real = Tipos.inteiro_para_real(yb - ya);
    retorne Matematica.raiz_quadrada(dx * dx + dy * dy);
}

funcao ocorreu_colisao(cena: CenaPontoCirculo) -> logico {
    seja dist: real = distancia_entre_pontos(cena.cx, cena.cy, cena.px, cena.py);
    retorne dist <= Tipos.inteiro_para_real(cena.raio);
}

funcao limitar(valor: inteiro, minimo: inteiro, maximo: inteiro) -> inteiro {
    se (valor < minimo) {
        retorne minimo;
    }
    se (valor > maximo) {
        retorne maximo;
    }
    retorne valor;
}

funcao atualizar(cena: CenaPontoCirculo) -> CenaPontoCirculo {
    seja mutavel nova: CenaPontoCirculo = cena;
    seja passo: inteiro = 3;

    seja g_p: logico = Teclado.tecla_pressionada(Teclado.TECLA_G);
    se (g_p && !nova.tecla_g_estava) {
        nova.exibir_guias = !nova.exibir_guias;
    }
    nova.tecla_g_estava = g_p;

    seja c_p: logico = Teclado.tecla_pressionada(Teclado.TECLA_C);
    se (c_p && !nova.tecla_c_estava) {
        nova.tratar_colisoes = !nova.tratar_colisoes;
        se (nova.tratar_colisoes && ocorreu_colisao(nova)) {
            nova.cx = 220;
            nova.cy = 320;
            nova.px = 540;
            nova.py = 320;
        }
    }
    nova.tecla_c_estava = c_p;

    // Movimento do círculo (Setas)
    seja cx_ant: inteiro = nova.cx;
    seja cy_ant: inteiro = nova.cy;
    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_ESQUERDA)) {
        nova.cx = limitar(nova.cx - passo, nova.raio + 16, 784 - nova.raio);
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_DIREITA)) {
        nova.cx = limitar(nova.cx + passo, nova.raio + 16, 784 - nova.raio);
    }
    se (nova.tratar_colisoes && ocorreu_colisao(nova)) {
        nova.cx = cx_ant;
    }

    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_ACIMA)) {
        nova.cy = limitar(nova.cy - passo, 84 + nova.raio, 560 - nova.raio);
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_ABAIXO)) {
        nova.cy = limitar(nova.cy + passo, 84 + nova.raio, 560 - nova.raio);
    }
    se (nova.tratar_colisoes && ocorreu_colisao(nova)) {
        nova.cy = cy_ant;
    }

    // Movimento do ponto (WASD)
    seja px_ant: inteiro = nova.px;
    seja py_ant: inteiro = nova.py;
    se (Teclado.tecla_pressionada(Teclado.TECLA_A)) {
        nova.px = limitar(nova.px - passo, 16, 784);
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_D)) {
        nova.px = limitar(nova.px + passo, 16, 784);
    }
    se (nova.tratar_colisoes && ocorreu_colisao(nova)) {
        nova.px = px_ant;
    }

    se (Teclado.tecla_pressionada(Teclado.TECLA_W)) {
        nova.py = limitar(nova.py - passo, 84, 560);
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_S)) {
        nova.py = limitar(nova.py + passo, 84, 560);
    }
    se (nova.tratar_colisoes && ocorreu_colisao(nova)) {
        nova.py = py_ant;
    }

    retorne nova;
}

funcao desenhar(cena: CenaPontoCirculo) {
    seja colidiu: logico = ocorreu_colisao(cena);
    seja dist: inteiro = Tipos.real_para_inteiro(distancia_entre_pontos(cena.cx, cena.cy, cena.px, cena.py));

    Graficos.definir_cor(cor_rgb(245, 247, 250));
    Graficos.limpar();

    // Cabeçalho
    Graficos.definir_cor(cor_rgb(30, 38, 52));
    Graficos.desenhar_retangulo(0, 0, 800, 76, falso, verdadeiro);
    Graficos.definir_cor(Graficos.COR_BRANCO);
    Graficos.definir_tamanho_texto(18.0);
    Graficos.desenhar_texto(18, 12, "Colisao 2: Ponto x Circulo (Pitagoras)");
    Graficos.definir_tamanho_texto(12.0);
    Graficos.definir_cor(cor_rgb(200, 210, 225));
    Graficos.desenhar_texto(18, 40, "[Setas] Mover Circulo  |  [WASD] Mover Ponto  |  [G] Guias  |  [C] Tratar Colisao  |  [ESC] Sair");

    se (colidiu) {
        Graficos.definir_cor(cor_rgb(255, 100, 100));
        Graficos.definir_tamanho_texto(14.0);
        Graficos.desenhar_texto(560, 14, "COLISAO DETECTADA!");
    } senao {
        Graficos.definir_cor(cor_rgb(120, 230, 150));
        Graficos.definir_tamanho_texto(14.0);
        Graficos.desenhar_texto(560, 14, "Sem colisao");
    }

    // Círculo
    seja diam: inteiro = cena.raio * 2;
    se (colidiu) {
        Graficos.definir_cor(cor_rgb(102, 255, 153));
    } senao {
        Graficos.definir_cor(cor_rgb(102, 204, 255));
    }
    Graficos.desenhar_elipse(cena.cx - cena.raio, cena.cy - cena.raio, diam, diam, verdadeiro);
    Graficos.definir_cor(cor_rgb(30, 60, 90));
    Graficos.desenhar_elipse(cena.cx - cena.raio, cena.cy - cena.raio, diam, diam, falso);
    Graficos.desenhar_elipse(cena.cx - 3, cena.cy - 3, 6, 6, verdadeiro);

    // Guias de Pitágoras
    se (cena.exibir_guias) {
        Graficos.definir_cor(cor_rgb(153, 0, 153));
        Graficos.desenhar_linha(cena.cx, cena.cy, cena.px, cena.cy);
        Graficos.desenhar_linha(cena.px, cena.cy, cena.px, cena.py);

        Graficos.definir_cor(Graficos.COR_PRETO);
        Graficos.desenhar_linha(cena.cx, cena.cy, cena.px, cena.py);

        seja dx: inteiro = Matematica.valor_absoluto_inteiro(cena.px - cena.cx);
        seja dy: inteiro = Matematica.valor_absoluto_inteiro(cena.py - cena.cy);
        Graficos.definir_tamanho_texto(12.0);
        Graficos.definir_cor(cor_rgb(153, 0, 153));
        Graficos.desenhar_texto((cena.cx + cena.px) / 2 - 15, cena.cy - 16, "dx=" + Tipos.inteiro_para_cadeia(dx));
        Graficos.desenhar_texto(cena.px + 8, (cena.cy + cena.py) / 2, "dy=" + Tipos.inteiro_para_cadeia(dy));
        Graficos.definir_cor(Graficos.COR_PRETO);
        Graficos.desenhar_texto((cena.cx + cena.px) / 2, (cena.cy + cena.py) / 2 + 6, "d=" + Tipos.inteiro_para_cadeia(dist));
    }

    // Ponto
    se (colidiu) {
        Graficos.definir_cor(cor_rgb(230, 30, 30));
    } senao {
        Graficos.definir_cor(cor_rgb(0, 120, 40));
    }
    Graficos.desenhar_elipse(cena.px - 6, cena.py - 6, 12, 12, verdadeiro);
    Graficos.definir_tamanho_texto(13.0);
    Graficos.desenhar_texto(cena.px + 10, cena.py - 12, "P");

    // Rodapé pedagógico
    Graficos.definir_cor(cor_rgb(40, 45, 55));
    Graficos.definir_tamanho_texto(12.0);
    Graficos.desenhar_texto(18, 574, "Distancia: " + Tipos.inteiro_para_cadeia(dist) + " px  |  Raio: " + Tipos.inteiro_para_cadeia(cena.raio) + " px  |  Colide quando d <= raio  |  Tratar: " + Tipos.logico_para_cadeia(cena.tratar_colisoes));

    Graficos.renderizar();
}

funcao inicio() {
    Graficos.iniciar_modo_grafico(verdadeiro);
    Graficos.definir_dimensoes_janela(800, 600);
    Graficos.definir_titulo_janela("Colisao: Ponto e Circulo - Ferro");

    seja mutavel cena: CenaPontoCirculo = CenaPontoCirculo {
        cx: 220,
        cy: 320,
        raio: 65,
        px: 540,
        py: 240,
        exibir_guias: verdadeiro,
        tratar_colisoes: falso,
        tecla_g_estava: falso,
        tecla_c_estava: falso,
    }
    ;

    enquanto (!Teclado.tecla_pressionada(Teclado.TECLA_ESC)) {
        cena = atualizar(cena);
        desenhar(cena);
        Util.aguarde(16);
    }

    Graficos.encerrar_modo_grafico();
}
