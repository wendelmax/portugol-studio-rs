 *
 * Descrição:
 *
 * 	Este exemplo demonstra como verificar a existência de um arquivo no workspace
 * 	antes de criá-lo, após a gravação e após sua remoção usando "Arquivos.existe".
 *
 * Autores:
 *
 * 	Luiz Fernando Noschang (noschang@univali.br)
 *
 * Data: 18/07/2014
 * Completado e adaptado para Portugol-RS (.pors)
 */

funcao testar_ciclo_arquivo(caminho: cadeia) -> Resultado < logico, cadeia > {
    seja existe_antes: logico = Arquivos.existe(caminho)?;
    escreval("Arquivo \"", caminho, "\" existe antes de criar? ", existe_antes);

    seja _criado: logico = Arquivos.escrever_texto(caminho, "Teste de verificação\n")?;
    seja existe_depois: logico = Arquivos.existe(caminho)?;
    escreval("Arquivo \"", caminho, "\" existe após criar? ", existe_depois);

    seja _removido: logico = Arquivos.remover(caminho)?;
    seja existe_final: logico = Arquivos.existe(caminho)?;
    escreval("Arquivo \"", caminho, "\" existe após remover? ", existe_final);

    retorne Resultado::Ok(verdadeiro);
}

funcao inicio() {
    escolha testar_ciclo_arquivo("arquivo_verificacao.txt") {
        caso Resultado::Ok(_) => {}
        caso Resultado::Erro(erro) => {
            escreval("Erro ao verificar arquivo: ", erro);
        }
    }
}
