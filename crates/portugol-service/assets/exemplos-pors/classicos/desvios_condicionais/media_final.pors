 * desde que este cabeçalho, contendo os direitos autorais e a descrição do programa,
 * seja mantido.
 *
 * Descrição:
 *
 *     Este exemplo pede ao usuário que informe seu nome e três notas. Logo após,
 *     calcula a média final do usuário e exibe uma mensagem informando se ele foi
 *     aprovado ou reprovado.
 *
 * Autores:
 *
 *     Giordana Maria da Costa Valle
 *     Carlos Alexandre Krueger
 *
 * Data: 01/06/2013
 */

funcao inicio() {
    seja mutavel nome: cadeia = "";
    seja mutavel nota1: real = 0.0;
    seja mutavel nota2: real = 0.0;
    seja mutavel nota3: real = 0.0;

    escreva("Digite seu nome: ");
    leia(nome);

    escreva("\n");

    escreva("Digite a primeira nota: ");
    leia(nota1);

    escreva("Digite a segunda nota: ");
    leia(nota2);

    escreva("Digite a terceira nota: ");
    leia(nota3);

    // Calcula a média final do usuário
    seja media: real = (nota1 + nota2 + nota3) / 3.0;

    escreva("\n");

    se (media >= 6.0) {
        escreva("Parabéns ", nome, "!\nVocê foi aprovado com a média ", Matematica.arredondar(media, 2));
    } senao {
        escreva("Que pena ", nome, "!\nVocê foi reprovado com a média ", Matematica.arredondar(media, 2));
    }

    escreva("\n");
}
