 * seja mantido.
 *
 * Descrição:
 *
 * 	Este exemplo demonstra como utilizar a função "extrair_subtexto" da biblioteca "Texto"
 * 	para obter uma parte de um texto armazenado em uma variável do tipo cadeia.
 *
 * Autores:
 *
 * 	Luiz Fernando Noschang (noschang@univali.br)
 *
 * Data: 18/07/2014
 * Adaptado para Ferro (.pors)
 */

funcao mostrar_subtexto(texto: cadeia, inicio_pos: inteiro, fim_pos: inteiro) {
    // Em Ferro, extrair_subtexto retorna Resultado<cadeia, cadeia>
    escolha Texto.extrair_subtexto(texto, inicio_pos, fim_pos) {
        caso Resultado::Ok(sub_texto) => {
            escreval(sub_texto);
        }
        caso Resultado::Erro(erro) => {
            escreval("Erro ao extrair subtexto: ", erro);
        }
    }
}

funcao inicio() {
    // Troque a palavra "PAREDES" por "ARBUSTO" e veja o que acontece
    seja texto: cadeia = "PAREDES";

    /*
     * Aqui extraímos a palavra "PA" da palavra "PAREDES". Para isso
     * é necessário entender dois conceitos:
     *
     * 1 - O primeiro caracter de uma cadeia fica na posição 0.
     * 2 - Ao extrair um subtexto, o caracter informado pela última
     *     posição não é considerado.
     *
     * Para formar "PA", extraímos os caracteres nas posições 0 e 1,
     * informando o intervalo de 0 a 2.
     */
    mostrar_subtexto(texto, 0, 2);

    /*
     * Aqui extraímos a palavra "REDES" da palavra "PAREDES".
     *
     * Para formar "REDES", extraímos os caracteres nas posições 2, 3, 4, 5 e 6,
     * informando o intervalo de 2 a 7.
     */
    mostrar_subtexto(texto, 2, 7);
}
