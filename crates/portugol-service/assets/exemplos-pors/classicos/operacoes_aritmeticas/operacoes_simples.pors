 * desde que este cabeçalho, contendo os direitos autorais e a descrição do programa,
 * seja mantido.
 *
 * Descrição:
 *
 *     Este exemplo pede ao usuário que informe dois números. Logo após,
 *     calcula e exibe:
 *
 *       a) A soma entre os números
 *       b) A subtração entre os números
 *       c) A multiplicação entre os números
 *       d) A divisão entre os números
 *
 * Autores:
 *
 *     Giordana Maria da Costa Valle
 *     Carlos Alexandre Krueger
 *
 * Data: 01/06/2013
 */

funcao inicio() {
    seja mutavel a: real = 0.0;
    seja mutavel b: real = 0.0;

    escreva("Digite o primeiro número: ");
    leia(a);

    escreva("Digite o segundo número: ");
    leia(b);

    // Realiza as quatro operações aritméticas básicas
    seja soma: real = a + b;
    seja sub: real = a - b;
    seja mult: real = a * b;
    seja div: real = a / b;

    escreva("\nA soma dos números é igual a: ", soma);
    escreva("\nA subtração dos números é igual a: ", sub);
    escreva("\nA multiplicação dos números é igual a: ", mult);
    escreva("\nA divisão dos números é igual a: ", div, "\n");
}
