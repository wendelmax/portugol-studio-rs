funcao inicio() {
    // Constante (variavel imutavel) do tipo real
    seja ACELERACAO_GRAVIDADE: real = 9.78;

    // Vetor constante do tipo caracter
    seja VOGAIS: vetor < caracter > = ['a', 'e', 'i', 'o', 'u'];

    // Matriz 3x3 constante representada como vetor linear (linha * 3 + coluna)
    seja TECLADO_NUMERICO: vetor < inteiro > = [1, 2, 3, 4, 5, 6, 7, 8, 9];

    escreva("Gravidade: ", ACELERACAO_GRAVIDADE, "\n");
    escreva("Primeira vogal: ", VOGAIS[0], "\n");
    escreva("Tecla central: ", TECLADO_NUMERICO[1 * 3 + 1], "\n");
}
