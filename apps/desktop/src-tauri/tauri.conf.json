{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ferro Studio",
  "version": "0.7.0",
  "identifier": "br.ferro.studio.rs",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ferro Studio",
        "width": 1200,
        "height": 800,
        "decorations": false,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "binaries/ferro": "binaries/ferro",
      "scripts/install-ferro-cli.command": "install-ferro-cli.command"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Ferro Studio",
    "copyright": "Ferro Studio. LGPL-3.0.",
    "category": "Education",
    "shortDescription": "Ferro Studio — Programe em português, crie apps e jogos e evolua para Rust",
    "longDescription": "Ferro Studio: ambiente educacional em Rust para programar em português, criar apps desktop e jogos 2D e evoluir para Rust real (.rs), com editor, análise, depurador, designer visual e exercícios automáticos.",
    "licenseFile": "../../../LICENSE",
    "fileAssociations": [
      {
        "ext": ["fer"],
        "name": "Programa Ferro",
        "description": "Programa Ferro (.fer)",
        "role": "Editor",
        "mimeType": "text/x-ferro"
      },
      {
        "ext": ["licao"],
        "name": "Lição Ferro",
        "description": "Lição interativa Ferro (.licao)",
        "role": "Editor",
        "mimeType": "application/x-ferro-licao"
      },
      {
        "ext": ["rs"],
        "name": "Código-fonte Rust",
        "description": "Programa Rust (.rs)",
        "role": "Editor",
        "mimeType": "text/x-rust"
      }
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "wix": {
        "language": "pt-BR",
        "fragmentPaths": ["windows/fragments/ferro-cli-path.wxs"],
        "componentRefs": ["FerroCliPath"]
      }
    },
    "linux": {
      "deb": {
        "section": "education",
        "files": {
          "/usr/bin/ferro": "src-tauri/binaries/ferro"
        }
      },
      "rpm": {
        "files": {
          "/usr/bin/ferro": "src-tauri/binaries/ferro"
        }
      },
      "appimage": {
        "files": {
          "/usr/bin/ferro": "src-tauri/binaries/ferro"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
