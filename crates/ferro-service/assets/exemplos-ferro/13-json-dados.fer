// Exemplo FERRO 13: manipulação imutável de JSON com Json.* e operador ?

funcao montar_resumo() -> Resultado<cadeia, cadeia> {
    seja mutavel doc: cadeia = "{}";
    doc = Json.definir_cadeia(doc, "linguagem", "Ferro")?;
    doc = Json.definir_inteiro(doc, "versao", 1)?;
    doc = Json.definir_logico(doc, "zero_dep", verdadeiro)?;
    doc = Json.definir_json(doc, "itens", "[10, 20, 30]")?;

    seja nome: cadeia = Json.obter_cadeia(doc, "linguagem")?;
    seja itens: vetor<inteiro> = Json.obter_lista_inteiro(doc, "itens")?;
    seja mutavel soma = 0;
    para (seja mutavel i = 0; i < tamanho(itens); i += 1) {
        soma += itens[i];
    }
    retorne Resultado::Ok(nome + " soma=" + Tipos.inteiro_para_cadeia(soma));
}

funcao inicio() {
    escolha montar_resumo() {
        caso Resultado::Ok(resumo) => {
            escreva(resumo);
        }
        caso Resultado::Erro(erro) => {
            escreva("Erro: ", erro);
        }
    }
}
