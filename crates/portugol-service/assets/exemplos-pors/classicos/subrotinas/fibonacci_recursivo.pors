// Função recursiva que calcula o enésimo valor da sequência de Fibonacci.
// Exemplo: posição 1 -> 0, posição 2 -> 1, posição 3 -> 1, posição 4 -> 2.
funcao fibonacci(posicao: inteiro) -> inteiro {
    se (posicao <= 1) {
        retorne 0;
    } senao se (posicao == 2) {
        retorne 1;
    }

    retorne fibonacci(posicao - 1) + fibonacci(posicao - 2);
}

funcao inicio() {
    seja mutavel numero: inteiro = 0;

    escreva("Quantos elementos da sequência de Fibonacci deseja calcular? ");
    leia(numero);

    // O laço de repetição percorre todos os valores de 1 até a posição informada,
    // calculando o elemento correspondente na sequência.
    para (seja mutavel i: inteiro = 1; i <= numero; i += 1) {
        escreva(fibonacci(i), " ");
    }

    escreva("\n");
}
