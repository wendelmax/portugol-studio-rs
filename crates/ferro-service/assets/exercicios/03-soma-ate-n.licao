{
  "schema_version": 1,
  "id": "ferro-03-soma-ate-n",
  "title": "Soma de 1 até N",
  "statement": "Leia um inteiro positivo N e escreva a soma de todos os inteiros de 1 até N.",
  "starter_code": "funcao inicio() {\n    seja mutavel n: inteiro = leia();\n    escreva(0);\n}\n",
  "hints": [
    "Declare seja mutavel soma: inteiro = 0 e acumule em um laço para de 1 até n."
  ],
  "cases": [
    { "name": "n igual a 1", "input": "1\n", "expected_output": "1" },
    { "name": "n igual a 5", "input": "5\n", "expected_output": "15" },
    { "name": "n igual a 10", "input": "10\n", "expected_output": "55" }
  ]
}
