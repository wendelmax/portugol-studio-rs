 * desde que este cabeçalho, contendo os direitos autorais e a descrição do programa,
 * seja mantido.
 *
 * Descrição:
 *
 *     Este exemplo pede ao usuário que informe uma letra (caracter). Logo após
 *     verifica se a letra digitada é uma vogal ou uma consoante e exibe o resultado
 *     ao usuário.
 *
 * Autores:
 *
 *     Giordana Maria da Costa Valle
 *     Carlos Alexandre Krueger
 *
 * Data: 01/06/2013
 */

funcao inicio() {
    escreva("Digite uma letra: ");
    seja mutavel letra: caracter = leia();

    // O Ferro diferencia caracteres minúsculos e maiúsculos,
    // portanto é preciso verificar ambos os casos.
    se (
    letra == 'A' || letra == 'E' || letra == 'I' || letra == 'O' || letra == 'U' || letra == 'a' || letra == 'e' || letra == 'i' || letra == 'o' || letra == 'u'
    ) {
        escreval("\nA letra '", letra, "' é uma vogal");
    } senao {
        escreval("\nA letra '", letra, "' é uma consoante");
    }
}
