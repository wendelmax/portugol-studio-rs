registro Jogador {
    x: inteiro,
    y: inteiro,
    tamanho: inteiro,
    indice_cor: inteiro
}

funcao cor_rgb(r: inteiro, g: inteiro, b: inteiro) -> inteiro {
    escolha Graficos.criar_cor(r, g, b) {
        caso Resultado::Ok(cor) => {
            retorne cor;
        }
        caso Resultado::Erro(_) => {
            retorne Graficos.COR_PRETO;
        }
    }
}

funcao cor_jogador(indice: inteiro) -> inteiro {
    se (indice == 0) {
        retorne cor_rgb(66, 185, 131);
    } senao se (indice == 1) {
        retorne cor_rgb(76, 154, 255);
    } senao se (indice == 2) {
        retorne cor_rgb(255, 183, 77);
    } senao {
        retorne cor_rgb(239, 83, 80);
    }
}

funcao limitar(valor: inteiro, minimo: inteiro, maximo: inteiro) -> inteiro {
    se (valor < minimo) {
        retorne minimo;
    } senao se (valor > maximo) {
        retorne maximo;
    }
    retorne valor;
}

funcao atualizar_jogador(mutavel j: Jogador, largura: inteiro, altura: inteiro) -> Jogador {
    seja mutavel velocidade: inteiro = 4;
    se (Teclado.tecla_pressionada(Teclado.TECLA_SHIFT)) {
        velocidade = 8;
    }

    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_ESQUERDA) || Teclado.tecla_pressionada(Teclado.TECLA_A)) {
        j.x -= velocidade;
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_DIREITA) || Teclado.tecla_pressionada(Teclado.TECLA_D)) {
        j.x += velocidade;
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_ACIMA) || Teclado.tecla_pressionada(Teclado.TECLA_W)) {
        j.y -= velocidade;
    }
    se (Teclado.tecla_pressionada(Teclado.TECLA_SETA_ABAIXO) || Teclado.tecla_pressionada(Teclado.TECLA_S)) {
        j.y += velocidade;
    }

    j.x = limitar(j.x, 10, largura - j.tamanho - 10);
    j.y = limitar(j.y, 90, altura - j.tamanho - 10);
    retorne j;
}

funcao inicio() {
    seja largura: inteiro = 640;
    seja altura: inteiro = 480;

    Graficos.iniciar_modo_grafico(verdadeiro);
    Graficos.definir_dimensoes_janela(largura, altura);
    Graficos.definir_titulo_janela("Teclado - tecla_pressionada");

    seja mutavel jogador: Jogador = Jogador {
        x: 300,
        y: 250,
        tamanho: 40,
        indice_cor: 0
    }
    ;
    seja mutavel espaco_anterior: logico = falso;

    enquanto (!Teclado.tecla_pressionada(Teclado.TECLA_ESC)) {
        jogador = atualizar_jogador(jogador, largura, altura);

        seja espaco_atual: logico = Teclado.tecla_pressionada(Teclado.TECLA_ESPACO);
        se (espaco_atual && !espaco_anterior) {
            jogador.indice_cor = (jogador.indice_cor + 1) % 4;
        }
        espaco_anterior = espaco_atual;

        Graficos.definir_cor(cor_rgb(20, 26, 38));
        Graficos.limpar();

        Graficos.definir_cor(cor_rgb(35, 44, 62));
        Graficos.desenhar_retangulo(0, 0, largura, 80, falso, verdadeiro);

        Graficos.definir_cor(Graficos.COR_BRANCO);
        Graficos.definir_tamanho_texto(16.0);
        Graficos.desenhar_texto(
        15,
        16,
        "Setas ou WASD: mover | SHIFT: correr | ESPACO: cor | ESC: sair"
        );

        seja estado_teclado: cadeia = "Nenhuma tecla pressionada";
        se (Teclado.alguma_tecla_pressionada()) {
            Graficos.definir_cor(Graficos.COR_AMARELO);
            Graficos.desenhar_texto(
            15,
            46,
            "Tecla ativa! Posição: (" + Tipos.inteiro_para_cadeia(jogador.x) + ", " + Tipos.inteiro_para_cadeia(jogador.y) + ")"
            );
        } senao {
            Graficos.definir_cor(cor_rgb(170, 185, 205));
            Graficos.desenhar_texto(
            15,
            46,
            estado_teclado + " | Posição: (" + Tipos.inteiro_para_cadeia(jogador.x) + ", " + Tipos.inteiro_para_cadeia(jogador.y) + ")"
            );
        }

        Graficos.definir_cor(cor_jogador(jogador.indice_cor));
        Graficos.desenhar_retangulo(
        jogador.x,
        jogador.y,
        jogador.tamanho,
        jogador.tamanho,
        verdadeiro,
        verdadeiro
        );

        Graficos.definir_cor(Graficos.COR_BRANCO);
        Graficos.desenhar_retangulo(
        jogador.x,
        jogador.y,
        jogador.tamanho,
        jogador.tamanho,
        verdadeiro,
        falso
        );

        Graficos.renderizar();
        Util.aguarde(16);
    }

    Graficos.encerrar_modo_grafico();
}
